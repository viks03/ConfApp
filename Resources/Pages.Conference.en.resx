  <data name="Conf_Day1_Title" xml:space="preserve"><value>EDUCATION &amp; REGULATION</value></data>
  <data name="Conf_Day1_List" xml:space="preserve"><value>&lt;p&gt;→ Global Trends in Education&lt;br&gt;→ Curriculum Models &amp;amp; Skills&lt;br&gt;→ MiCA &amp;amp; Academic Impact&lt;br&gt;→ Cryptoeconomics Workshops&lt;br&gt;→ Networking &amp;amp; Reception&lt;/p&gt;</value></data>
  <data name="Conf_Day2" xml:space="preserve"><value>DAY 2</value></data>
  <data name="Conf_Day2_Title" xml:space="preserve"><value>TECHNOLOGY &amp; RESEARCH</value></data>
  <data name="Conf_Day2_List" xml:space="preserve"><value>&lt;p&gt;→ Web3 Innovations Keynote&lt;br&gt;→ DeFi &amp;amp; Tokenomics Panels&lt;br&gt;→ RWA Tokenization Focus&lt;br&gt;→ Blockchain Research Session&lt;br&gt;→ Industry-University Synergy&lt;/p&gt;</value></data>
  <data name="Conf_Day3" xml:space="preserve"><value>DAY 3</value></data>
