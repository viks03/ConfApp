            <h2>@Localizer["Sched_DownloadSubtitle"]</h2>
            <h1>@Html.Raw(Localizer["Sched_DownloadTitle"].Value)</h1>
            <div class="download-buttons">
                <a href="/uploads/program/unwe-crypto-2026-bg.pdf" download="unwe-crypto-2026-bg.pdf" class="btn btn-outline">@Localizer["Sched_BtnBg"]</a>
                <a href="/uploads/program/unwe-crypto-2026-en.pdf" download="unwe-crypto-2026-en.pdf" class="btn btn-solid">@Localizer["Sched_BtnEn"]</a>
            </div>
            
