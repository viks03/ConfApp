        <header class="schedule-header center-section">
            <h1>@Html.Raw(Localizer["Sched_h1Title"].Value)</h1>
            
            <div class="separator"></div>

            <div class="day-toggles">
                <button class="day-btn active" data-target="day1">@Localizer["Sched_Day1_Date"]</button>
                <button class="day-btn" data-target="day2">@Localizer["Sched_Day2_Date"]</button>
                <button class="day-btn" data-target="day3">@Localizer["Sched_Day3_Date"]</button>
                <span class="day-toggle-indicator" aria-hidden="true"></span>
            </div>
        </header>

        <div class="schedule-content">

            <div id="day1" class="tab-pane active">
                <div class="timeline">
                    @if (Model.Day1Events != null && Model.Day1Events.Any())
