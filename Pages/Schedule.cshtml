                                                            <polygon points="12 2 21 8 3 8"></polygon>
                                                        </svg>
                                                        @Localizer["Sched_InVenue"]
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(item.LiveStreamUrl))
                                                    {
