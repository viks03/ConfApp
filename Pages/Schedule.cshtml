@page
@model ConferenceApp.Pages.ScheduleModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Nav_Schedule"].Value ?? "Schedule";
}

@section Styles {
    <link rel="stylesheet" href="~/css/scheduleStyle.css" asp-append-version="true" />
}

<main>
    <canvas id="particles-bg" aria-hidden="true"></canvas>

    <section class="hero schedule-hero">
      <div class="hero-overlay"></div>

      <a href="#tickets-section" class="scroll-down-arrow" aria-label="@Localizer["Sched_ScrollDown"]">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </section>

    <section class="schedule-section" id="tickets-section">
      <div class="section-inner schedule-container">


        <!-- Резерва --->
