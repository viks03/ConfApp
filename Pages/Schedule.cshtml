@page
@model ConferenceApp.Pages.ScheduleModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Nav_Schedule"].Value ?? "Schedule";

    var isBulgarian = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg";

    // Трите дни в един масив — оригиналът повтаряше един и същи ~230
    // реда markup три пъти (day1/day2/day3). Логиката е идентична,
    // затова се обхожда веднъж. По-малко място за разминаване между
    // дните при бъдещи промени.
    var days = new[]
    {
        new { Id = "day1", Label = Localizer["Sched_Day1_Date"].Value, Index = 1, Events = Model.Day1Events },
        new { Id = "day2", Label = Localizer["Sched_Day2_Date"].Value, Index = 2, Events = Model.Day2Events },
        new { Id = "day3", Label = Localizer["Sched_Day3_Date"].Value, Index = 3, Events = Model.Day3Events }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/scheduleStyle.css" asp-append-version="true" />
}

@*
    Страница „Програма", редизайн.

    Model-ът НЕ е променян: същите Day1/2/3Events, същото групиране по
    StartTime, същата логика за паралелни сесии и за LiveStreamUrl.
    scriptSchedule.js запазва целия си контракт — единствената промяна
    в него е guard за readyState и преизчисляване на индикатора при
    хоризонтален скрол на релсата (виж коментарите в самия файл).

    Какво се промени визуално:
    · .hero с background-image → истински <img> банер с обработката от
      FAQ / Участие (ч/б, scanlines, 48px решетка, рамка с ъглови маркери);
    · всеки времеви слот е ред на един лист: час в фиксирана лява колона,
      съдържание вдясно, непрекъсната вертикална линия от ръба на
      колоната. Картите вече не са кутии с фон, рамка, радиус и сянка;
    · табовете с дните са релса под заглавния блок; главната навигация
      остава залепена горе, а релсата преминава ПОД нея при скрол;
    · паралелните сесии са номерирани потоци (редове с етикет ПОТОК 01/
      02/03…), събрани от акцентна скоба отляво — работи за 2, 3 и 4
      потока, за разлика от решетка от колони;
    · зеленото „на живо" и кехлибареният disclaimer са махнати —
      палитрата е акцент + неутрали. Излъчването е единственото
      действие в реда, затова е единственият плътен обект;
    · #particles-bg и particlesBg.js са премахнати от страницата.

    Нови resx ключове (пет):
      Sched_JumpToProgram, Sched_HeroEyebrow, Sched_MetaDates,
      Sched_MetaDatesValue, Sched_MetaSessions, Sched_MetaSessionsUnit,
      Sched_MetaLang, Sched_MetaLangValue, Sched_DayWord,
      Sched_SessionsShort, Sched_TrackWord, Sched_NoEventsTitle,
      Sched_DownloadLabel, Sched_DownloadNote
    (Sched_BtnBg / Sched_BtnEn вече съществуват — идват от оригиналния
     закоментиран header блок.)
*@

<main class="site-main">
<div class="schedule-page">

    <section class="sc-banner">
        <img src="~/images/schedule/bannermain.png" alt="">
        <div class="sc-banner-tint"></div>
        <div class="sc-banner-grid"></div>
        <div class="sc-frame">
            <span class="c-tl-h"></span>
            <span class="c-tl-v"></span>
            <span class="c-br-h"></span>
            <span class="c-br-v"></span>
        </div>
        <a href="#programme-section" class="scroll-down-arrow" aria-label="@Localizer["Sched_ScrollDown"]">
            <span>@Localizer["Sched_JumpToProgram"]</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="6 13 12 19 18 13"></polyline>
            </svg>
        </a>
    </section>

    <section class="sc-hero">
        <div class="sc-hero-inner">
            <div class="sc-topline">
                <span class="sc-wordmark">BLOCKCHAIN EDUCATION 2026</span>
                <b>УНСС / ICBI</b>
            </div>
            <div>
                <p class="sc-eyebrow">@Localizer["Sched_HeroEyebrow"]</p>
                <h1 class="sc-title">@Html.Raw(Localizer["Sched_h1Title"].Value)</h1>
                <span class="sc-rule"></span>
                <div class="sc-meta">
                    <div>
                        <b>@Localizer["Sched_MetaDates"]</b>
                        <span>@Localizer["Sched_MetaDatesValue"]</span>
                    </div>
                    <div>
                        <b>@Localizer["Sched_MetaSessions"]</b>
                        <span>@days.Sum(d => d.Events?.Count ?? 0) @Localizer["Sched_MetaSessionsUnit"]</span>
                    </div>
                    <div>
                        <b>@Localizer["Sched_MetaLang"]</b>
                        <span>@Localizer["Sched_MetaLangValue"]</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* Sticky релса с дните. .day-toggles / .day-btn / [data-target] /
       .day-toggle-indicator запазват контракта си към scriptSchedule.js. *@
    <div class="sc-rail">
        <div class="sc-rail-inner">
            <div class="day-toggles">
                @foreach (var day in days)
                {
                    <button class="day-btn @(day.Index == 1 ? "active" : "")" type="button" data-target="@day.Id">
                        @day.Label
                        <i>@Localizer["Sched_DayWord"] @day.Index.ToString("00") · @(day.Events?.Count ?? 0) @Localizer["Sched_SessionsShort"]</i>
                    </button>
                }
                <span class="day-toggle-indicator" aria-hidden="true"></span>
            </div>
        </div>
    </div>

    <section class="sc-sec" id="programme-section">
        <div class="sc-pad">
            @* Сваляне на програмата — файловете са същите пътища като в
               оригиналния (закоментиран) header блок. *@
            <div class="sc-tools">
                <p class="sc-tools-label">
                    @Localizer["Sched_DownloadLabel"]
                    <span>@Localizer["Sched_DownloadNote"]</span>
                </p>
                <div class="sc-tools-actions">
                    <a class="sc-dl" href="/uploads/program/unwe-crypto-2026-bg.pdf" download="unwe-crypto-2026-bg.pdf">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3v12"></path>
                            <polyline points="7 11 12 16 17 11"></polyline>
                            <path d="M4 20h16"></path>
                        </svg>
                        @Localizer["Sched_BtnBg"]
                        <b>BG</b>
                    </a>
                    <a class="sc-dl" href="/uploads/program/unwe-crypto-2026-en.pdf" download="unwe-crypto-2026-en.pdf">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3v12"></path>
                            <polyline points="7 11 12 16 17 11"></polyline>
                            <path d="M4 20h16"></path>
                        </svg>
                        @Localizer["Sched_BtnEn"]
                        <b>EN</b>
                    </a>
                </div>
            </div>

            <div class="schedule-content">

                @foreach (var day in days)
                {
                    <div id="@day.Id" class="tab-pane @(day.Index == 1 ? "active" : "")">
                        <div class="timeline">
                            @if (day.Events != null && day.Events.Any())
                            {
                                foreach (var group in day.Events.GroupBy(e => e.StartTime))
                                {
                                    var groupList = group.ToList();

                                    <div class="timeline-item">
                                        <div class="timeline-marker"></div>

                                        <div class="timeline-meta">
                                            @if (groupList.Count == 1)
                                            {
                                                <span class="time">@groupList[0].StartTime</span>
                                                @if (!string.IsNullOrWhiteSpace(groupList[0].EndTime))
                                                {
                                                    <span class="sc-time-end">@groupList[0].EndTime</span>
                                                }
                                                @if (!string.IsNullOrEmpty(groupList[0].SessionType))
                                                {
                                                    <span class="badge">@Localizer[groupList[0].SessionType]</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="time">@group.Key</span>
                                                <span class="badge badge-parallel">@Localizer["Sched_ParallelLabel"]</span>
                                            }
                                        </div>

                                        <div class="sc-slot-body">
                                            @if (groupList.Count == 1)
                                            {
                                                var item = groupList[0];
                                                var title = isBulgarian ? (string.IsNullOrWhiteSpace(item.TitleBg) ? item.TitleEn : item.TitleBg) : item.TitleEn;
                                                var desc = isBulgarian ? (string.IsNullOrWhiteSpace(item.DescriptionBg) ? item.DescriptionEn : item.DescriptionBg) : item.DescriptionEn;
                                                var speaker = isBulgarian ? (string.IsNullOrWhiteSpace(item.SpeakerBg) ? item.SpeakerEn : item.SpeakerBg) : item.SpeakerEn;
                                                var location = isBulgarian ? (string.IsNullOrWhiteSpace(item.LocationBg) ? item.LocationEn : item.LocationBg) : item.LocationEn;

                                                <div class="timeline-card">
                                                    <div class="card-main">
                                                        <h4>@title</h4>
                                                        @if (!string.IsNullOrWhiteSpace(desc))
                                                        {
                                                            <p class="session-desc">@desc</p>
                                                            <button type="button" class="read-more-btn" data-expanded="false" data-label-more="@Localizer["Sched_ReadMore"]" data-label-less="@Localizer["Sched_ShowLess"]">
                                                                <span class="read-more-label">@Localizer["Sched_ReadMore"]</span>
                                                                <svg class="read-more-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                    <polyline points="6 9 12 15 18 9"></polyline>
                                                                </svg>
                                                            </button>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(speaker))
                                                        {
                                                            <div class="speaker">
                                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path></svg>@speaker
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="card-side">
                                                        <div class="card-side-info">
                                                            @if (!string.IsNullOrWhiteSpace(location))
                                                            {
                                                                <div class="location">
                                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z"></path>
                                                                        <circle cx="12" cy="10" r="3"></circle>
                                                                    </svg>
                                                                    @location
                                                                </div>
                                                            }
                                                            @* TODO: venue/livestream ще станат динамични (данни + resx) в следваща задача *@
                                                            <div class="session-modes">
                                                                <span class="mode-badge mode-venue active">
                                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                        <line x1="3" y1="22" x2="21" y2="22"></line>
                                                                        <line x1="6" y1="18" x2="6" y2="11"></line>
                                                                        <line x1="10" y1="18" x2="10" y2="11"></line>
                                                                        <line x1="14" y1="18" x2="14" y2="11"></line>
                                                                        <line x1="18" y1="18" x2="18" y2="11"></line>
                                                                        <polygon points="12 2 21 8 3 8"></polygon>
                                                                    </svg>
                                                                    @Localizer["Sched_InVenue"]
                                                                </span>
                                                                @if (!string.IsNullOrWhiteSpace(item.LiveStreamUrl))
                                                                {
                                                                    <a href="@item.LiveStreamUrl" target="_blank" rel="noopener" class="mode-badge mode-livestream is-live">
                                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                            <circle cx="12" cy="12" r="2"></circle>
                                                                            <path d="M8.5 8.5a5 5 0 0 0 0 7"></path>
                                                                            <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
                                                                            <path d="M5.5 5.5a9 9 0 0 0 0 13"></path>
                                                                            <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
                                                                        </svg>
                                                                        @Localizer["Sched_Livestream"]
                                                                        <svg class="mode-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="mode-badge mode-livestream" aria-disabled="true">
                                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                            <circle cx="12" cy="12" r="2"></circle>
                                                                            <path d="M8.5 8.5a5 5 0 0 0 0 7"></path>
                                                                            <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
                                                                            <path d="M5.5 5.5a9 9 0 0 0 0 13"></path>
                                                                            <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
                                                                        </svg>
                                                                        @Localizer["Sched_Livestream"]
                                                                    </span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="parallel-group">
                                                    <div class="parallel-group-grid">
                                                        @{ var trackIndex = 0; }
                                                        @foreach (var item in groupList)
                                                        {
                                                            trackIndex++;
                                                            var title = isBulgarian ? (string.IsNullOrWhiteSpace(item.TitleBg) ? item.TitleEn : item.TitleBg) : item.TitleEn;
                                                            var desc = isBulgarian ? (string.IsNullOrWhiteSpace(item.DescriptionBg) ? item.DescriptionEn : item.DescriptionBg) : item.DescriptionEn;
                                                            var speaker = isBulgarian ? (string.IsNullOrWhiteSpace(item.SpeakerBg) ? item.SpeakerEn : item.SpeakerBg) : item.SpeakerEn;
                                                            var location = isBulgarian ? (string.IsNullOrWhiteSpace(item.LocationBg) ? item.LocationEn : item.LocationBg) : item.LocationEn;

                                                            <div class="timeline-card parallel-session">
                                                                <div class="sc-track">
                                                                    <b>@trackIndex.ToString("00")</b>
                                                                    @Localizer["Sched_TrackWord"]
                                                                </div>
                                                                <div class="card-main">
                                                                    <div class="parallel-session-header">
                                                                        <h4>@title</h4>
                                                                        @if (!string.IsNullOrEmpty(item.SessionType))
                                                                        {
                                                                            <span class="badge">@Localizer[item.SessionType]</span>
                                                                        }
                                                                    </div>
                                                                    @if (!string.IsNullOrWhiteSpace(desc))
                                                                    {
                                                                        <p class="session-desc">@desc</p>
                                                                        <button type="button" class="read-more-btn" data-expanded="false" data-label-more="@Localizer["Sched_ReadMore"]" data-label-less="@Localizer["Sched_ShowLess"]">
                                                                            <span class="read-more-label">@Localizer["Sched_ReadMore"]</span>
                                                                            <svg class="read-more-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                <polyline points="6 9 12 15 18 9"></polyline>
                                                                            </svg>
                                                                        </button>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(speaker))
                                                                    {
                                                                        <div class="speaker">
                                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path></svg>@speaker
                                                                        </div>
                                                                    }
                                                                </div>
                                                                <div class="card-side">
                                                                    <div class="card-side-info">
                                                                        @if (!string.IsNullOrWhiteSpace(location))
                                                                        {
                                                                            <div class="location">
                                                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z"></path>
                                                                                    <circle cx="12" cy="10" r="3"></circle>
                                                                                </svg>
                                                                                @location
                                                                            </div>
                                                                        }
                                                                        @* TODO: venue/livestream ще станат динамични (данни + resx) в следваща задача *@
                                                                        <div class="session-modes">
                                                                            <span class="mode-badge mode-venue active">
                                                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <line x1="3" y1="22" x2="21" y2="22"></line>
                                                                                    <line x1="6" y1="18" x2="6" y2="11"></line>
                                                                                    <line x1="10" y1="18" x2="10" y2="11"></line>
                                                                                    <line x1="14" y1="18" x2="14" y2="11"></line>
                                                                                    <line x1="18" y1="18" x2="18" y2="11"></line>
                                                                                    <polygon points="12 2 21 8 3 8"></polygon>
                                                                                </svg>
                                                                                @Localizer["Sched_InVenue"]
                                                                            </span>
                                                                            @if (!string.IsNullOrWhiteSpace(item.LiveStreamUrl))
                                                                            {
                                                                                <a href="@item.LiveStreamUrl" target="_blank" rel="noopener" class="mode-badge mode-livestream is-live">
                                                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                        <circle cx="12" cy="12" r="2"></circle>
                                                                                        <path d="M8.5 8.5a5 5 0 0 0 0 7"></path>
                                                                                        <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
                                                                                        <path d="M5.5 5.5a9 9 0 0 0 0 13"></path>
                                                                                        <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
                                                                                    </svg>
                                                                                    @Localizer["Sched_Livestream"]
                                                                                    <svg class="mode-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                                                                </a>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="mode-badge mode-livestream" aria-disabled="true">
                                                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                        <circle cx="12" cy="12" r="2"></circle>
                                                                                        <path d="M8.5 8.5a5 5 0 0 0 0 7"></path>
                                                                                        <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
                                                                                        <path d="M5.5 5.5a9 9 0 0 0 0 13"></path>
                                                                                        <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
                                                                                    </svg>
                                                                                    @Localizer["Sched_Livestream"]
                                                                                </span>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="parallel-disclaimer">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path>
                                                        </svg>
                                                        <span>@Localizer["Sched_ParallelDisclaimer"]</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="sc-empty">
                                    <b>@Localizer["Sched_NoEventsTitle"]</b>
                                    <span>@Localizer["Sched_NoEvents"]</span>
                                </div>
                            }
                        </div>
                    </div>
                }

            </div>
        </div>
    </section>
</div>
</main>

@section Scripts {
    <script src="~/js/scriptSchedule.js" asp-append-version="true"></script>
}
