@page
@model ConferenceApp.Pages.AttendModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Nav_Attend"].Value ?? "Attend";
}

@section Styles {
    <link rel="stylesheet" href="~/css/attendStyle.css" asp-append-version="true" />
}

<main>
    <section class="hero attend-hero">
      <div class="hero-overlay"></div>
      <a href="#tickets-section" class="scroll-down-arrow" aria-label="Scroll down">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </section>
    
    <section class="pricing-section" id="tickets-section">
        <div class="section-inner reveal center-section">
            <p class="section-label">@Localizer["Attend_TicketsLabel"]</p>
            <h2>@Localizer["Attend_TicketsTitle"]</h2>
            
            <div class="pricing-grid">
                @if (Model.TicketTiers != null && Model.TicketTiers.Any())
                {
                    foreach (var ticket in Model.TicketTiers)
                    {
                        var isBulgarian = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg";
                        
                        var name = isBulgarian ? ticket.NameBg : ticket.NameEn;
                        var desc = isBulgarian ? ticket.DescriptionBg : ticket.DescriptionEn;
                        var regPrice = isBulgarian ? ticket.RegularPriceBg : ticket.RegularPriceEn;
                        var promoPrice = isBulgarian ? ticket.PromoPriceBg : ticket.PromoPriceEn;
                        var perksStr = isBulgarian ? ticket.PerksBg : ticket.PerksEn;
                        
                        var perksList = string.IsNullOrWhiteSpace(perksStr) 
                            ? new string[0] 
                            : perksStr.Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                                      .Select(p => p.TrimStart('-', ' '));

                        var hasPromo = !string.IsNullOrWhiteSpace(promoPrice);

                        var slug = ticket.NameEn?.ToLower() ?? "";
                        slug = System.Text.RegularExpressions.Regex.Replace(slug, @"[^a-z0-9\s-]", "");
                        slug = System.Text.RegularExpressions.Regex.Replace(slug, @"\s+", " ").Trim();
                        slug = slug.Replace(" ", "-");

                        <div class="pricing-card @(hasPromo ? "highlighted" : "")">
                            @if (hasPromo)
                            {
                                <div class="ribbon">@Localizer["Attend_RibbonLimited"]</div>
                            }
                            
                            <h3 class="card-title">@name</h3>
                            
                            <div class="price">
                                @if (hasPromo)
                                {
                                    <del>@regPrice</del> @promoPrice
                                }
                                else
                                {
                                    @regPrice
                                }
                            </div>
                            
                            <p class="card-desc">@desc</p>
                            
                            <ul class="feature-list">
                                @foreach (var perk in perksList)
                                {
                                    <li>@perk</li>
                                }
                            </ul>
                            
                            @* Само средният билет (ID 2) има бутон (btn-solid) *@
                            @if (ticket.Id == 2)
                            {
                                <a asp-page="/Payment" asp-route-slug="@slug" class="btn btn-solid">
                                    @Localizer["Attend_BtnGetTicket"]
                                </a>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </section>

    <section class="access-section">
        <div class="section-inner reveal center-section">
            <div class="access-grid">
                
                <div class="access-card">
                    <div class="access-icon"><img src="~/images/conference/chip.png" alt="Online"></div>
                    <div class="access-info">
                        <h4>@Localizer["Attend_AccessOnlineTitle"]</h4>
                        <p>@Localizer["Attend_AccessOnlineDesc"]</p>
                        
                        <a href="@Model.WatchOnlineLink" class="red-link" @(Model.WatchOnlineLink != "#" ? "target=\"_blank\"" : "")>
                            @Localizer["Attend_AccessOnlineBtn"] &#8594;
                        </a>
                    </div>
                </div>
                
                <div class="access-card">
                    <div class="access-icon"><img src="~/images/conference/openbook.png" alt="Journalist"></div>
                    <div class="access-info">
                        <h4>@Localizer["Attend_AccessJournalistTitle"]</h4>
                        <p>@Localizer["Attend_AccessJournalistDesc"]</p>
                        
                        @{
                            string journoLink = Model.RedirectJournalistToDocs ? "/SubmitDocuments" : "/Register?type=journalist";
                            string journoBtnText = Model.RedirectJournalistToDocs 
                                                    ? Localizer["Attend_AccessJournalistBtn_SubmitDocs"].Value 
                                                    : Localizer["Attend_AccessJournalistBtn"].Value;
                        }
                        <a href="@journoLink" class="red-link">@journoBtnText &#8594;</a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <section class="extras-payment-section">
        <div class="section-inner reveal center-section">
            <p class="section-label">@Localizer["Attend_ExtrasLabel"]</p>
            <h2>@Localizer["Attend_ExtrasTitle"]</h2>
            <div class="extras-payment-grid">
                
                <div class="extras-column">
                    <div class="extra-card">
                        <div class="extra-icon"><img src="~/images/logos/transfer.png" alt="Car"></div>
                        <div class="extra-info">
                            <h4>@Localizer["Attend_Extra1Title"]</h4>
                            <p>@Localizer["Attend_Extra1Desc"]</p>
                        </div>
                    </div>
                    
                    <div class="extra-card">
                        <div class="extra-icon"><img src="~/images/logos/location.png" alt="Hotel"></div>
                        <div class="extra-info">
                            <h4>@Localizer["Attend_Extra2Title"]</h4>
                            <p>@Localizer["Attend_Extra2Desc"]</p>
                        </div>
                    </div>
                </div>

                <div class="payment-column">
                    <div class="payment-card">
                        <div class="payment-header">
                            <div class="payment-icon"><img src="~/images/attend/bank.png" alt="Bank"></div>
                            <h4>@Localizer["Attend_PaymentMethods"]</h4>
                        </div>
                        <div class="payment-body">
                            
                            @* 💳 Начин 1: Кредитни / Дебитни карти *@
                            <div class="payment-method-item">
                                <div class="method-item-header">
                                    <span class="method-item-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <rect x="2" y="5" width="20" height="14" rx="2"/>
                                            <line x1="2" y1="10" x2="22" y2="10"/>
                                            <line x1="6" y1="15" x2="10" y2="15"/>
                                        </svg>
                                    </span>
                                    <h5>@Localizer["Attend_Method_Card"]</h5>
                                    <span class="method-status-tag tag-instant">@Localizer["Attend_Tag_Instant"]</span>
                                </div>
                                <p>@Localizer["Attend_Method_CardDesc"]</p>
                            </div>

                            @* ₿ Начин 2: Криптовалути *@
                            <div class="payment-method-item">
                                <div class="method-item-header">
                                    <span class="method-item-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <circle cx="12" cy="12" r="9"/>
                                            <path d="M9 8h4.5a2 2 0 0 1 0 4H9m0 0h5a2 2 0 0 1 0 4H9M9 8v8m3-10v2m0 8v2"/>
                                        </svg>
                                    </span>
                                    <h5>@Localizer["Attend_Method_Crypto"]</h5>
                                    <span class="method-status-tag tag-instant">@Localizer["Attend_Tag_Instant"]</span>
                                </div>
                                <p>@Localizer["Attend_Method_CryptoDesc"]</p>
                            </div>

                            @* 🏛️ Начин 3: Банков превод *@
                            <div class="payment-method-item">
                                <div class="method-item-header">
                                    <span class="method-item-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <rect x="3" y="6" width="18" height="13" rx="1"/>
                                            <path d="M3 9h18M8 13h2m4 0h2"/>
                                            <path d="M7 3l5 3 5-3"/>
                                        </svg>
                                    </span>
                                    <h5>@Localizer["Attend_BankTransfer"]</h5>
                                    <span class="method-status-tag tag-manual">1-3 @Localizer["Attend_Tag_Days"]</span>
                                </div>
                                <p>@Localizer["Attend_BankDesc"]</p>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
</main>