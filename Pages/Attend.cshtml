@page
@model ConferenceApp.Pages.AttendModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@* ─────────────────────────────────────────────────────────────────────
   ConferenceApp · Blockchain Education 2026
   Author: Viktor Georgiev
   ───────────────────────────────────────────────────────────────────── *@

@{
    ViewData["Title"] = Localizer["Nav_Attend"].Value ?? "Attend";
}

@section Styles {
    <link rel="stylesheet" href="~/css/attendStyle.css" asp-append-version="true" />
}

@*
    The "Attend" page: the tiers, what each one gives, and how to pay.

    Three things about the layout are load-bearing rather than decorative:

    · the tiers are columns of one CSS subgrid, not three separate cards, so
      that the prices, the rules and the buttons line up across all three
      however long the descriptions are;
    · access and extras are indexed rows rather than cards, and the index is
      counted in the markup — a row that is not rendered does not take a
      number with it (see the online-viewer row below);
    · the palette is the accent colour plus neutrals only.

    Which tier gets a button is decided by TicketPricing.IsPayable, and its
    link by TicketPricing.SlugFor — not by a tier id and not by its name
    ([D-02]).
*@

<main class="site-main">
<div class="attend-page">

    <section class="at-banner">
        <img src="~/images/attend/bannerAula.png" alt="">
        <div class="at-banner-tint"></div>
        <div class="at-banner-grid"></div>
        <div class="at-frame">
            <span class="c-tl-h"></span>
            <span class="c-tl-v"></span>
            <span class="c-br-h"></span>
            <span class="c-br-v"></span>
        </div>
        <a href="#tickets-section" class="at-jump">
            <span>@Localizer["Attend_JumpToTickets"]</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="6 13 12 19 18 13"></polyline>
            </svg>
        </a>
    </section>

    <section class="at-hero">
        <div class="at-hero-inner">
            <div class="at-topline">
                <span class="at-wordmark">BLOCKCHAIN EDUCATION 2026</span>
                <b>УНСС / ICBI</b>
            </div>
            <div>
                <p class="at-eyebrow">@Localizer["Attend_HeroEyebrow"]</p>
                <h1 class="at-title">@Localizer["Attend_HeroTitle"]</h1>
                <span class="at-rule"></span>
                <div class="at-meta">
                    @* The first line of the summary is the early-bird deadline: a
                       date somebody can check, where this used to be a claim
                       about access that nothing in the database backed up. *@
                    <div>
                        <b>@Localizer["Attend_MetaDeadline"]</b>
                        <span>@Localizer["Attend_MetaDeadlineValue"]</span>
                    </div>
                    <div>
                        <b>@Localizer["Attend_MetaTiers"]</b>
                        <span>@(Model.TicketTiers?.Count ?? 0) @Localizer["Attend_MetaTiersUnit"]</span>
                    </div>
                    <div>
                        <b>@Localizer["Attend_MetaPay"]</b>
                        <span>@Localizer["Attend_MetaPayValue"]</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ── 01 · Tiers ────────────────────────────────────────── *@
    <section class="at-sec reveal" id="tickets-section">
        <div class="at-pad">
            <div class="at-sec-head">
                <span class="at-ghost" aria-hidden="true">01</span>
                <p class="at-eyebrow">@Localizer["Attend_TicketsLabel"]</p>
                <h2>@Localizer["Attend_TicketsTitle"]</h2>
                <span class="at-rule"></span>
            </div>

            <div class="at-tiers">
                @if (Model.TicketTiers != null && Model.TicketTiers.Any())
                {
                    var tierIndex = 0;

                    foreach (var ticket in Model.TicketTiers)
                    {
                        tierIndex++;

                        var isBulgarian = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg";

                        var name = isBulgarian ? ticket.NameBg : ticket.NameEn;
                        var desc = isBulgarian ? ticket.DescriptionBg : ticket.DescriptionEn;
                        var regPrice = isBulgarian ? ticket.RegularPriceBg : ticket.RegularPriceEn;
                        var promoPrice = isBulgarian ? ticket.PromoPriceBg : ticket.PromoPriceEn;
                        var perksStr = isBulgarian ? ticket.PerksBg : ticket.PerksEn;

                        var perksList = string.IsNullOrWhiteSpace(perksStr)
                            ? new string[0]
                            : perksStr.Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                                      .Select(p => p.TrimStart('-', ' ')).ToArray();

                        var hasPromo = !string.IsNullOrWhiteSpace(promoPrice);

                        @* The link uses the tier's stable key rather than its
                           name, so renaming a tier in the panel no longer
                           breaks it ([D-02]). *@
                        var slug = ConferenceApp.Services.Payments.TicketPricing.SlugFor(ticket);
                        var isPayable = ConferenceApp.Services.Payments.TicketPricing.IsPayable(ticket);

                        @* The tier code is the first four letters of the English
                           name: it gives the small technical label in the corner
                           without a new column in the database. A shorter name is
                           shown as it is. *@
                        var code = (ticket.NameEn ?? "").Trim();
                        code = code.Length > 4 ? code.Substring(0, 4).ToUpper() : code.ToUpper();

                        <article class="at-tier @(hasPromo ? "at-tier--promo" : "")">
                            @if (hasPromo)
                            {
                                <div class="at-ribbon">@Localizer["Attend_RibbonLimited"]</div>
                            }

                            <div class="at-tier-code">
                                <span>@Localizer["Attend_TierWord"] @tierIndex.ToString("00")</span>
                                <i>@code</i>
                            </div>

                            <h3 class="at-tier-name">@name</h3>

                            <p class="at-tier-price">
                                @if (hasPromo)
                                {
                                    <del>@regPrice</del> @promoPrice
                                }
                                else
                                {
                                    @regPrice
                                }
                            </p>

                            <p class="at-tier-desc">@desc</p>

                            <ul class="at-tier-perks">
                                @foreach (var perk in perksList)
                                {
                                    <li>@perk</li>
                                }
                            </ul>

                            @* The button appears for the tiers that have a price
                               at all; the others fill the same row with a note,
                               so that the shared grid does not collapse. The
                               condition used to be a hard-coded id ([D-02]). *@
                            <div class="at-tier-action">
                                @if (isPayable)
                                {
                                    <a asp-page="/Payment" asp-route-slug="@slug" class="at-tier-btn">
                                        @Localizer["Attend_BtnGetTicket"]
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                            <polyline points="13 6 19 12 13 18"></polyline>
                                        </svg>
                                    </a>
                                }
                                else if (tierIndex > 1)
                                {
                                    @* The first tier (normally the free "Viewer"
                                       access) needs neither an action nor a note:
                                       it is the default and nobody has to ask for
                                       it. The note only makes sense for the tiers
                                       after it. *@
                                    <p class="at-tier-note">@Localizer["Attend_TierNote_Request"]</p>
                                }
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
    </section>

    @* ── 02 · Other ways to take part ──────────────────────── *@
    <section class="at-sec reveal">
        <div class="at-pad">
            <div class="at-sec-head">
                <span class="at-ghost" aria-hidden="true">02</span>
                <p class="at-eyebrow">@Localizer["Attend_AccessLabel"]</p>
                <h2>@Localizer["Attend_AccessTitle"]</h2>
                <span class="at-rule"></span>
            </div>

            <div class="at-rows">
                @{
                    // The online-viewer row used to be rendered even with no
                    // link set. The model returns "#" until an administrator
                    // fills one in (see Attend.cshtml.cs), and "#" leads
                    // nowhere: a button that does nothing when pressed.
                    //
                    // rowIdx is incremented per rendered row, so the numbering
                    // stays 01, 02, 03 whichever rows are shown.
                    var hasOnlineLink = Model.WatchOnlineLink != "#";
                    var rowIdx = 0;
                }
                @if (hasOnlineLink)
                {
                    rowIdx++;
                    <article class="at-row">
                        <b class="at-row-idx">@rowIdx.ToString("00")</b>
                        <div class="at-row-icon"><img src="~/images/conference/chip.png" alt=""></div>
                        <div class="at-row-body">
                            <h3>@Localizer["Attend_AccessOnlineTitle"]</h3>
                            <p>@Localizer["Attend_AccessOnlineDesc"]</p>
                        </div>
                        <a href="@Model.WatchOnlineLink" class="at-link" target="_blank">
                            @Localizer["Attend_AccessOnlineBtn"]
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="13 6 19 12 13 18"></polyline>
                            </svg>
                        </a>
                    </article>
                }

                @{ rowIdx++; }
                <article class="at-row">
                    <b class="at-row-idx">@rowIdx.ToString("00")</b>
                    <div class="at-row-icon"><img src="~/images/conference/openbook.png" alt=""></div>
                    <div class="at-row-body">
                        <h3>@Localizer["Attend_AccessJournalistTitle"]</h3>
                        <p>@Localizer["Attend_AccessJournalistDesc"]</p>
                    </div>
                    @{
                        string journoLink = Model.RedirectJournalistToDocs ? "/SubmitDocuments" : "/Register?type=journalist";
                        string journoBtnText = Model.RedirectJournalistToDocs
                                                ? Localizer["Attend_AccessJournalistBtn_SubmitDocs"].Value
                                                : Localizer["Attend_AccessJournalistBtn"].Value;
                    }
                    <a href="@journoLink" class="at-link">
                        @journoBtnText
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="13 6 19 12 13 18"></polyline>
                        </svg>
                    </a>
                </article>
            </div>
        </div>
    </section>

    @* ── 03 · Extras and payment ───────────────────────────── *@
    <section class="at-sec at-sec--last reveal">
        <div class="at-pad">
            <div class="at-sec-head">
                <span class="at-ghost" aria-hidden="true">03</span>
                <p class="at-eyebrow">@Localizer["Attend_OrgLabel"]</p>
                <h2>@Localizer["Attend_ExtrasTitle"]</h2>
                <span class="at-rule"></span>
            </div>

            <div class="at-split">
                <div class="at-split-col">
                    <p class="at-col-label">
                        <span>@Localizer["Attend_ExtrasLabel"]</span>
                        <i>@Localizer["Attend_ExtrasSubLabel"]</i>
                    </p>

                    <div class="at-extra">
                        <div class="at-extra-icon"><img src="~/images/logos/transfer.png" alt=""></div>
                        <div class="at-extra-body">
                            <h4>@Localizer["Attend_Extra1Title"]</h4>
                            <p>@Localizer["Attend_Extra1Desc"]</p>
                        </div>
                    </div>

                    <div class="at-extra">
                        <div class="at-extra-icon"><img src="~/images/logos/location.png" alt=""></div>
                        <div class="at-extra-body">
                            <h4>@Localizer["Attend_Extra2Title"]</h4>
                            <p>@Localizer["Attend_Extra2Desc"]</p>
                        </div>
                    </div>
                </div>

                <div class="at-split-col">
                    <p class="at-col-label">
                        <span>@Localizer["Attend_PaymentMethods"]</span>
                        <i>@Localizer["Attend_PayLabel"]</i>
                    </p>

                    <div class="at-pay-head">
                        <div class="at-pay-icon"><img src="~/images/attend/bank.png" alt=""></div>
                        <h4>@Localizer["Attend_PayAccept"]</h4>
                    </div>

                    @* 01 · Credit and debit cards *@
                    <div class="at-method">
                        <b class="at-method-no">01</b>
                        <div>
                            <div class="at-method-head">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                                    <line x1="2" y1="10" x2="22" y2="10"/>
                                    <line x1="6" y1="15" x2="10" y2="15"/>
                                </svg>
                                <h5>@Localizer["Attend_Method_Card"]</h5>
                                <span class="at-tag at-tag--now">@Localizer["Attend_Tag_Instant"]</span>
                            </div>
                            <p>@Localizer["Attend_Method_CardDesc"]</p>
                        </div>
                    </div>

                    @* 02 · Crypto currencies *@
                    <div class="at-method">
                        <b class="at-method-no">02</b>
                        <div>
                            <div class="at-method-head">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <circle cx="12" cy="12" r="9"/>
                                    <path d="M9 8h4.5a2 2 0 0 1 0 4H9m0 0h5a2 2 0 0 1 0 4H9M9 8v8m3-10v2m0 8v2"/>
                                </svg>
                                <h5>@Localizer["Attend_Method_Crypto"]</h5>
                                <span class="at-tag at-tag--now">@Localizer["Attend_Tag_Instant"]</span>
                            </div>
                            <p>@Localizer["Attend_Method_CryptoDesc"]</p>
                        </div>
                    </div>

                    @* 03 · Bank transfer *@
                    <div class="at-method">
                        <b class="at-method-no">03</b>
                        <div>
                            <div class="at-method-head">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <rect x="3" y="6" width="18" height="13" rx="1"/>
                                    <path d="M3 9h18M8 13h2m4 0h2"/>
                                    <path d="M7 3l5 3 5-3"/>
                                </svg>
                                <h5>@Localizer["Attend_BankTransfer"]</h5>
                                <span class="at-tag at-tag--wait">1-3 @Localizer["Attend_Tag_Days"]</span>
                            </div>
                            <p>@Localizer["Attend_BankDesc"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</div>
</main>
