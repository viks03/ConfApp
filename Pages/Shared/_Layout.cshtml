            <div class="mobile-nav-footer">
                @if (promoSlides.Any())
                {
                    <div class="mobile-nav-promo-slider" id="mobile-nav-promo-slider">
                        <div class="mobile-nav-promo-track" id="mobile-nav-promo-track">
                            @foreach (var promo in promoSlides)
                            {
                                var title = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? promo.TitleBg : promo.TitleEn;
                                var desc  = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? promo.DescriptionBg : promo.DescriptionEn;
                                <div class="mobile-nav-promo-slide">
                                    <span class="mobile-nav-promo-art" aria-hidden="true">
                                        <img src="@promo.ImagePath" alt="">
                                    </span>
                                    <span class="mobile-nav-promo-text">
                                        <span class="mobile-nav-promo-title"><span class="mobile-nav-promo-title-inner">@title</span></span>
                                        <span class="mobile-nav-promo-desc">@desc</span>
                                    </span>
                                </div>
                            }
                        </div>
                        @if (promoSlides.Count > 1)
                        {
                            <div class="mobile-nav-promo-dots" id="mobile-nav-promo-dots" aria-hidden="true">
                                <div class="mobile-nav-promo-progress-track" id="mobile-nav-promo-progress-track">
                                    <div class="mobile-nav-promo-progress-thumb" id="mobile-nav-promo-progress-thumb"></div>
                                </div>
                            </div>
                        }
                    </div>
                }

            @if (socialPlatforms.Any())
            {
                <div class="mobile-nav-social">
                    @for (var i = 0; i < socialPlatforms.Count; i++)
                    {
                        var platform = socialPlatforms[i];
                        if (i > 0)
                        {
                            <span class="mobile-nav-social-divider" aria-hidden="true"></span>
                        }
                        <a href="@platform.Url" target="_blank" rel="noopener" aria-label="@platform.Label" class="mobile-nav-social-link">
                            @if (platform.Label == "LinkedIn")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                                    <line x1="8" y1="10" x2="8" y2="16"></line>
                                    <circle cx="8" cy="7" r="0.6" fill="currentColor" stroke="none"></circle>
                                    <path d="M12 16v-4a2 2 0 0 1 4 0v4"></path>
                                    <line x1="12" y1="10" x2="12" y2="16"></line>
                                </svg>
                            }
                            else if (platform.Label == "Facebook")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="4"></rect>
                                    <path d="M13.2 19v-5.6h1.9l.3-2.2h-2.2V9.8c0-.65.2-1.1 1.15-1.1H15.5V6.7c-.26-.03-1.13-.1-2.15-.1-2.13 0-3.58 1.3-3.58 3.68v2.05H7.9v2.2h1.87V19h3.43z" fill="currentColor" stroke="none"></path>
                                </svg>
                            }
                            else if (platform.Label == "X")
                            {
                                <svg viewBox="-3 -3 30 30" fill="currentColor" stroke="none">
                                    <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path>
                                </svg>
                            }
                            else if (platform.Label == "TikTok")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M13 4v10.6a3 3 0 1 1-2.1-2.86"></path>
                                    <path d="M13 4c.4 2.1 2.1 3.6 4 3.8"></path>
                                </svg>
                            }
                            else if (platform.Label == "YouTube")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="6" width="20" height="12" rx="4"></rect>
                                    <polygon points="10 9 16 12 10 15" fill="currentColor" stroke="none"></polygon>
                                </svg>
                            }
                            else if (platform.Label == "Instagram")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <circle cx="17.5" cy="6.5" r="0.7" fill="currentColor" stroke="none"></circle>
                                </svg>
                            }
                        </a>
                    }
                </div>
            }
        </div>
        </div>
    </div>

    @if (dataNoticeModel != null)
    {
        <partial name="_DataNotice" model="dataNoticeModel" />
    }

    @if (isAdminUser)
    {
        <partial name="_BugReportWidget" />
    }

    @* .site-main is what keeps the footer at the bottom of the viewport even
       on a short page such as Login — see body { display:flex;
       flex-direction:column } and .site-main { flex:1 } in mainStyle.css. *@
    @* The global ambient layer. Rendered BEFORE <main> so that it sits under
       the content; it disables itself under /Admin. The vars partial comes
       immediately after it, so that it wins on cascade order. *@
    <partial name="_GlobalEffects" />
    <partial name="_GlobalEffectsVars" />

    <main class="site-main">
        @RenderBody()
    </main>

    @* ==================== Footer ====================
       CTA cards at the top, an intro block with the social icons and a
       decorative "bit rain" canvas, a panel with the Quick Links and the
       contacts, the legal row and the copyright.
       The only JavaScript here beyond the existing .reveal scroll fade is the
       footerBitRain module in scriptMain.js, which draws into the
       .footer-intro-art canvas; the fade towards the text is pure CSS
       (mask-image).
       Every class introduced here is prefixed "footer-" and leaves the older
       .footer-inner / .footer-brand / .footer-contact / .copyright rules
       untouched, in case something else still uses them. *@
    <footer class="footer">
        <div class="footer-shell">

            @if (ViewContext.RouteData.Values["page"]?.ToString() == "/Index")
            {
                <div class="footer-cta-row reveal">
                    <a href="/Register" class="footer-cta-card footer-cta-card--primary">
                        <span class="footer-cta-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="8" r="4"></circle>
                                <path d="M2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 3.5 1.1"></path>
                                <line x1="18.5" y1="8" x2="18.5" y2="14"></line>
                                <line x1="15.5" y1="11" x2="21.5" y2="11"></line>
                            </svg>
                        </span>
                        <span class="footer-cta-label">@Localizer["Global_BtnRegisterAttend"]</span>
                        <span class="footer-cta-arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                    </a>
                    <a href="/Schedule" class="footer-cta-card footer-cta-card--outline">
                        <span class="footer-cta-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                            </svg>
                        </span>
                        <span class="footer-cta-label">@Localizer["Nav_Schedule"]</span>
                        <span class="footer-cta-arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                    </a>
                </div>
            }

            <div class="footer-intro reveal">
                <span class="footer-intro-art-frame" aria-hidden="true">
                    <canvas class="footer-intro-art"></canvas>
                </span>
                <div class="footer-intro-content">
                    @{
                        var footerTagline = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? footerContent.BrandTaglineBg : footerContent.BrandTaglineEn;
                        var footerHasTagline = !string.IsNullOrWhiteSpace(footerTagline);
                    }
                    <div class="footer-brand-row @(footerHasTagline ? "" : "no-tagline")">
                        <img src="~/images/logos/mainLogo.png" alt="logo" class="@(footerHasTagline ? "footer-brand-logo" : "mainLogo_Img")">
                        <div class="footer-brand-text">
                            <span class="footer-brand-title">Blockchain Education 2026</span>
                            @if (footerHasTagline)
                            {
                                <span class="footer-brand-tagline"><span class="footer-brand-tagline-inner">@footerTagline</span></span>
                            }
                        </div>
                    </div>
                    <p class="footer-desc">@Localizer["Footer_Desc"]</p>

                    @if (socialPlatforms.Any())
                    {
                        <div class="footer-social">
                            @for (var i = 0; i < socialPlatforms.Count; i++)
                            {
                                var platform = socialPlatforms[i];
                                <a href="@platform.Url" target="_blank" rel="noopener" aria-label="@platform.Label" class="footer-social-link">
                                    @if (platform.Label == "LinkedIn")
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                                            <line x1="8" y1="10" x2="8" y2="16"></line>
                                            <circle cx="8" cy="7" r="0.6" fill="currentColor" stroke="none"></circle>
                                            <path d="M12 16v-4a2 2 0 0 1 4 0v4"></path>
                                            <line x1="12" y1="10" x2="12" y2="16"></line>
                                        </svg>
                                    }
                                    else if (platform.Label == "Facebook")
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="4"></rect>
                                            <path d="M13.2 19v-5.6h1.9l.3-2.2h-2.2V9.8c0-.65.2-1.1 1.15-1.1H15.5V6.7c-.26-.03-1.13-.1-2.15-.1-2.13 0-3.58 1.3-3.58 3.68v2.05H7.9v2.2h1.87V19h3.43z" fill="currentColor" stroke="none"></path>
                                        </svg>
                                    }
                                    else if (platform.Label == "X")
                                    {
                                        <svg viewBox="-3 -3 30 30" fill="currentColor" stroke="none">
                                            <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path>
                                        </svg>
                                    }
                                    else if (platform.Label == "TikTok")
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M13 4v10.6a3 3 0 1 1-2.1-2.86"></path>
                                            <path d="M13 4c.4 2.1 2.1 3.6 4 3.8"></path>
                                        </svg>
                                    }
                                    else if (platform.Label == "YouTube")
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="2" y="6" width="20" height="12" rx="4"></rect>
                                            <polygon points="10 9 16 12 10 15" fill="currentColor" stroke="none"></polygon>
                                        </svg>
                                    }
                                    else if (platform.Label == "Instagram")
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                                            <circle cx="12" cy="12" r="4"></circle>
                                            <circle cx="17.5" cy="6.5" r="0.7" fill="currentColor" stroke="none"></circle>
                                        </svg>
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="footer-panel reveal">
                <div class="footer-col">
                    <h3 class="footer-col-title">
                        <span class="footer-col-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 15l6-6"></path>
                                <path d="M11 6l1-1a3.5 3.5 0 1 1 5 5l-1 1"></path>
                                <path d="M13 18l-1 1a3.5 3.5 0 1 1-5-5l1-1"></path>
                            </svg>
                        </span>
                        @Localizer["Footer_QuickLinks"]
                    </h3>
                    <ul class="footer-quicklinks">
                        @foreach (var link in footerQuickLinks)
                        {
                            var linkLabel = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? link.LabelBg : link.LabelEn;
                            <li>
                                <a href="@link.Url">
                                    <span class="footer-quicklink-main">
                                        <span class="footer-quicklink-icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(link.IconSvg)</svg>
                                        </span>
                                        <span class="footer-quicklink-label">@linkLabel</span>
                                    </span>
                                    <svg class="footer-quicklink-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="footer-col">
                    <h3 class="footer-col-title">
                        <span class="footer-col-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                <path d="M3 7l9 6 9-6"></path>
                            </svg>
                        </span>
                        @Localizer["Footer_Contact"]
                    </h3>
                    <ul class="footer-contact-list">
                        <li>
                            <span class="footer-contact-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"></path>
                                    <circle cx="12" cy="10" r="2.4"></circle>
                                </svg>
                            </span>
                            <span>@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? footerContent.ContactLocationBg : footerContent.ContactLocationEn)</span>
                        </li>
                        <li>
                            <span class="footer-contact-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                    <path d="M3 7l9 6 9-6"></path>
                                </svg>
                            </span>
                            <span>@footerContent.ContactEmail</span>
                        </li>
                        <li>
                            <span class="footer-contact-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4.5 4h3.4l1.3 4.3-2 1.4a12.6 12.6 0 0 0 5.6 5.6l1.4-2 4.3 1.3v3.4c0 .9-.7 1.6-1.6 1.6C10.7 19.6 4.4 13.3 4.4 5.9c0-.9.7-1.6 1.6-1.6z"></path>
                                </svg>
                            </span>
                            <span>@footerContent.ContactPhone</span>
                        </li>
                    </ul>

                    <div class="footer-org-note">
                        <span class="footer-org-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 10l9-6 9 6"></path>
                                <line x1="5" y1="10" x2="5" y2="19"></line>
                                <line x1="9" y1="10" x2="9" y2="19"></line>
                                <line x1="15" y1="10" x2="15" y2="19"></line>
                                <line x1="19" y1="10" x2="19" y2="19"></line>
                                <line x1="3" y1="19" x2="21" y2="19"></line>
                            </svg>
                        </span>
                        <p>@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? footerContent.OrgNoteBg : footerContent.OrgNoteEn)</p>
                    </div>
                </div>
            </div>

            <div class="footer-legal reveal">
                <a href="/Privacy" class="footer-legal-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6l7-3z"></path>
                        <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                    @Localizer["Footer_Privacy"]
                </a>
                <a href="/Terms" class="footer-legal-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 3h8l4 4v14H7z"></path>
                        <line x1="10" y1="10" x2="16" y2="10"></line>
                        <line x1="10" y1="14" x2="16" y2="14"></line>
                        <line x1="10" y1="18" x2="13" y2="18"></line>
                    </svg>
                    @Localizer["Footer_Terms"]
                </a>
            </div>

            <p class="footer-copyright">@Localizer["Footer_Copyright"]</p>
        </div>
    </footer>

    @* common.js comes first: it carries what every other script uses
       (escapeHtml, revealOnScroll, bindScrollArrow, topbarHeight,
       syncTopbarVar, lockScroll). See the file itself. *@
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/scriptMain.js" asp-append-version="true"></script>
    <script src="~/js/globalEffects.js" asp-append-version="true"></script>
    <script src="~/js/dataNotice.js" asp-append-version="true"></script>
    @* iconTint.js comes last: it works on the finished DOM and replaces the
       fixed CSS filter on the PNG icons with a mask in var(--accent), so that
       the icons follow the theme. See the comment in the file itself. *@
    <script src="~/js/iconTint.js" asp-append-version="true"></script>
    @if (isAdminUser)
    {
        <script src="~/js/bugReport.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>