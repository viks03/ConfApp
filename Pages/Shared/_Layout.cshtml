@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject ConferenceApp.Data.ApplicationDbContext DbContext
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using ConferenceApp.Models

@{
    // Social links + promo слайдове за мобилното навигационно меню —
    // зареждат се тук веднъж на всяко зареждане на страница, тъй като
    // _Layout.cshtml е споделен shared layout без собствен PageModel.
    // Изпразнени social полета просто не се показват (иконата липсва),
    // а не-active промо слайдове не влизат в carousel-а изобщо.
    var socialLinks = await DbContext.SocialLinksSettings.FirstOrDefaultAsync() ?? new SocialLinksSetting();
    var promoSlides = await DbContext.PromoSlides
        .Where(p => p.IsActive)
        .OrderBy(p => p.DisplayOrder)
        .ToListAsync();

    // Footer съдържание (tagline/org note/контакти) + Quick Links —
    // редът е НАРОЧНО рандомизиран при всяко зареждане на страница (виж
    // admin панела: Site Settings → Footer Quick Links — затова моделът
    // няма DisplayOrder поле), не curated от admin. FOOTER_QUICKLINKS_CAP
    // ограничава показаните линкове до 5 — ако в базата има повече
    // (админ може да добавя произволен брой), всяко зареждане на
    // страницата взима нови 5 на случаен принцип измежду ВСИЧКИ видими,
    // не само първите 5 — с времето посетителят вижда целия набор.
    const int FOOTER_QUICKLINKS_CAP = 5;
    var footerContent = await DbContext.FooterContents.FirstOrDefaultAsync() ?? new FooterContent();
    var footerRng = new Random();
    var footerQuickLinks = (await DbContext.FooterQuickLinks
            .Where(l => l.IsVisible)
            .ToListAsync())
        .OrderBy(_ => footerRng.Next())
        .Take(FOOTER_QUICKLINKS_CAP)
        .ToList();

    // Брой отворени bug report-и — само за админи, показва се като badge до
    // "Admin Panel" линка по-долу, за да е видимо от ВСЯКА страница, не само
    // след като отвориш /Admin/BugReports.
    var isAdminUser = User.IsInRole("Admin");
    int openBugReportCount = isAdminUser
        ? await DbContext.BugReports.CountAsync(b => b.Status == "Open")
        : 0;

    // Данни за cookie банера (Pages/Shared/_DataNotice.cshtml) — за ВСЕКИ
    // посетител на ПУБЛИЧНИЯ сайт, независимо дали е логнат. Проверката е
    // по AREA (route metadata), НЕ по роля — ако admin разгледа началната
    // страница докато е логнат, банерът трябва да се появи нормално; просто
    // не и вътре в /Admin/* страниците, защото: (1) admin панела е вътрешен
    // инструмент, не консуматорска страница — изскачащ consent банер върху
    // работния интерфейс е лоша практика; (2) admin панела ползва напълно
    // различна CSS система (adminPanel.css) от банера (mainStyle.css
    // токените --panel/--accent/--line не съществуват в admin контекста —
    // банерът би изглеждал счупен там).
    var isAdminArea = string.Equals(
        ViewContext.RouteData.Values["area"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase);

    ConferenceApp.Models.DataNoticeViewModel? dataNoticeModel = null;
    if (!isAdminArea)
    {
        var isBgCulture = System.Globalization.CultureInfo.CurrentUICulture
            .TwoLetterISOLanguageName.Equals("bg", StringComparison.OrdinalIgnoreCase);
        var visibleCookieCategories = await DbContext.CookieCategories
            .Where(c => c.IsVisible)
            .OrderBy(c => c.DisplayOrder)
            .ToListAsync();
        var cookieNotice = await DbContext.CookieNoticeContents.FirstOrDefaultAsync();

        // Проверка за вече запазено съгласие — директно тук, сървърно, за да
        // рендираме банера/relaunch бутона в правилното крайно състояние без
        // клиентско "проблясване" (banner се показва за момент, после се крие).
        // Версията ТРЯБВА да съвпада с DN_CONSENT_VERSION в dataNotice.js —
        // вдигни и двете едновременно, ако значително промениш категориите.
        const int dnConsentVersion = 1;
        var hasExistingConsent = false;
        if (Context.Request.Cookies.TryGetValue("dn_prefs", out var dnPrefsRaw) && !string.IsNullOrWhiteSpace(dnPrefsRaw))
        {
            try
            {
                using var dnPrefsDoc = System.Text.Json.JsonDocument.Parse(dnPrefsRaw);
                if (dnPrefsDoc.RootElement.TryGetProperty("v", out var dnVersionProp) &&
                    dnVersionProp.ValueKind == System.Text.Json.JsonValueKind.Number &&
                    dnVersionProp.GetInt32() == dnConsentVersion)
                {
                    hasExistingConsent = true;
                }
            }
            catch (System.Text.Json.JsonException)
            {
                // Развалена/подправена cookie — третираме като липсващо съгласие,
                // banner-ът просто ще се покаже отново.
            }
        }

        dataNoticeModel = new ConferenceApp.Models.DataNoticeViewModel
        {
            Categories = visibleCookieCategories,
            NoticeHtml = cookieNotice == null ? "" : (isBgCulture ? cookieNotice.ContentBg : cookieNotice.ContentEn),
            IsBg = isBgCulture,
            HasExistingConsent = hasExistingConsent
        };
    }

    // (label, url) за шестте платформи, В РЕДА, в който трябва да се
    // показват — филтрираме празните тук, за да е чист divider-а логиката
    // по-долу (divider само МЕЖДУ видими икони, не преди първата/след
    // последната).
    var socialPlatforms = new (string Label, string? Url)[]
    {
        ("LinkedIn",  socialLinks.LinkedInUrl),
        ("Facebook",  socialLinks.FacebookUrl),
        ("X",         socialLinks.XUrl),
        ("TikTok",    socialLinks.TikTokUrl),
        ("YouTube",   socialLinks.YouTubeUrl),
        ("Instagram", socialLinks.InstagramUrl),
    }.Where(p => !string.IsNullOrWhiteSpace(p.Url)).ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <meta name="theme-color" content="#050505">
    <title>@ViewData["Title"] | Blockchain Education 2026</title>
    <link rel="stylesheet" href="~/css/mainStyle.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/dataNotice.css" asp-append-version="true">
    @if (isAdminUser)
    {
        <link rel="stylesheet" href="~/css/bugReport.css" asp-append-version="true">
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/Index">
            <img src="~/images/logos/mainLogo.png" alt="logo" class="mainLogo_Img">
            <span>Blockchain Education 2026</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav-overlay" aria-label="@Localizer["Nav_OpenMenu"]" data-label-open="@Localizer["Nav_OpenMenu"]" data-label-close="@Localizer["Nav_CloseMenu"]" style="touch-action: manipulation;">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <nav class="nav" id="site-nav">
            <a href="/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">@Localizer["Nav_Home"]</a>
            <a href="/Conference" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Conference" ? "active" : "")">@Localizer["Nav_Conference"]</a>
            <a href="/ICBI" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/ICBI" ? "active" : "")">@Localizer["Nav_ICBI"]</a>
            <a href="/Lecturers" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Lecturers" ? "active" : "")">@Localizer["Nav_Lecturers"]</a>
            <a href="/Schedule" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Schedule" ? "active" : "")">@Localizer["Nav_Schedule"]</a>
            <a href="/Attend" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Attend" ? "active" : "")">@Localizer["Nav_Attend"]</a>
            <a href="/FAQ" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/FAQ" ? "active" : "")">@Localizer["Nav_FAQ"]</a>
            <a href="/Travel" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Travel" ? "active" : "")">@Localizer["Nav_Travel"]</a>
        </nav>
        <div class="topbar-actions">
            <button class="lang-switch" type="button" onclick="setLanguage('bg')">BG</button>
            <button class="lang-switch" type="button" onclick="setLanguage('en')">EN</button>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                @* Администраторът вижда "Admin Panel", обикновеният потребител вижда "My Profile" —
                   освен ако вече не е в самия админ панел, където такъв линк би сочил към себе си. *@
                @if (User.IsInRole("Admin"))
                {
                    @if (Context.Request.Path.StartsWithSegments("/Admin"))
                    {
                        <a class="register-btn" href="/" style="text-decoration: none;">
                            Back to Site
                        </a>
                    }
                    else
                    {
                        <a class="register-btn" href="/Admin" style="text-decoration: none; position: relative;">
                            @Localizer["Nav_AdminPanel"]
                            @if (openBugReportCount > 0)
                            {
                                <span style="position:absolute; top:-7px; right:-9px; background:#dc2626; color:#fff; font-size:10px; font-weight:800; line-height:1; padding:2px 5px; border-radius:999px; min-width:16px; text-align:center;">@(openBugReportCount > 99 ? "99+" : openBugReportCount.ToString())</span>
                            }
                        </a>
                    }
                }
                else
                {
                    <a class="register-btn" href="/Profile" style="text-decoration: none;">
                        @Localizer["Nav_Profile"]</a>
                }
                
                @* Форма за Logout *@
                <form method="post" asp-page="/Logout" style="display: inline;">
                    <button type="submit" class="login-btn" style="background: none; border: none; cursor: pointer; padding: 0; font: inherit; color: inherit; margin-left: 10px;">
                        @Localizer["Nav_Logout"]
                    </button>
                </form>
            }
            else
            {
                @* Бутони за гости *@
                <a class="register-btn" href="/Register">@Localizer["Nav_Register"]</a>
                <a class="login-btn" href="/Login">@Localizer["Nav_Login"]</a>
            }
        </div>
    </header>

    @* ==================== Full-screen mobile nav (≤1240px) ====================
       Отделна структура от .nav по-горе (десктопа не я вижда изобщо) — full-screen
       overlay, който се плъзга отляво надясно, с декоративна вертикална лента с
       частици отляво (mobileNavParticles в scriptMain.js), карти с икони за
       линковете, промо карта и social ред. Управлява се от JS чрез .is-open
       клас на #mobile-nav-overlay + body.mobile-nav-open (лок на скрола). *@
    <div class="mobile-nav-overlay" id="mobile-nav-overlay" aria-hidden="true" style="touch-action: manipulation;">
        <div class="mobile-nav-decor" aria-hidden="true">
            <canvas id="mobile-nav-particles"></canvas>
        </div>

        <div class="mobile-nav-panel">
            <div class="mobile-nav-scroll">
                <nav class="mobile-nav-links">
                <a href="/Index" class="mobile-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
                    <span class="mobile-nav-link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 11l9-8 9 8"></path>
                            <path d="M5 10v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10"></path>
                        </svg>
                    </span>
                    <span class="mobile-nav-link-label">@Localizer["Nav_Home"]</span>
                    <span class="mobile-nav-link-arrow">
                        <svg class="mobile-nav-arrow-active" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        <svg class="mobile-nav-arrow-inactive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </span>
                </a>

                <a href="/Conference" class="mobile-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Conference" ? "active" : "")">
                    <span class="mobile-nav-link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="8" r="3"></circle>
                            <path d="M2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v1"></path>
                            <circle cx="17" cy="8" r="2.5"></circle>
                            <path d="M17 13.5c2.5.3 4.5 2.4 4.5 5V21"></path>
                        </svg>
                    </span>
                    <span class="mobile-nav-link-label">@Localizer["Nav_Conference"]</span>
                    <span class="mobile-nav-link-arrow">
                        <svg class="mobile-nav-arrow-active" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        <svg class="mobile-nav-arrow-inactive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </span>
                </a>

                <a href="/ICBI" class="mobile-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/ICBI" ? "active" : "")">
                    <span class="mobile-nav-link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="22" x2="21" y2="22"></line>
                            <line x1="6" y1="18" x2="6" y2="11"></line>
                            <line x1="10" y1="18" x2="10" y2="11"></line>
                            <line x1="14" y1="18" x2="14" y2="11"></line>
                            <line x1="18" y1="18" x2="18" y2="11"></line>
                            <polygon points="12 2 21 8 3 8"></polygon>
                        </svg>
                    </span>
                    <span class="mobile-nav-link-label">@Localizer["Nav_ICBI"]</span>
                    <span class="mobile-nav-link-arrow">
                        <svg class="mobile-nav-arrow-active" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        <svg class="mobile-nav-arrow-inactive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </span>
                </a>

                <a href="/Lecturers" class="mobile-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Lecturers" ? "active" : "")">
                    <span class="mobile-nav-link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
                        </svg>
                    </span>
                    <span class="mobile-nav-link-label">@Localizer["Nav_Lecturers"]</span>
                    <span class="mobile-nav-link-arrow">
                        <svg class="mobile-nav-arrow-active" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        <svg class="mobile-nav-arrow-inactive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </span>
                </a>

                <a href="/Schedule" class="mobile-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Schedule" ? "active" : "")">
                    <span class="mobile-nav-link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                        </svg>
                    </span>
                    <span class="mobile-nav-link-label">@Localizer["Nav_Schedule"]</span>
                    <span class="mobile-nav-link-arrow">
                        <svg class="mobile-nav-arrow-active" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        <svg class="mobile-nav-arrow-inactive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </span>
                </a>

                <a href="/Attend" class="mobile-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Attend" ? "active" : "")">
                    <span class="mobile-nav-link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="8" r="4"></circle>
                            <path d="M2 21c0-4.4 3.1-8 7-8s7 3.6 7 8"></path>
                            <line x1="18" y1="6" x2="18" y2="12"></line>
                            <line x1="15" y1="9" x2="21" y2="9"></line>
                        </svg>
                    </span>
                    <span class="mobile-nav-link-label">@Localizer["Nav_Attend"]</span>
                    <span class="mobile-nav-link-arrow">
                        <svg class="mobile-nav-arrow-active" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        <svg class="mobile-nav-arrow-inactive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </span>
                </a>

                <a href="/FAQ" class="mobile-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/FAQ" ? "active" : "")">
                    <span class="mobile-nav-link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M9.5 9a2.5 2.5 0 1 1 3.4 2.3c-.9.4-1.4 1-1.4 2"></path>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                    </span>
                    <span class="mobile-nav-link-label">@Localizer["Nav_FAQ"]</span>
                    <span class="mobile-nav-link-arrow">
                        <svg class="mobile-nav-arrow-active" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        <svg class="mobile-nav-arrow-inactive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </span>
                </a>

                <a href="/Travel" class="mobile-nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Travel" ? "active" : "")">
                    <span class="mobile-nav-link-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                    </span>
                    <span class="mobile-nav-link-label">@Localizer["Nav_Travel"]</span>
                    <span class="mobile-nav-link-arrow">
                        <svg class="mobile-nav-arrow-active" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        <svg class="mobile-nav-arrow-inactive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </span>
                </a>
                </nav>
            </div>

            <div class="mobile-nav-footer">
                @if (promoSlides.Any())
                {
                    <div class="mobile-nav-promo-slider" id="mobile-nav-promo-slider">
                        <div class="mobile-nav-promo-track" id="mobile-nav-promo-track">
                            @foreach (var promo in promoSlides)
                            {
                                var title = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? promo.TitleBg : promo.TitleEn;
                                var desc  = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? promo.DescriptionBg : promo.DescriptionEn;
                                <div class="mobile-nav-promo-slide">
                                    <span class="mobile-nav-promo-art" aria-hidden="true">
                                        <img src="@promo.ImagePath" alt="">
                                    </span>
                                    <span class="mobile-nav-promo-text">
                                        <span class="mobile-nav-promo-title"><span class="mobile-nav-promo-title-inner">@title</span></span>
                                        <span class="mobile-nav-promo-desc">@desc</span>
                                    </span>
                                </div>
                            }
                        </div>
                        @if (promoSlides.Count > 1)
                        {
                            <div class="mobile-nav-promo-dots" id="mobile-nav-promo-dots" aria-hidden="true">
                                <div class="mobile-nav-promo-progress-track" id="mobile-nav-promo-progress-track">
                                    <div class="mobile-nav-promo-progress-thumb" id="mobile-nav-promo-progress-thumb"></div>
                                </div>
                            </div>
                        }
                    </div>
                }

            @if (socialPlatforms.Any())
            {
                <div class="mobile-nav-social">
                    @for (var i = 0; i < socialPlatforms.Count; i++)
                    {
                        var platform = socialPlatforms[i];
                        if (i > 0)
                        {
                            <span class="mobile-nav-social-divider" aria-hidden="true"></span>
                        }
                        <a href="@platform.Url" target="_blank" rel="noopener" aria-label="@platform.Label" class="mobile-nav-social-link">
                            @if (platform.Label == "LinkedIn")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                                    <line x1="8" y1="10" x2="8" y2="16"></line>
                                    <circle cx="8" cy="7" r="0.6" fill="currentColor" stroke="none"></circle>
                                    <path d="M12 16v-4a2 2 0 0 1 4 0v4"></path>
                                    <line x1="12" y1="10" x2="12" y2="16"></line>
                                </svg>
                            }
                            else if (platform.Label == "Facebook")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="4"></rect>
                                    <path d="M13.2 19v-5.6h1.9l.3-2.2h-2.2V9.8c0-.65.2-1.1 1.15-1.1H15.5V6.7c-.26-.03-1.13-.1-2.15-.1-2.13 0-3.58 1.3-3.58 3.68v2.05H7.9v2.2h1.87V19h3.43z" fill="currentColor" stroke="none"></path>
                                </svg>
                            }
                            else if (platform.Label == "X")
                            {
                                <svg viewBox="-3 -3 30 30" fill="currentColor" stroke="none">
                                    <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path>
                                </svg>
                            }
                            else if (platform.Label == "TikTok")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M13 4v10.6a3 3 0 1 1-2.1-2.86"></path>
                                    <path d="M13 4c.4 2.1 2.1 3.6 4 3.8"></path>
                                </svg>
                            }
                            else if (platform.Label == "YouTube")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="6" width="20" height="12" rx="4"></rect>
                                    <polygon points="10 9 16 12 10 15" fill="currentColor" stroke="none"></polygon>
                                </svg>
                            }
                            else if (platform.Label == "Instagram")
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <circle cx="17.5" cy="6.5" r="0.7" fill="currentColor" stroke="none"></circle>
                                </svg>
                            }
                        </a>
                    }
                </div>
            }
        </div>
        </div>
    </div>

    @if (dataNoticeModel != null)
    {
        <partial name="_DataNotice" model="dataNoticeModel" />
    }

    @if (isAdminUser)
    {
        <partial name="_BugReportWidget" />
    }

    @* site-main осигурява footer-ът винаги да е "залепен" за долния край на
       viewport-а дори на страници с малко съдържание (напр. Login) — виж
       body { display:flex; flex-direction:column } + .site-main { flex:1 }
       в mainStyle.css. *@
    <main class="site-main">
        @RenderBody()
    </main>

    @* ==================== Footer (redesign skeleton, Aug 2026) ====================
       Ново оформление по мобилния reference: CTA карти горе, intro/brand
       блок със social икони + декоративен "bit rain" canvas, панел с
       Quick Links + Contact, легален ред и copyright. Линковете сочат
       към реални страници. Единствената реална JS логика извън
       съществуващия .reveal scroll-fade е footerBitRain модула в
       scriptMain.js, който рисува в .footer-intro-art canvas-а —
       fade-а навлязо към текста е чист CSS (mask-image), не JS. Всички
       нови класове са с представка "footer-" и НЕ пипат старите
       .footer-inner/.footer-brand/.footer-contact/.copyright правила
       по-долу в CSS, в случай че се ползват другаде. *@
    <footer class="footer">
        <div class="footer-shell">

            @if (ViewContext.RouteData.Values["page"]?.ToString() == "/Index")
            {
                <div class="footer-cta-row reveal">
                    <a href="/Register" class="footer-cta-card footer-cta-card--primary">
                        <span class="footer-cta-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="8" r="4"></circle>
                                <path d="M2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 3.5 1.1"></path>
                                <line x1="18.5" y1="8" x2="18.5" y2="14"></line>
                                <line x1="15.5" y1="11" x2="21.5" y2="11"></line>
                            </svg>
                        </span>
                        <span class="footer-cta-label">@Localizer["Global_BtnRegisterAttend"]</span>
                        <span class="footer-cta-arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                    </a>
                    <a href="/Schedule" class="footer-cta-card footer-cta-card--outline">
                        <span class="footer-cta-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                            </svg>
                        </span>
                        <span class="footer-cta-label">@Localizer["Nav_Schedule"]</span>
                        <span class="footer-cta-arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                    </a>
                </div>
            }

            <div class="footer-intro reveal">
                <span class="footer-intro-art-frame" aria-hidden="true">
                    <canvas class="footer-intro-art"></canvas>
                </span>
                <div class="footer-intro-content">
                    @{
                        var footerTagline = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? footerContent.BrandTaglineBg : footerContent.BrandTaglineEn;
                        var footerHasTagline = !string.IsNullOrWhiteSpace(footerTagline);
                    }
                    <div class="footer-brand-row @(footerHasTagline ? "" : "no-tagline")">
                        <img src="~/images/logos/mainLogo.png" alt="logo" class="@(footerHasTagline ? "footer-brand-logo" : "mainLogo_Img")">
                        <div class="footer-brand-text">
                            <span class="footer-brand-title">Blockchain Education 2026</span>
                            @if (footerHasTagline)
                            {
                                <span class="footer-brand-tagline"><span class="footer-brand-tagline-inner">@footerTagline</span></span>
                            }
                        </div>
                    </div>
                    <p class="footer-desc">@Localizer["Footer_Desc"]</p>

                    @if (socialPlatforms.Any())
                    {
                        <div class="footer-social">
                            @for (var i = 0; i < socialPlatforms.Count; i++)
                            {
                                var platform = socialPlatforms[i];
                                <a href="@platform.Url" target="_blank" rel="noopener" aria-label="@platform.Label" class="footer-social-link">
                                    @if (platform.Label == "LinkedIn")
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                                            <line x1="8" y1="10" x2="8" y2="16"></line>
                                            <circle cx="8" cy="7" r="0.6" fill="currentColor" stroke="none"></circle>
                                            <path d="M12 16v-4a2 2 0 0 1 4 0v4"></path>
                                            <line x1="12" y1="10" x2="12" y2="16"></line>
                                        </svg>
                                    }
                                    else if (platform.Label == "Facebook")
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="4"></rect>
                                            <path d="M13.2 19v-5.6h1.9l.3-2.2h-2.2V9.8c0-.65.2-1.1 1.15-1.1H15.5V6.7c-.26-.03-1.13-.1-2.15-.1-2.13 0-3.58 1.3-3.58 3.68v2.05H7.9v2.2h1.87V19h3.43z" fill="currentColor" stroke="none"></path>
                                        </svg>
                                    }
                                    else if (platform.Label == "X")
                                    {
                                        <svg viewBox="-3 -3 30 30" fill="currentColor" stroke="none">
                                            <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path>
                                        </svg>
                                    }
                                    else if (platform.Label == "TikTok")
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M13 4v10.6a3 3 0 1 1-2.1-2.86"></path>
                                            <path d="M13 4c.4 2.1 2.1 3.6 4 3.8"></path>
                                        </svg>
                                    }
                                    else if (platform.Label == "YouTube")
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="2" y="6" width="20" height="12" rx="4"></rect>
                                            <polygon points="10 9 16 12 10 15" fill="currentColor" stroke="none"></polygon>
                                        </svg>
                                    }
                                    else if (platform.Label == "Instagram")
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                                            <circle cx="12" cy="12" r="4"></circle>
                                            <circle cx="17.5" cy="6.5" r="0.7" fill="currentColor" stroke="none"></circle>
                                        </svg>
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="footer-panel reveal">
                <div class="footer-col">
                    <h3 class="footer-col-title">
                        <span class="footer-col-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 15l6-6"></path>
                                <path d="M11 6l1-1a3.5 3.5 0 1 1 5 5l-1 1"></path>
                                <path d="M13 18l-1 1a3.5 3.5 0 1 1-5-5l1-1"></path>
                            </svg>
                        </span>
                        @Localizer["Footer_QuickLinks"]
                    </h3>
                    <ul class="footer-quicklinks">
                        @foreach (var link in footerQuickLinks)
                        {
                            var linkLabel = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? link.LabelBg : link.LabelEn;
                            <li>
                                <a href="@link.Url">
                                    <span class="footer-quicklink-main">
                                        <span class="footer-quicklink-icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(link.IconSvg)</svg>
                                        </span>
                                        <span class="footer-quicklink-label">@linkLabel</span>
                                    </span>
                                    <svg class="footer-quicklink-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="footer-col">
                    <h3 class="footer-col-title">
                        <span class="footer-col-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                <path d="M3 7l9 6 9-6"></path>
                            </svg>
                        </span>
                        @Localizer["Footer_Contact"]
                    </h3>
                    <ul class="footer-contact-list">
                        <li>
                            <span class="footer-contact-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"></path>
                                    <circle cx="12" cy="10" r="2.4"></circle>
                                </svg>
                            </span>
                            <span>@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? footerContent.ContactLocationBg : footerContent.ContactLocationEn)</span>
                        </li>
                        <li>
                            <span class="footer-contact-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                    <path d="M3 7l9 6 9-6"></path>
                                </svg>
                            </span>
                            <span>@footerContent.ContactEmail</span>
                        </li>
                        <li>
                            <span class="footer-contact-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4.5 4h3.4l1.3 4.3-2 1.4a12.6 12.6 0 0 0 5.6 5.6l1.4-2 4.3 1.3v3.4c0 .9-.7 1.6-1.6 1.6C10.7 19.6 4.4 13.3 4.4 5.9c0-.9.7-1.6 1.6-1.6z"></path>
                                </svg>
                            </span>
                            <span>@footerContent.ContactPhone</span>
                        </li>
                    </ul>

                    <div class="footer-org-note">
                        <span class="footer-org-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 10l9-6 9 6"></path>
                                <line x1="5" y1="10" x2="5" y2="19"></line>
                                <line x1="9" y1="10" x2="9" y2="19"></line>
                                <line x1="15" y1="10" x2="15" y2="19"></line>
                                <line x1="19" y1="10" x2="19" y2="19"></line>
                                <line x1="3" y1="19" x2="21" y2="19"></line>
                            </svg>
                        </span>
                        <p>@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "bg" ? footerContent.OrgNoteBg : footerContent.OrgNoteEn)</p>
                    </div>
                </div>
            </div>

            <div class="footer-legal reveal">
                <a href="/Privacy" class="footer-legal-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6l7-3z"></path>
                        <polyline points="9 12 11 14 15 10"></polyline>
                    </svg>
                    @Localizer["Footer_Privacy"]
                </a>
                <a href="/Terms" class="footer-legal-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 3h8l4 4v14H7z"></path>
                        <line x1="10" y1="10" x2="16" y2="10"></line>
                        <line x1="10" y1="14" x2="16" y2="14"></line>
                        <line x1="10" y1="18" x2="13" y2="18"></line>
                    </svg>
                    @Localizer["Footer_Terms"]
                </a>
            </div>

            <p class="footer-copyright">@Localizer["Footer_Copyright"]</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/scriptMain.js" asp-append-version="true"></script>
    <script src="~/js/dataNotice.js" asp-append-version="true"></script>
    @if (isAdminUser)
    {
        <script src="~/js/bugReport.js" asp-append-version="true"></script>
    }
    <script>
        function setLanguage(culture) {
            const cookieValue = ".AspNetCore.Culture=c=" + culture + "|uic=" + culture;
            document.cookie = cookieValue + ";path=/";
            location.reload();
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
