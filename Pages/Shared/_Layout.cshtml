@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject ConferenceApp.Data.ApplicationDbContext DbContext
@inject ConferenceApp.Services.Theming.ThemeProvider Themes
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using ConferenceApp.Models


@* ─────────────────────────────────────────────────────────────────────
   ConferenceApp · Blockchain Education 2026
   Author: Viktor Georgiev
   ───────────────────────────────────────────────────────────────────── *@

@{
    // The shared layout has no page model of its own, so the few things every
    // page needs are read here — once per request.
    //
    // Social links and the promo slides for the mobile menu. An empty social
    // field simply means no icon; a slide that is not active never reaches the
    // carousel.
    var socialLinks = await DbContext.SocialLinksSettings.FirstOrDefaultAsync() ?? new SocialLinksSetting();
    var promoSlides = await DbContext.PromoSlides
        .Where(p => p.IsActive)
        .OrderBy(p => p.DisplayOrder)
        .ToListAsync();

    // Footer content (tagline, org note, contacts) and the Quick Links.
    //
    // Their order is DELIBERATELY random on every page load, which is why the
    // model has no DisplayOrder column. FOOTER_QUICKLINKS_CAP shows five of
    // them; an administrator may store any number, and each load draws a fresh
    // five at random from ALL the visible ones rather than taking the first
    // five — so over time a visitor sees the whole set.
    const int FOOTER_QUICKLINKS_CAP = 5;
    var footerContent = await DbContext.FooterContents.FirstOrDefaultAsync() ?? new FooterContent();
    var footerRng = new Random();
    var footerQuickLinks = (await DbContext.FooterQuickLinks
            .Where(l => l.IsVisible)
            .ToListAsync())
        .OrderBy(_ => footerRng.Next())
        .Take(FOOTER_QUICKLINKS_CAP)
        .ToList();

    // The number of open bug reports, for administrators only. It is shown as
    // a badge next to the "Admin Panel" link, so that it is visible from EVERY
    // page rather than only after opening /Admin/BugReports.
    var isAdminUser = User.IsInRole("Admin");
    int openBugReportCount = isAdminUser
        ? await DbContext.BugReports.CountAsync(b => b.Status == "Open")
        : 0;

    // The data for the cookie banner (Pages/Shared/_DataNotice.cshtml), shown
    // to EVERY visitor of the public site, signed in or not.
    //
    // The test is on the AREA, not on the role: an administrator browsing the
    // home page should see the banner like anybody else. It is only the
    // /Admin/* pages that are excluded, for two reasons. The panel is an
    // internal tool rather than a public page, and a consent banner popping up
    // over a working interface is simply wrong. And the panel uses a different
    // CSS system (adminPanel.css) — the --panel, --accent and --line tokens the
    // banner is built on do not exist there, so it would render broken.
    var isAdminArea = string.Equals(
        ViewContext.RouteData.Values["area"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase);

    ConferenceApp.Models.DataNoticeViewModel? dataNoticeModel = null;
    if (!isAdminArea)
    {
        var isBgCulture = System.Globalization.CultureInfo.CurrentUICulture
            .TwoLetterISOLanguageName.Equals("bg", StringComparison.OrdinalIgnoreCase);
        var visibleCookieCategories = await DbContext.CookieCategories
            .Where(c => c.IsVisible)
            .OrderBy(c => c.DisplayOrder)
            .ToListAsync();
        var cookieNotice = await DbContext.CookieNoticeContents.FirstOrDefaultAsync();

        // Whether consent has already been given is decided here, on the
        // server, so that the banner and the relaunch button render in their
        // final state — without the flash of a banner that appears and then
        // hides itself.
        //
        // The version MUST match DN_CONSENT_VERSION in dataNotice.js: raise
        // both together if the categories change in a way that makes an older
        // consent meaningless.
        const int dnConsentVersion = 1;
        var hasExistingConsent = false;
        if (Context.Request.Cookies.TryGetValue("dn_prefs", out var dnPrefsRaw) && !string.IsNullOrWhiteSpace(dnPrefsRaw))
        {
            try
            {
                using var dnPrefsDoc = System.Text.Json.JsonDocument.Parse(dnPrefsRaw);
                if (dnPrefsDoc.RootElement.TryGetProperty("v", out var dnVersionProp) &&
                    dnVersionProp.ValueKind == System.Text.Json.JsonValueKind.Number &&
                    dnVersionProp.GetInt32() == dnConsentVersion)
                {
                    hasExistingConsent = true;
                }
            }
            catch (System.Text.Json.JsonException)
            {
                // A corrupt or tampered cookie counts as no consent at all: the
                // banner simply appears again.
            }
        }

        dataNoticeModel = new ConferenceApp.Models.DataNoticeViewModel
        {
            Categories = visibleCookieCategories,
            NoticeHtml = cookieNotice == null ? "" : (isBgCulture ? cookieNotice.ContentBg : cookieNotice.ContentEn),
            IsBg = isBgCulture,
            HasExistingConsent = hasExistingConsent
        };
    }

    // (label, url) for the six platforms, in the order they are shown. The
    // empty ones are filtered out here, which is what lets the divider logic
    // below stay simple: a divider only BETWEEN visible icons, never before the
    // first or after the last.
    var socialPlatforms = new (string Label, string? Url)[]
    {
        ("LinkedIn",  socialLinks.LinkedInUrl),
        ("Facebook",  socialLinks.FacebookUrl),
        ("X",         socialLinks.XUrl),
        ("TikTok",    socialLinks.TikTokUrl),
        ("YouTube",   socialLinks.YouTubeUrl),
        ("Instagram", socialLinks.InstagramUrl),
    }.Where(p => !string.IsNullOrWhiteSpace(p.Url)).ToList();
}

<!DOCTYPE html>
@* [T-22] The document language follows the chosen one instead of staying at
   "en": a screen reader picks its voice by it, and the browser decides whether
   to offer a translation. A Bulgarian page marked lang="en" is read out by an
   English speech synthesizer. *@
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <meta name="theme-color" content="#050505">
    <title>@ViewData["Title"] | Blockchain Education 2026</title>
    <link rel="stylesheet" href="~/css/mainStyle.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/globalEffects.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/dataNotice.css" asp-append-version="true">

    @* The active theme OVERRIDES the tokens from mainStyle.css, which is why
       it comes AFTER it rather than before. A theme only changes the values of
       custom properties; with no active theme — the normal state — there is no
       block at all and the page looks exactly as it does without themes.
       ThemeProvider caches the CSS and the panel clears that cache on every
       change, so a switch takes effect without a restart. The values are
       validated by ThemeTokens.Parse both on import AND on read, so only
       checked CSS reaches Html.Raw. *@
    @{
        var themeCss = Themes.GetCss();
    }
    @if (!string.IsNullOrEmpty(themeCss))
    {
        <style>@Html.Raw(themeCss)</style>
    }
    @if (isAdminUser)
    {
        <link rel="stylesheet" href="~/css/bugReport.css" asp-append-version="true">
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/Index">
            <img src="~/images/logos/mainLogo.png" alt="logo" class="mainLogo_Img">
            <span>Blockchain Education 2026</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav-overlay" aria-label="@Localizer["Nav_OpenMenu"]" data-label-open="@Localizer["Nav_OpenMenu"]" data-label-close="@Localizer["Nav_CloseMenu"]" style="touch-action: manipulation;">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <nav class="nav" id="site-nav">
            <a href="/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">@Localizer["Nav_Home"]</a>
            <a href="/Conference" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Conference" ? "active" : "")">@Localizer["Nav_Conference"]</a>
            <a href="/ICBI" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/ICBI" ? "active" : "")">@Localizer["Nav_ICBI"]</a>
            <a href="/Lecturers" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Lecturers" ? "active" : "")">@Localizer["Nav_Lecturers"]</a>
            <a href="/Schedule" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Schedule" ? "active" : "")">@Localizer["Nav_Schedule"]</a>
            <a href="/Attend" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Attend" ? "active" : "")">@Localizer["Nav_Attend"]</a>
            <a href="/FAQ" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/FAQ" ? "active" : "")">@Localizer["Nav_FAQ"]</a>
            <a href="/Travel" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Travel" ? "active" : "")">@Localizer["Nav_Travel"]</a>
        </nav>
        <div class="topbar-actions">
            @* The buttons submit the hidden #lang-form below through the HTML
               `form` attribute, so that the order inside .topbar-actions stays
               as it is — the form itself is not a flex item. The switch goes
               through LanguageController, which writes a cookie that lasts a
               year; the inline script that used to be here wrote a session
               cookie and the choice was lost when the browser closed. *@
            <button class="lang-switch" type="submit" form="lang-form" name="culture" value="bg">BG</button>
            <button class="lang-switch" type="submit" form="lang-form" name="culture" value="en">EN</button>
            
            @if (User.Identity?.IsAuthenticated == true)
            {
                @* An administrator sees "Admin Panel" and everyone else "My
                   Profile" — except inside the panel itself, where such a link
                   would point at the page you are already on. *@
                @if (User.IsInRole("Admin"))
                {
                    @if (Context.Request.Path.StartsWithSegments("/Admin"))
                    {
                        <a class="register-btn" href="/" style="text-decoration: none;">
                            @Localizer["Nav_BackToSite"]
                        </a>
                    }
                    else
                    {
                        <a class="register-btn" href="/Admin" style="text-decoration: none; position: relative;">
                            @Localizer["Nav_AdminPanel"]
                            @if (openBugReportCount > 0)
                            {
                                <span style="position:absolute; top:-7px; right:-9px; background:#dc2626; color:#fff; font-size:10px; font-weight:800; line-height:1; padding:2px 5px; border-radius:999px; min-width:16px; text-align:center;">@(openBugReportCount > 99 ? "99+" : openBugReportCount.ToString())</span>
                            }
                        </a>
                    }
                }
                else
                {
                    <a class="register-btn" href="/Profile" style="text-decoration: none;">
                        @Localizer["Nav_Profile"]</a>
                }
                
                @* Sign-out is a POST form, not a link: see [T-06] in
                   Logout.cshtml.cs. *@
                <form method="post" asp-page="/Logout" style="display: inline;">
                    <button type="submit" class="login-btn" style="background: none; border: none; cursor: pointer; margin-left: 10px;">
                        @Localizer["Nav_Logout"]
                    </button>
                </form>
            }
            else
            {
                @* Visitors who are not signed in *@
                <a class="register-btn" href="/Register">@Localizer["Nav_Register"]</a>
                <a class="login-btn" href="/Login">@Localizer["Nav_Login"]</a>
            }
        </div>
        <form id="lang-form" method="post" asp-controller="Language" asp-action="SetLanguage" hidden>
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
        </form>
    </header>

    @* ==================== Full-screen mobile nav (≤1240px) ====================
       A structure of its own, separate from the .nav above, which a desktop
       never renders: a full-screen overlay that slides in from the left, with a
       decorative particle strip down its side (mobileNavParticles in
       scriptMain.js), icon cards for the links, a promo card and a row of
       social icons. The script drives it through the .is-open class on
       #mobile-nav-overlay plus body.mobile-nav-open, which locks the scroll. *@
    <div class="mobile-nav-overlay" id="mobile-nav-overlay" aria-hidden="true" style="touch-action: manipulation;">
        <div class="mobile-nav-decor" aria-hidden="true">
            <canvas id="mobile-nav-particles"></canvas>
