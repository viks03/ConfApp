@page
@model ConferenceApp.Pages.TravelModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Travel_PageTitle"];
    var isBg = System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName.ToLower() == "bg";
}

@section Styles {
    <link rel="stylesheet" href="~/css/travelStyle.css" asp-append-version="true" />
}

<main>
    <section class="hero travel-hero">
      <div class="hero-overlay"></div>
      <a href="#venue-section" class="scroll-down-arrow" aria-label="Scroll down">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </section>

    <section class="venue-section" id="venue-section">
        <div class="section-inner reveal">
            <p class="section-label">@Localizer["Venue_Label"]</p>
            <h2>@Localizer["Venue_Title"]</h2>
            
            <div class="venue-grid">
                <div class="map-container">
                    <iframe class="map" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2934.502395568551!2d23.35165931221768!3d42.650694971047125!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40aa842512f4514d%3A0xd9919f2a033f7215!2z0KPQndCh0KE!5e0!3m2!1sbg!2sbg!4v1713437200000" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
                <div class="venue-info">
                    <div class="info-item">
                        <div class="icon-box"><img src="~/images/logos/location.png" alt=""></div>
                        <p><strong>@Localizer["Venue_Item_VenueTitle"]</strong><br>@Localizer["Venue_Item_VenueAddress"]</p>
                    </div>
                    <div class="info-item">
                        <div class="icon-box"><img src="~/images/logos/time.png" alt=""></div>
                        <p><strong>@Localizer["Venue_Item_HoursTitle"]</strong><br>@Html.Raw(Localizer["Venue_Item_HoursValue"].Value)</p>
                    </div>
                    <div class="info-item">
                        <div class="icon-box"><img src="~/images/logos/mail.png" alt=""></div>
                        <p><strong>@Localizer["Venue_Item_EmailTitle"]</strong><br>conference.education@unwe.bg</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="transport-section">
        <div class="section-inner reveal">
            <p class="section-label">@Localizer["Transport_Label"]</p>
            <h2>@Localizer["Transport_Title"]</h2>
            <div class="cards-grid">
                <div class="info-card">
                    <div class="card-icon"><img src="~/images/logos/plane.png" alt=""></div>
                    <h4>@Localizer["Transport_Air_Title"]</h4>
                    <p>@Localizer["Transport_Air_Desc"]</p>
                </div>
                <div class="info-card">
                    <div class="card-icon"><img src="~/images/logos/metro.png" alt=""></div>
                    <h4>@Localizer["Transport_Metro_Title"]</h4>
                    <p>@Localizer["Transport_Metro_Desc"]</p>
                </div>
                <div class="info-card">
                    <div class="card-icon"><img src="~/images/logos/transfer.png" alt=""></div>
                    <h4>@Localizer["Transport_Transfer_Title"]</h4>
                    <p>@Localizer["Transport_Transfer_Desc"]</p>
                </div>
            </div>
        </div>
    </section>

    @if (Model.Hotels != null && Model.Hotels.Any())
    {
        <section class="hotels-section" id="hotels">
            <div class="section-inner reveal">
                <p class="section-label">@Localizer["Hotels_Label"]</p>
                <h2>@Localizer["Hotels_Title"]</h2>
                <div class="cards-grid">
                    @foreach (var hotel in Model.Hotels)
                    {
                        var hotelName = isBg ? hotel.NameBg : hotel.NameEn;
                        var hotelDesc = isBg ? hotel.DescriptionBg : hotel.DescriptionEn;

                        <div class="info-card">
                            <h4>
                                @if (!string.IsNullOrEmpty(hotel.Url))
                                {
                                    <a href="@hotel.Url" target="_blank" style="color: inherit; text-decoration: none;">
                                        @hotelName <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.7em; margin-left: 5px;"></i>
                                    </a>
                                }
                                else
                                {
                                    @hotelName
                                }
                            </h4>
                            <p>@hotelDesc</p>
                        </div>
                    }
                </div>
                <p class="footer-note">@Localizer["Hotels_FooterNote"]</p>
            </div>
        </section>
    }
</main>