@page
@model ConferenceApp.Pages.ProfileModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@* ─────────────────────────────────────────────────────────────────────
   ConferenceApp · Blockchain Education 2026
   Author: Viktor Georgiev
   ───────────────────────────────────────────────────────────────────── *@

@{
    ViewData["Title"] = Localizer["page_title"].Value;

    // The lock is decided in the page model; the view only renders it.
    bool lockPartForm = Model.IsPartFormLocked;

    bool isOnline    = Model.Input.PartForm == "3";
    bool isConfirmed = Model.PaymentStatus == "Confirmed";

    // ── Display only: name, initials, address ────────────────────────
    var fullName = $"{Model.Input.FirstName} {Model.Input.LastName}".Trim();
    if (string.IsNullOrWhiteSpace(fullName)) fullName = User.Identity?.Name ?? "";
    // The initials are taken as characters rather than with LINQ .Take(1),
    // which returns IEnumerable<char> and makes string.Concat pick the
    // Concat(object, object) overload — printing the type name instead.
    var fn = (Model.Input.FirstName ?? "").Trim();
    var ln = (Model.Input.LastName ?? "").Trim();
    var initials = "";
    if (fn.Length > 0) initials += fn[0];
    if (ln.Length > 0) initials += ln[0];
    initials = initials.ToUpperInvariant();
    if (initials.Length == 0) initials = "—";
    var userEmail = User.Identity?.Name ?? "";

    // ── The summary in the right-hand column ─────────────────────────
    var partFormName = Model.Input.PartForm switch
    {
        "1" => Localizer["opt_lector"].Value,
        "2" => Localizer["opt_student"].Value,
        "3" => Localizer["opt_online"].Value,
        "4" => Localizer["opt_journalist"].Value,
        _   => "—"
    };

    // A one-line status for the summary, plus its tone: green for confirmed,
    // amber for waiting, red for something the participant has to do. The same
    // rules as the status panel further down; both read the same fields.
    string factStatus;
    string factStatusTone;
    if (Model.IsPaymentGroup)
    {
        if (isConfirmed)              { factStatus = Localizer["status_confirmed_label"].Value;      factStatusTone = "is-ok"; }
        else if (Model.IbanSubmitted) { factStatus = Localizer["status_iban_pending_label"].Value;   factStatusTone = "is-wait"; }
        else                          { factStatus = Localizer["status_unpaid_label"].Value;        factStatusTone = "is-alert"; }
    }
    else if (Model.IsVerifGroup)
    {
        if (!Model.HasVerifDocument || Model.VerificationStatus == "None")
                                                       { factStatus = Localizer["status_verif_needed_label"].Value;   factStatusTone = "is-alert"; }
        else if (Model.VerificationStatus == "Pending") { factStatus = Localizer["status_verif_pending_label"].Value;  factStatusTone = "is-wait"; }
        else if (Model.VerificationStatus == "Approved"){ factStatus = Localizer["status_confirmed_label"].Value;      factStatusTone = "is-ok"; }
        else                                           { factStatus = Localizer["status_verif_rejected_label"].Value; factStatusTone = "is-alert"; }
    }
    else { factStatus = "—"; factStatusTone = "is-empty"; }

    bool hasFile = !string.IsNullOrEmpty(Model.CurrentFileName);

    // The participation tiles are rendered from this one list, so that the
    // locked and unlocked branches cannot drift apart.
    var partOptions = new[]
    {
        new KeyValuePair<string, string>("1", Localizer["opt_lector"].Value),
        new KeyValuePair<string, string>("2", Localizer["opt_student"].Value),
        new KeyValuePair<string, string>("3", Localizer["opt_online"].Value),
        new KeyValuePair<string, string>("4", Localizer["opt_journalist"].Value)
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/profileStyle.css" asp-append-version="true">
}

<main class="pf-page">
    <div class="pf-split">

        @* ══ Left column — the form ═════════════════════════════════ *@
        <div class="pf-col">
            <div class="pf-form-wrap">

                <div class="pf-brand pf-brand--desktop">
                    <img src="~/images/logos/mainLogo.png" alt="">
                    <span class="pf-brand-rule"></span>
                    <span class="pf-eyebrow">@Localizer["prof_subtitle"]</span>
                </div>

                <div class="pf-head">
                    <h1 class="pf-title">@fullName</h1>
                    <span class="pf-title-rule"></span>
                    <p class="pf-desc">@Localizer["prof_desc"]</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="pf-saved" role="status">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                        @TempData["SuccessMessage"]
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="pf-alert"></div>

                <form class="pf-form" method="POST" id="profileForm" enctype="multipart/form-data" novalidate>

                    @* ══ 01 Personal details ══ *@
                    <div class="pf-section">
                        <div class="pf-section-head">
                            <b>01</b>
                            <span>@Localizer["sec_personal"]</span>
                        </div>

                        <div class="pf-grid-2">
                            <div class="pf-field">
                                <label asp-for="Input.FirstName">@Localizer["lbl_fname"]</label>
                                <input asp-for="Input.FirstName" type="text" id="Input_FirstName" required>
                                <span asp-validation-for="Input.FirstName" class="field-error"></span>
                            </div>
                            <div class="pf-field">
                                <label asp-for="Input.LastName">@Localizer["lbl_lname"]</label>
                                <input asp-for="Input.LastName" type="text" id="Input_LastName" required>
                                <span asp-validation-for="Input.LastName" class="field-error"></span>
                            </div>
                            <div class="pf-field">
                                <label asp-for="Input.Age">@Localizer["lbl_age"]</label>
                                <input asp-for="Input.Age" type="number" id="Input_Age" required>
                                <span asp-validation-for="Input.Age" class="field-error"></span>
                            </div>
                            <div class="pf-field">
                                <label asp-for="Input.Phone">@Localizer["lbl_phone"]</label>
                                <input asp-for="Input.Phone" type="tel" id="Input_Phone" required>
                                <span asp-validation-for="Input.Phone" class="field-error"></span>
                            </div>
                            <div class="pf-field">
                                <label asp-for="Input.AcademicTitle">@Localizer["lbl_title"]</label>
                                <input asp-for="Input.AcademicTitle" type="text" id="Input_AcademicTitle" required>
                                <span asp-validation-for="Input.AcademicTitle" class="field-error"></span>
                            </div>
                            <div class="pf-field">
                                <label asp-for="Input.Workplace">@Localizer["lbl_org"]</label>
                                <input asp-for="Input.Workplace" type="text" id="Input_Workplace" required>
                                <span asp-validation-for="Input.Workplace" class="field-error"></span>
                            </div>
                        </div>
                    </div>

                    @* ══ 02 Participation ══ *@
                    <div class="pf-section">
                        <div class="pf-section-head">
                            <b>02</b>
                            <span>@Localizer["sec_participation"]</span>
                        </div>

                        <div class="pf-field">
                            <span class="pf-label" id="pf-part-label">@Localizer["lbl_part"]</span>

                            @* Tiles rather than a dropdown. The radios keep
                               name="Input.PartForm", so the model binding is
                               unchanged. *@
                            @if (lockPartForm)
                            {
                                <div class="pf-choice is-locked" role="group" aria-labelledby="pf-part-label">
                                    @foreach (var opt in partOptions)
                                    {
                                        var isSel = Model.Input.PartForm == opt.Key;
                                        <span class="pf-choice-item @(isSel ? "is-selected" : "is-off")">@opt.Value</span>
                                    }
                                </div>
                                <input type="hidden" name="Input.PartForm" value="@Model.Input.PartForm" />

                                string lockedClass = Model.IsPaymentGroup && isConfirmed || Model.VerificationStatus == "Approved"
                                                     ? "locked-success" : "locked-warning";

                                <div class="locked-field-note @lockedClass">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                    </svg>
                                    <span>
                                        @if (Model.IsPaymentGroup && isConfirmed)
                                        {
                                            @Localizer["lbl_partform_locked_paid"]
                                        }
                                        else if (Model.VerificationStatus == "Approved")
                                        {
                                            @Localizer["lbl_partform_locked_approved"]
                                        }
                                        else
                                        {
                                            @Localizer["lbl_partform_locked_pending"]
                                        }
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="pf-choice" role="radiogroup" aria-labelledby="pf-part-label">
                                    @foreach (var opt in partOptions)
                                    {
                                        <label class="pf-choice-item">
                                            <input type="radio" name="Input.PartForm" value="@opt.Key"
                                                   checked="@(Model.Input.PartForm == opt.Key)" required>
                                            <span>@opt.Value</span>
                                        </label>
                                    }
                                </div>

                                @* The note shown when the form is changed, in place of
                                   a native confirm dialog. Which text appears
                                   depends on the choice:
                                     - a paying form (lecturer, online) → a note
                                       about the fee;
                                     - a verified form (student, journalist) → a
                                       note that a document will be needed.
                                   The script below switches the text and the
                                   visibility. *@
                                <p class="pf-inline-note" id="partform-notice" hidden>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
                                    <span id="partform-notice-text"
                                          data-paid="@Localizer["warn_type_change_to_paid"]"
                                          data-student="@Localizer["status_student_doc_msg"]"
                                          data-journalist="@Localizer["status_journalist_doc_msg"]"></span>
                                </p>
                            }
                            <span asp-validation-for="Input.PartForm" class="field-error"></span>
                        </div>

                        @* A bordered row rather than a loose checkbox: this consent
                           is a property of the participation, not an aside. *@
                        <label class="pf-toggle-row">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                                <path d="M2 12h20"></path>
                            </svg>
                            <span>@Localizer["lbl_foreigner"]</span>
                            <input asp-for="Input.IsForeigner" type="checkbox">
                        </label>

                        <label class="pf-consent">
                            <input asp-for="Input.WantsMarketing" type="checkbox">
                            <span>@Localizer["lbl_marketing"]</span>
                        </label>
                    </div>

                    @* ══ 03 Paper ══ *@
                    <div class="pf-section">
                        <div class="pf-section-head">
                            <b>03</b>
                            <span>@Localizer["sec_paper"]</span>
                        </div>

                        @if (hasFile)
                        {
                            <div class="pf-file">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
                                    <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
                                </svg>
                                <span class="pf-file-name">
                                    <b>@Localizer["lbl_current_file"]</b>
                                    <span>@Model.CurrentFileName</span>
                                </span>
                                <a href="?handler=Download" class="pf-file-action">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"></path><path d="m7 10 5 5 5-5"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path></svg>
                                    <span>@Localizer["lbl_download"]</span>
                                </a>
                            </div>
                        }

                        <div>
                            <div class="pf-drop-head">
                                <span class="pf-label">@Localizer["lbl_update_file"]</span>
                                <span>@Localizer["file_hint"]</span>
                            </div>

                            @* The label wraps the real input; the id and class are
                               unchanged, because the script and the server-side
                               validation both look them up by name. *@
                            <label class="pf-drop" id="pf-drop">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 13v8"></path>
                                    <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
                                    <path d="m8 17 4-4 4 4"></path>
                                </svg>
                                <span class="pf-drop-label" id="pf-drop-label"
                                      data-idle="@Localizer["file_drop_idle"]"
                                      data-active="@Localizer["file_drop_active"]">@Localizer["file_drop_idle"]</span>
                                <span class="pf-file-action">@Localizer["btn_choose_file"]</span>
                                <input asp-for="Input.UploadedFile" type="file" accept=".pdf,.doc,.docx"
                                       id="Input_UploadedFile" class="file-input">
                            </label>

                            @* Clearing the choice sits outside the <label>, or
                               clicking it would reopen the file dialog. Shown only
                               when a file is selected. *@
                            <button type="button" class="pf-drop-clear" id="pf-drop-clear" hidden>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                                <span>@Localizer["upload_remove"]</span>
                            </button>

                            <span class="field-error" id="pf-file-error" hidden></span>
                            <span asp-validation-for="Input.UploadedFile" class="field-error"></span>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="pf-submit">
                        <span>@Localizer["btn_save"]</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                    </button>
                </form>

            </div>
        </div>

        @* ══ Right column ═══════════════════════════════════════════
           On a phone the wrapper becomes display: contents and the two blocks
           become rows of their own — the upper one before the form, the lower
           one after it. That is why there is no duplicated markup here. *@
        <div class="pf-aside-col">

            <div class="pf-aside-top">
                <div class="pf-stack">

                    <div class="pf-brand pf-brand--mobile">
                        <img src="~/images/logos/mainLogo.png" alt="">
                        <span class="pf-brand-rule"></span>
                        <span class="pf-eyebrow">@Localizer["prof_subtitle"]</span>
                    </div>

                    <div class="pf-identity">
                        <span class="pf-avatar" aria-hidden="true">@initials</span>
                        <span class="pf-identity-body">
                            <span class="pf-identity-name">@fullName</span>
                            <span class="pf-identity-mail">@userEmail</span>
                        </span>
                    </div>

                    @* ══════════════════════════════════════════════════════════
                       THE STATUS PANEL — every case, spelled out
                       The panel is the only place that tells a participant what
                       is still expected of them, so each branch ends in one
                       clear instruction rather than in a status word.
                    ══════════════════════════════════════════════════════════ *@
                    @{
                        @* ── CASE 1: the paying forms (lecturer = 1, online = 3) ── *@
                        if (Model.IsPaymentGroup)
                        {
                            if (isConfirmed)
                            {
                                @* Paid and confirmed *@
                                <div class="status-panel status-confirmed">
                                    <div class="status-panel-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                        <span>@Localizer["status_confirmed_label"]</span>
                                    </div>
                                    <div class="status-panel-body">
                                        <div class="status-panel-msg">@Localizer["status_confirmed_msg"]</div>
                                    </div>
                                </div>
                            }
                            else if (Model.IbanSubmitted)
                            {
                                @* Bank transfer declared, waiting for an
                                   administrator to confirm it *@
                                <div class="status-panel status-pending status-iban">
                                    <div class="status-panel-icon">
                                        <span class="status-panel-dot" aria-hidden="true"></span>
                                        <span>@Localizer["status_iban_pending_label"]</span>
                                    </div>
                                    <div class="status-panel-body">
                                        <div class="status-panel-msg">@Localizer["status_iban_pending_msg"]</div>
                                        @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
                                        {
                                            <div class="status-ref">
                                                @Localizer["status_ref_label"]: <strong>@Model.ReferenceNumber</strong>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                @* Not paid yet *@
                                <div class="status-panel status-warning">
                                    <div class="status-panel-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                        <span>@Localizer["status_unpaid_label"]</span>
                                    </div>
                                    <div class="status-panel-body">
                                        <div class="status-panel-msg">@Localizer["status_unpaid_msg"]</div>
                                        @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
                                        {
                                            <div class="status-ref">
                                                @Localizer["status_ref_label"]: <strong>@Model.ReferenceNumber</strong>
                                            </div>
                                        }
                                        <div class="status-panel-actions">
                                            <a asp-page="/Payment" asp-route-slug="@Model.PaymentSlug" class="status-action-btn">
                                                <span>@Localizer["status_action_pay"]</span>
                                                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                                            </a>
                                            <a asp-page="/Attend" class="status-action-btn status-action-secondary">@Localizer["status_action_see_options"]</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        @* ── CASE 2: the verified forms (student = 2, journalist = 4) ── *@
                        else if (Model.IsVerifGroup)
                        {
                            if (!Model.HasVerifDocument || Model.VerificationStatus == "None")
                            {
                                @* No documents uploaded — or they were cleared by an
                                   administrator *@
                                <div class="status-panel status-warning">
                                    <div class="status-panel-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                        <span>@Localizer["status_verif_needed_label"]</span>
                                    </div>
                                    <div class="status-panel-body">
                                        <div class="status-panel-msg">
                                            @(Model.Input.PartForm == "2"
                                                ? Localizer["status_student_doc_msg"].Value
                                                : Localizer["status_journalist_doc_msg"].Value)
                                        </div>
                                        <div class="status-panel-actions">
                                            <a href="/SubmitDocuments" class="status-action-btn">
                                                <span>@Localizer["status_action_submit_doc"]</span>
                                                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @* Documents uploaded: show where the review stands *@
                                string verifClass = Model.VerificationStatus switch
                                {
                                    "Approved" => "status-confirmed",
                                    "Rejected" => "status-rejected",
                                    _          => "status-pending"
                                };

                                <div class="status-panel @verifClass">
                                    <div class="status-panel-icon">
                                        @if (Model.VerificationStatus == "Approved")
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                            <span>@Localizer["status_confirmed_label"]</span>
                                        }
                                        else if (Model.VerificationStatus == "Rejected")
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                            <span>@Localizer["status_verif_rejected_label"]</span>
                                        }
                                        else
                                        {
                                            <span class="status-panel-dot" aria-hidden="true"></span>
                                            <span>@Localizer["status_verif_pending_label"]</span>
                                        }
                                    </div>
                                    <div class="status-panel-body">

                                        @if (Model.VerificationStatus == "Pending")
                                        {
                                            @* Under review *@
                                            <div class="status-panel-msg">@Localizer["status_verif_pending_msg"]</div>
                                        }
                                        else if (Model.VerificationStatus == "Approved")
                                        {
                                            @* Approved *@
                                            <div class="status-panel-msg">@Localizer["status_verif_approved_msg"]</div>
                                        }
                                        else if (Model.VerificationStatus == "Rejected")
                                        {
                                            @* Rejected *@
                                            <div class="status-panel-msg">@Localizer["status_verif_rejected_msg"]</div>

                                            @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                                            {
                                                <details class="status-reason">
                                                    <summary>
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                                                        @Localizer["status_rejection_reason_label"]
                                                    </summary>
                                                    <p>@Model.RejectionReason</p>
                                                </details>
                                            }

                                            <div class="status-panel-actions">
                                                <a href="/SubmitDocuments" class="status-action-btn">
                                                    <span>@Localizer["status_action_resubmit"]</span>
                                                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                                                </a>
                                            </div>
                                        }

                                    </div>
                                </div>
                            }
                        }
                    }

                </div>
            </div>

            <div class="pf-aside-bottom">
                <div class="pf-stack">

                    <div class="pf-facts">
                        <div>
                            <b>@Localizer["fact_part"]</b>
                            <span>@partFormName</span>
                        </div>
                        <div>
                            <b>@Localizer["fact_status"]</b>
                            <span class="@factStatusTone">@factStatus</span>
                        </div>
                        <div>
                            <b>@Localizer["fact_ref"]</b>
                            @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
                            {
                                <span class="is-ref">@Model.ReferenceNumber</span>
                            }
                            else
                            {
                                <span class="is-empty">—</span>
                            }
                        </div>
                        <div>
                            <b>@Localizer["fact_paper"]</b>
                            @if (hasFile)
                            {
                                <span>@Model.CurrentFileName</span>
                            }
                            else
                            {
                                <span class="is-empty">@Localizer["fact_no_paper"]</span>
                            }
                        </div>
                    </div>

                    @* For online participants: the link arrives by mail, so the
                       panel says so rather than offering a button. *@
                    @if (isOnline)
                    {
                        <div class="status-panel status-info">
                            <div class="status-panel-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                            </div>
                            <div class="status-panel-body">
                                <div class="status-panel-msg">@Localizer["status_online_link_note"]</div>
                            </div>
                        </div>
                    }

                    <div class="pf-logout">
                        <form method="post" asp-page="/Logout">
                            <button type="submit">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>
                                @Localizer["btn_logout"]
                            </button>
                        </form>
                    </div>

                </div>
            </div>

        </div>

    </div>
</main>

@section Scripts {
    @* The validation messages come from resx, so that they follow the language
       of the page. They are serialized with JsonSerializer: embedding them by
       hand in single quotes broke on an apostrophe in the text ("doesn't"), the
       script threw, and validation.js fell back to its own built-in English. *@
    @{
        var vMessages = new Dictionary<string, string>
        {
            ["first_name_required"] = Localizer["v_first_name_required"].Value,
            ["first_name_short"]    = Localizer["v_first_name_short"].Value,
            ["first_name_latin"]    = Localizer["v_first_name_latin"].Value,
            ["last_name_required"]  = Localizer["v_last_name_required"].Value,
            ["last_name_short"]     = Localizer["v_last_name_short"].Value,
            ["last_name_latin"]     = Localizer["v_last_name_latin"].Value,
            ["age_required"]        = Localizer["v_age_required"].Value,
            ["age_digits"]          = Localizer["v_age_digits"].Value,
            ["age_range"]           = Localizer["v_age_range"].Value,
            ["title_required"]      = Localizer["v_title_required"].Value,
            ["email_required"]      = Localizer["v_email_required"].Value,
            ["email_invalid"]       = Localizer["v_email_invalid"].Value,
            ["email_taken"]         = Localizer["v_email_taken"].Value,
            ["phone_required"]      = Localizer["v_phone_required"].Value,
            ["phone_invalid"]       = Localizer["v_phone_invalid"].Value,
            ["workplace_required"]  = Localizer["v_workplace_required"].Value,
            ["partform_required"]   = Localizer["v_partform_required"].Value,
            ["gdpr_required"]       = Localizer["v_gdpr_required"].Value,
            ["file_type"]           = Localizer["Error_InvalidFileType"].Value,
            ["file_too_large"]      = Localizer["Error_FileTooLarge"].Value
        };
    }
    <script>
        window.ValidationMessages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vMessages));
    </script>

    <script>
        // The note shown when the participation form is changed.
        // validation.js already handles #profileForm; what is here is only this
        // one behaviour, which is not validation.
        (function () {
            var tiles = document.querySelectorAll('input[type="radio"][name="Input.PartForm"]');
            if (!tiles.length) return;

            var original = '@Model.Input.PartForm';
            var paid   = { '1': true, '3': true };   // лектор и онлайн се плащат
            var verif  = { '2': true, '4': true };   // студент и журналист качват документ
            var notice = document.getElementById('partform-notice');
            var noticeText = document.getElementById('partform-notice-text');

            // This used to be a window.confirm(...) — a native dialog to be
            // dismissed on every switch. It interrupted the work, looked like an
            // error warning, and did not fit the design. The change is not
            // irreversible anyway: nothing is stored until Save is pressed. So
            // what appears now is a quiet note under the tiles.
            function refreshNotice() {
                if (!notice || !noticeText) return;

                var picked = document.querySelector('input[name="Input.PartForm"]:checked');
                if (!picked || picked.value === original) { notice.hidden = true; return; }

                var v = picked.value;
                if (paid[v]) {
                    noticeText.textContent = noticeText.dataset.paid;
                    notice.classList.remove('is-info');
                    notice.hidden = false;
                } else if (verif[v]) {
                    // The note used to appear for the paying forms ONLY, so a
                    // student or a journalist was never told that a document
                    // would be required.
                    noticeText.textContent = v === '4'
                        ? noticeText.dataset.journalist
                        : noticeText.dataset.student;
                    notice.classList.add('is-info');
                    notice.hidden = false;
                } else {
                    notice.hidden = true;
                }
            }

            tiles.forEach(function (radio) {
                radio.addEventListener('change', refreshNotice);
            });

            refreshNotice();
        })();
    </script>

    <script>
        // The paper drop zone: drag and drop, and the name of the chosen file.
        // Purely visual — the input itself is untouched, so the form works the
        // same with the script disabled.
        (function () {
            var drop  = document.getElementById('pf-drop');
            var input = document.getElementById('Input_UploadedFile');
            var label = document.getElementById('pf-drop-label');
            if (!drop || !input || !label) return;

            var idle = label.dataset.idle || label.textContent;

            // The same rules as in registration: 10 MB, PDF/DOC/DOCX only.
            // Both are checked again on the server (Profile.cshtml.cs); this is
            // for the message, not for the limit.
            var MAX_FILE_BYTES = 10 * 1024 * 1024;
            var ALLOWED_EXT    = ['pdf', 'doc', 'docx'];
            var clearBtn       = document.getElementById('pf-drop-clear');
            var errEl          = document.getElementById('pf-file-error');
            var FILE_MSG = {
                type:     '@Html.Raw(Localizer["Error_InvalidFileType"].Value)',
                tooLarge: '@Html.Raw(Localizer["Error_FileTooLarge"].Value)'
            };

            function showError(msg) {
                if (!errEl) return;
                if (msg) { errEl.textContent = msg; errEl.hidden = false; }
                else     { errEl.textContent = '';  errEl.hidden = true;  }
            }

            function show(name) {
                label.textContent = name || idle;
                drop.classList.toggle('has-file', !!name);
                if (clearBtn) clearBtn.hidden = !name;
            }

            function clearFile() {
                input.value = '';
                show('');
                showError('');
            }

            function checkFile() {
                if (!input.files || !input.files.length) { show(''); showError(''); return true; }

                var f   = input.files[0];
                var ext = (f.name.split('.').pop() || '').toLowerCase();

                if (ALLOWED_EXT.indexOf(ext) === -1) {
                    clearFile();
                    showError(FILE_MSG.type);
                    return false;
                }
                if (f.size > MAX_FILE_BYTES) {
                    var mb = (f.size / 1024 / 1024).toFixed(1);
                    clearFile();
                    showError(FILE_MSG.tooLarge.replace('{0}', mb));
                    return false;
                }

                show(f.name);
                showError('');
                return true;
            }

            if (clearBtn) {
                clearBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    clearFile();
                });
            }

            input.addEventListener('change', checkFile);

            ['dragenter', 'dragover'].forEach(function (t) {
                drop.addEventListener(t, function (e) {
                    e.preventDefault();
                    drop.classList.add('is-dragging');
                    label.textContent = label.dataset.active || idle;
                });
            });

            ['dragleave', 'dragend'].forEach(function (t) {
                drop.addEventListener(t, function () {
                    drop.classList.remove('is-dragging');
                    show(input.files && input.files[0] ? input.files[0].name : '');
                });
            });

            drop.addEventListener('drop', function (e) {
                e.preventDefault();
                drop.classList.remove('is-dragging');
                if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
                    input.files = e.dataTransfer.files;
                    input.dispatchEvent(new Event('change', { bubbles: true }));
                }
            });

            checkFile();
        })();
    </script>
    <script src="~/js/validation.js" asp-append-version="true"></script>
}
