@page "/Admin"
@using ConferenceApp.Models
@using ConferenceApp.Data
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ConferenceApp.Areas.Admin.Pages.IndexModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Panel";
}

@section Styles {
    <link rel="stylesheet" href="~/css/adminPanel.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css">
    @* Инлайн <style> блокът, който стоеше тук, е премахнат — всяко правило
       от него (status-*, method-*, iban-alert, field-error-msg, verif-type-*,
       section-divider, form-section-label, #rejectReasonText, image-upload-preview,
       modal-validation-banner) вече живее в adminPanel.css със същите имена. *@
}

  <main>
    <div class="admin-wrapper">
      <div class="admin-container">

        <div class="admin-header">
          <div class="admin-header-text">
            <h2>Administration Dashboard</h2>
            <p>Manage registrations, payments, verifications and website content.</p>
          </div>
          <div class="admin-header-meta">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="admin-header-badge">@User.Identity.Name</div>
            }
            <div class="admin-header-badge"><span class="dot"></span>System Online</div>
            <div class="admin-header-badge">@DateTime.Now.ToString("dd MMM yyyy, HH:mm")</div>
          </div>
        </div>

        <div class="admin-body">
        <nav class="admin-nav admin-sidebar" aria-label="Admin sections">
          <span class="admin-sidebar-label">Operations</span>
          <button type="button" class="admin-tab" data-target="tab-registrations">Registrations</button>
          <button type="button" class="admin-tab" data-target="tab-payments">Payments</button>
          <button type="button" class="admin-tab" data-target="tab-verifications">
            Verifications
            @if (Model.PendingVerifCount > 0)
            {
                <span class="tab-badge">@Model.PendingVerifCount</span>
            }
          </button>
          <button type="button" class="admin-tab" data-target="tab-crypto">Crypto Orders</button>
          <button type="button" class="admin-tab" data-target="tab-audit">Audit Logs</button>
          <button type="button" class="admin-tab" data-target="tab-health">Health Check</button>
          <span class="admin-sidebar-label">Content</span>
          <button type="button" class="admin-tab" data-target="tab-conference">Conference</button>
          <button type="button" class="admin-tab" data-target="tab-icbi">About ICBI</button>
          <button type="button" class="admin-tab" data-target="tab-lecturers">Lecturers</button>
          <button type="button" class="admin-tab" data-target="tab-schedule">Schedule</button>
          <button type="button" class="admin-tab" data-target="tab-attend">Attend</button>
          <button type="button" class="admin-tab" data-target="tab-travel">Travel</button>
          <button type="button" class="admin-tab" data-target="tab-faq">FAQ</button>
          <button type="button" class="admin-tab" data-target="tab-privacy">Privacy Policy</button>
          <button type="button" class="admin-tab" data-target="tab-terms">Terms of Use</button>
          <button type="button" class="admin-tab" data-target="tab-cookies">Cookie Notice</button>
          <span class="admin-sidebar-label">Site</span>
          <button type="button" class="admin-tab" data-target="tab-settings">Site Settings</button>
          <button type="button" class="admin-tab" data-target="tab-emails">Email Notifications</button>
          <button type="button" class="admin-tab" data-target="tab-paycontrol">Payment Control</button>
          <button type="button" class="admin-tab" onclick="window.location.href='/Admin/SendInvitations'">Send Invitations</button>
          <button type="button" class="admin-tab" onclick="window.location.href='/Admin/BugReports'">
            Bug Reports
            @if (Model.OpenBugReportCount > 0)
            {
                <span class="tab-badge">@Model.OpenBugReportCount</span>
            }
          </button>
        </nav>

        <div class="admin-main">

        
        <div id="tab-registrations" class="admin-section">
          <div class="admin-panel-card">
            <h3>
              <span>Submitted Registrations</span>
              <div class="header-actions">
                <a href="?handler=ExportAuditLogs" class="action-btn btn-audit" style="text-decoration:none;">Download Audit Logs</a>
                <div class="dropdown">
                  <button type="button" class="action-btn btn-download">Download CSV &#9662;</button>
                  <div class="dropdown-content">
                    <a href="?handler=ExportRegistrations&type=all">All Registrations</a>
                    <a href="?handler=ExportRegistrations&type=confirmed">Confirmed Only</a>
                    <a href="?handler=ExportRegistrations&type=pending">Pending Only</a>
                    <a href="?handler=ExportRegistrations&type=cancelled">Cancelled Only</a>
                  </div>
                </div>
              </div>
            </h3>

            
            <div class="dashboard-stats">
              <div class="stat-card s-slate">
                <div class="stat-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx='9' cy='8' r='3'></circle><path d='M2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v1'></path><circle cx='17' cy='8' r='2.5'></circle><path d='M17 13.5c2.5.3 4.5 2.4 4.5 5V21'></path></svg></div>
                <div class="stat-info">
                  <span class="stat-title">Total Users</span>
                  <strong class="stat-value">@Model.TotalUsers</strong>
                </div>
              </div>
              <div class="stat-card s-green">
                <div class="stat-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx='12' cy='12' r='9'></circle><polyline points='8 12.5 11 15.5 16 9'></polyline></svg></div>
                <div class="stat-info">
                  <span class="stat-title">Confirmed</span>
                  <strong class="stat-value" style="color:var(--c-green);">@Model.ConfirmedPaymentsCount</strong>
                </div>
              </div>
              <div class="stat-card s-red">
                <div class="stat-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
                <div class="stat-info">
                  <span class="stat-title">Pending</span>
                  <strong class="stat-value text-red">@Model.PendingPaymentsCount</strong>
                </div>
              </div>
              <div class="stat-card s-amber">
                <div class="stat-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1='3' y1='22' x2='21' y2='22'></line><line x1='6' y1='18' x2='6' y2='11'></line><line x1='10' y1='18' x2='10' y2='11'></line><line x1='14' y1='18' x2='14' y2='11'></line><line x1='18' y1='18' x2='18' y2='11'></line><polygon points='12 2 21 8 3 8'></polygon></svg></div>
                <div class="stat-info">
                  <span class="stat-title">IBAN Awaiting</span>
                  <strong class="stat-value text-blue">@Model.IbanPendingCount</strong>
                </div>
              </div>
              <div class="stat-card s-amber">
                <div class="stat-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d='M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2'></path><rect x='9' y='3' width='6' height='4' rx='1'></rect></svg></div>
                <div class="stat-info">
                  <span class="stat-title">Pending Verif.</span>
                  <strong class="stat-value text-blue">@Model.PendingVerifCount</strong>
                </div>
              </div>
              <div class="stat-card s-purple">
                <div class="stat-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d='M7 5h7a3.5 3.5 0 0 1 0 7H7z'></path><path d='M7 12h7.5a3.5 3.5 0 0 1 0 7H7z'></path><line x1='9.5' y1='3' x2='9.5' y2='21'></line></svg></div>
                <div class="stat-info">
                  <span class="stat-title">Crypto Orders</span>
                  <strong class="stat-value">@Model.TotalCryptoOrders</strong>
                </div>
              </div>
              <div class="stat-card">
                <div class="stat-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx='12' cy='12' r='9'></circle><polyline points='12 7 12 12 15 14'></polyline></svg></div>
                <div class="stat-info">
                  <span class="stat-title">Last Cleanup</span>
                  <strong class="stat-value text-small">@Model.LastCleanupTime</strong>
                </div>
              </div>
              <div class="stat-card">
                <div class="stat-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.3"/></svg></div>
                <div class="stat-info">
                  <span class="stat-title">Next Cleanup</span>
                  <strong class="stat-value text-blue text-small">@Model.NextCleanupTime</strong>
                </div>
              </div>
            </div>

            <div class="admin-filters">
              <input type="text" id="regSearchInput" placeholder="Search by name, email or organization..." class="filter-input">
              <select id="regPaymentFilter" class="filter-select">
                <option value="all">All Payment Statuses</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Pending">Pending</option>
                <option value="Cancelled">Cancelled</option>
              </select>
              <select id="regTypeFilter" class="filter-select">
                <option value="all">All Types</option>
                <option value="1">Lector / Academic</option>
                <option value="2">Student / PhD</option>
                <option value="3">Online Participant</option>
                <option value="4">Journalist / Media</option>
              </select>
              <select id="regAccountFilter" class="filter-select">
                <option value="all">All Account Statuses</option>
                <option value="Verified">Email Verified</option>
                <option value="Not Verified">Not Verified</option>
              </select>
            </div>

            <div class="table-scroll">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Contact</th>
                  <th>Type</th>
                  <th>Payment</th>
                  <th>Verification</th>
                  <th>File</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="registrationsTableBody">
                @if (!Model.RegisteredUsers.Any())
                {
                    <tr><td colspan="7" class="empty-state"><span class="empty-state-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path><rect x="9" y="3" width="6" height="4" rx="1"></rect></svg></span>No registrations yet.</td></tr>
                }
                else
                {
                    @foreach (var u in Model.RegisteredUsers)
                    {
                        var payStat = string.IsNullOrEmpty(u.PaymentStatus) ? "Pending" : u.PaymentStatus;
                        var accStat = u.EmailConfirmed ? "Verified" : "Not Verified";
                        var searchTxt = $"{u.FirstName} {u.LastName} {u.Workplace} {u.Email} {u.ReferenceNumber}".ToLower();
                        var typeDisplay = ConferenceApp.Areas.Admin.Pages.IndexModel.FormatPartForm(u.PartForm);
                        var verifStat = u.VerificationStatus ?? "None";
                        var payBadgeClass = payStat == "Confirmed" ? "status-confirmed" : payStat == "Cancelled" ? "status-cancelled" : "status-pending";
                        var verifBadgeClass = verifStat == "Approved" ? "status-approved" : verifStat == "Rejected" ? "status-rejected" : verifStat == "Pending" ? "status-pending" : "status-none";
                        <tr class="reg-data-row"
                            data-search="@searchTxt"
                            data-payment="@payStat"
                            data-type="@u.PartForm"
                            data-account="@accStat">
                          <td>
                            <strong>@u.FirstName @u.LastName</strong>
                            <br><span style="color:var(--c-text-muted);font-size:11px;">@u.AcademicTitle — Age @u.Age</span>
                            <br><span style="color:var(--c-text-faint);font-size:10px;font-family:monospace;">@u.ReferenceNumber</span>
                          </td>
                          <td>
                            <span style="font-size:13px;">@u.Email</span>
                            <br><span style="color:var(--c-text-secondary);font-size:12px;">@u.PhoneNumber</span>
                          </td>
                          <td><span class="category-badge">@typeDisplay</span></td>
                          <td>
                            <span class="status-badge @payBadgeClass">@payStat</span>
                            @if (!string.IsNullOrEmpty(u.PaymentMethod))
                            {
                                var mClass = u.PaymentMethod.ToLower() switch { "card" => "method-card", "crypto" => "method-crypto", "iban" => "method-iban", "manual" => "method-manual", "subsidised" => "method-subsidised", _ => "method-manual" };
                                <br><span class="method-badge @mClass" style="margin-top:4px;">@u.PaymentMethod</span>
                            }
                          </td>
                          <td>
                            @if (u.PartForm == "2" || u.PartForm == "4")
                            {
                                <span class="status-badge @verifBadgeClass">@verifStat</span>
                            }
                            else { <span style="color:var(--c-border-strong);font-size:12px;">N/A</span> }
                          </td>
                          <td>
                            @if (!string.IsNullOrEmpty(u.PaperFilePath))
                            {
                                <a href="?handler=DownloadPaper&userId=@u.Id" class="action-btn btn-download" style="padding:4px 8px;font-size:11px;">Paper</a>
                            }
                            else { <span style="color:var(--c-border-strong);font-size:12px;">None</span> }
                          </td>
                          <td>
                            <button type="button" class="action-btn btn-view view-reg-btn"
                                    data-modal-target="view-registration-modal"
                                    data-id="@u.Id"
                                    data-fname="@u.FirstName" data-lname="@u.LastName"
                                    data-age="@u.Age" data-email="@u.Email" data-phone="@u.PhoneNumber"
                                    data-title="@u.AcademicTitle" data-org="@u.Workplace"
                                    data-part="@typeDisplay" data-partform="@u.PartForm"
                                    data-foreign="@(u.IsForeigner ? "Yes" : "No")"
                                    data-confirmed="@accStat" data-payment="@payStat"
                                    data-paymethod="@(u.PaymentMethod ?? "")"
                                    data-refnum="@u.ReferenceNumber"
                                    data-verifstatus="@verifStat"
                                    data-verifinstitution="@(u.VerificationInstitution ?? "")"
                                    data-verifspecialty="@(u.VerificationSpecialty ?? "")"
                                    data-verifyear="@(u.VerificationYear ?? "")"
                                    data-verifstudentid="@(u.VerificationStudentId ?? "")"
                                    data-paidat="@(u.PaidAt.HasValue ? ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(u.PaidAt.Value).ToString("dd.MM.yyyy HH:mm") : "—")"
                                    data-created="@(ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(u.CreatedAt).ToString("dd MMM yyyy, HH:mm"))"
                                    data-gdpr='@(u.HasAcceptedGdpr ? $"Yes ({ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(u.GdprConsentDate ?? DateTime.UtcNow).ToString("dd MMM yyyy")})" : "No")'
                                    data-marketing="@(u.WantsMarketing ? "Yes" : "No")"
                                    data-publishconsent="@(u.ConsentToPublishPaper ? "Yes" : "No")"
                                    data-filename="@(string.IsNullOrEmpty(u.PaperFilePath) ? "" : System.IO.Path.GetFileName(u.PaperFilePath))"
                                    data-hasverifDoc="@(!string.IsNullOrEmpty(u.VerificationDocumentPath) ? "true" : "false")">View</button>

                            <button type="button" class="action-btn btn-edit edit-reg-btn"
                                    data-modal-target="edit-registration-modal"
                                    data-id="@u.Id" data-fname="@u.FirstName" data-lname="@u.LastName"
                                    data-age="@u.Age" data-phone="@u.PhoneNumber"
                                    data-title="@u.AcademicTitle" data-org="@u.Workplace"
                                    data-part="@u.PartForm" data-foreign="@(u.IsForeigner ? "true" : "false")"
                                    data-confirmed="@accStat" data-payment="@payStat"
                                    data-verifstatus="@verifStat"
                                    data-filename="@(string.IsNullOrEmpty(u.PaperFilePath) ? "" : System.IO.Path.GetFileName(u.PaperFilePath))">Edit</button>

                            <button type="button" class="action-btn btn-delete delete-reg-btn"
                                    data-modal-target="delete-modal"
                                    data-delete-name="@u.FirstName @u.LastName"
                                    data-id="@u.Id">Delete</button>
                          </td>
                        </tr>
                    }
                }
              </tbody>
            </table>
            </div>
          </div>
        </div>

        
        <div id="tab-payments" class="admin-section">

          @if (Model.IbanPending.Any())
          {
              <div class="admin-panel-card" style="border-left:4px solid var(--c-amber-vivid);">
                <h3>
                  <span><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg> IBAN Transfers Awaiting Confirmation</span>
                  <span style="background:var(--c-amber-light);color:var(--c-amber);border:1px solid var(--c-amber-border);padding:4px 12px;border-radius:4px;font-size:13px;font-weight:bold;">@Model.IbanPending.Count pending</span>
                </h3>
                <p style="color:var(--c-amber);font-size:14px;margin-bottom:16px;">The following users submitted IBAN transfer notifications. Verify the bank transfer and confirm manually.</p>
                <div class="table-scroll">
                <table class="admin-table">
                  <thead>
                    <tr><th>User</th><th>Reference #</th><th>Type</th><th>Submitted At</th><th>Actions</th></tr>
                  </thead>
                  <tbody>
                    @foreach (var u in Model.IbanPending)
                    {
                        var submitted = u.IbanTransferSubmittedAt.HasValue
                            ? ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(u.IbanTransferSubmittedAt.Value).ToString("dd.MM.yyyy HH:mm")
                            : "—";
                        <tr>
                          <td><strong>@u.FirstName @u.LastName</strong><br><small style="color:var(--c-text-secondary);">@u.Email</small></td>
                          <td><code style="background:var(--c-surface-soft);padding:2px 6px;border-radius:4px;font-size:12px;">@u.ReferenceNumber</code></td>
                          <td>@ConferenceApp.Areas.Admin.Pages.IndexModel.FormatPartForm(u.PartForm)</td>
                          <td style="color:var(--c-amber);font-weight:bold;font-size:13px;">@submitted</td>
                          <td>
                            <button type="button" class="action-btn btn-view confirm-payment-btn"
                                    data-userid="@u.Id" data-name="@u.FirstName @u.LastName"
                                    data-ref="@u.ReferenceNumber" data-method="IBAN"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points='20 6 9 17 4 12'></polyline></svg> Confirm IBAN</button>
                            <button type="button" class="action-btn btn-delete cancel-payment-btn"
                                    data-userid="@u.Id" data-name="@u.FirstName @u.LastName"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1='18' y1='6' x2='6' y2='18'></line><line x1='6' y1='6' x2='18' y2='18'></line></svg> Cancel</button>
                          </td>
                        </tr>
                    }
                  </tbody>
                </table>
                </div>
              </div>
          }

          <div class="admin-panel-card">
            <h3>
              <span>All Payments</span>
              <div class="header-actions">
                <a href="?handler=ExportRegistrations&type=confirmed" class="action-btn btn-download" style="text-decoration:none;font-size:13px;">Export Confirmed CSV</a>
              </div>
            </h3>
            <div class="admin-filters">
              <input type="text" id="paySearchInput" placeholder="Search by name, email or reference number..." class="filter-input">
              <select id="payStatusFilter" class="filter-select">
                <option value="all">All Statuses</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Pending">Pending</option>
                <option value="Cancelled">Cancelled</option>
              </select>
              <select id="payMethodFilter" class="filter-select">
                <option value="all">All Methods</option>
                <option value="Card">Card (Stripe)</option>
                <option value="Crypto">Crypto (Go28)</option>
                <option value="IBAN">IBAN Transfer</option>
                <option value="Manual">Manual</option>
                <option value="Subsidised">Subsidised</option>
              </select>
            </div>
            <div class="table-scroll">
            <table class="admin-table">
              <thead>
                <tr><th>User</th><th>Reference #</th><th>Type</th><th>Status</th><th>Method</th><th>Paid At</th><th>IBAN Submitted</th><th>Actions</th></tr>
              </thead>
              <tbody id="paymentsTableBody">
                @foreach (var u in Model.RegisteredUsers)
                {
                    var payStat = u.PaymentStatus ?? "Pending";
                    var payMethod = u.PaymentMethod ?? "";
                    var paidAt = u.PaidAt.HasValue ? ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(u.PaidAt.Value).ToString("dd.MM.yyyy HH:mm") : "—";
                    var ibanAt = u.IbanTransferSubmittedAt.HasValue ? ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(u.IbanTransferSubmittedAt.Value).ToString("dd.MM.yyyy HH:mm") : "—";
                    var payBadgeClass = payStat == "Confirmed" ? "status-confirmed" : payStat == "Cancelled" ? "status-cancelled" : "status-pending";
                    var mClass = payMethod.ToLower() switch { "card" => "method-card", "crypto" => "method-crypto", "iban" => "method-iban", "manual" => "method-manual", "subsidised" => "method-subsidised", _ => "" };
                    <tr class="pay-data-row"
                        data-search="@($"{u.FirstName} {u.LastName} {u.Email} {u.ReferenceNumber}".ToLower())"
                        data-status="@payStat"
                        data-method="@payMethod">
                      <td><strong>@u.FirstName @u.LastName</strong><br><small style="color:var(--c-text-secondary);">@u.Email</small></td>
                      <td><code style="background:var(--c-surface-soft);padding:2px 6px;border-radius:4px;font-size:11px;">@u.ReferenceNumber</code></td>
                      <td style="font-size:12px;">@ConferenceApp.Areas.Admin.Pages.IndexModel.FormatPartForm(u.PartForm)</td>
                      <td><span class="status-badge @payBadgeClass">@payStat</span></td>
                      <td>@if (!string.IsNullOrEmpty(payMethod)) { <span class="method-badge @mClass">@payMethod</span> } else { <span style="color:var(--c-border-strong);">—</span> }</td>
                      <td style="font-size:12px;">@paidAt</td>
                      <td style="font-size:12px;">@if (u.IbanTransferSubmittedAt.HasValue) { <span style="color:var(--c-amber);font-weight:bold;">@ibanAt</span> } else { <text>—</text> }</td>
                      <td>
                        @if (payStat != "Confirmed")
                        {
                            <button type="button" class="action-btn btn-view confirm-payment-btn"
                                    data-userid="@u.Id" data-name="@u.FirstName @u.LastName"
                                    data-ref="@u.ReferenceNumber" data-method="Manual"
                                    style="font-size:12px;padding:5px 9px;"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points='20 6 9 17 4 12'></polyline></svg> Confirm</button>
                        }
                        @if (payStat != "Cancelled")
                        {
                            <button type="button" class="action-btn btn-delete cancel-payment-btn"
                                    data-userid="@u.Id" data-name="@u.FirstName @u.LastName"
                                    style="font-size:12px;padding:5px 9px;"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1='18' y1='6' x2='6' y2='18'></line><line x1='6' y1='6' x2='18' y2='18'></line></svg> Cancel</button>
                        }
                        @if (payStat == "Confirmed") { <span style="color:var(--c-green);font-weight:bold;font-size:12px;"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points='20 6 9 17 4 12'></polyline></svg> Paid</span> }
                      </td>
                    </tr>
                }
              </tbody>
            </table>
            </div>
          </div>
        </div>

        
        <div id="tab-verifications" class="admin-section">

          <!-- PENDING VERIFICATIONS — Card-based with live preview -->
          <div class="admin-panel-card">
            <h3>
              <span>
                <span class="card-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d='M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2'></path><rect x='9' y='3' width='6' height='4' rx='1'></rect></svg></span>
                Pending Verifications
              </span>
              @if (Model.PendingVerifCount > 0)
              {
                  <span class="status-badge status-pending">@Model.PendingVerifCount awaiting review</span>
              }
              else
              {
                  <span class="status-badge status-approved">All reviewed</span>
              }
            </h3>

            @if (!Model.PendingVerifications.Any())
            {
                <div class="empty-state">
                  <span class="empty-state-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><polyline points="8 12.5 11 15.5 16 9"></polyline></svg></span>
                  <span>No pending verifications. All caught up!</span>
                </div>
            }
            else
            {
                <div style="padding:16px 22px;">
                  @foreach (var u in Model.PendingVerifications)
                  {
                      var vType  = u.PartForm == "2" ? "Student / PhD" : "Journalist / Media";
                      var vBadge = u.PartForm == "2" ? "verif-type-student" : "verif-type-journalist";
                      var subAt  = u.VerificationSubmittedAt.HasValue
                          ? ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(u.VerificationSubmittedAt.Value).ToString("dd.MM.yyyy HH:mm")
                          : "—";
                      var initials = $"{(u.FirstName?.Length > 0 ? u.FirstName[0] : ' ')}{(u.LastName?.Length > 0 ? u.LastName[0] : ' ')}".ToUpper();
                      var hasDoc   = !string.IsNullOrEmpty(u.VerificationDocumentPath);
                      var docExt   = hasDoc ? System.IO.Path.GetExtension(u.VerificationDocumentPath ?? "").ToLower() : "";
                      var isImage  = new[]{ ".jpg", ".jpeg", ".png", ".webp", ".gif" }.Contains(docExt);

                      <div class="verif-pending-card" id="vpc-@u.Id">
                        <!-- Card Header — always visible -->
                        <div class="verif-pending-card-header" id="vpc-header-@u.Id">
                          <div class="verif-pending-user">
                            <div class="verif-pending-avatar">@initials</div>
                            <div>
                              <div class="verif-pending-name">@u.FirstName @u.LastName</div>
                              <div class="verif-pending-email">@u.Email</div>
                            </div>
                          </div>
                          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                            <span class="status-badge @vBadge">@vType</span>
                            <span style="font-size:12px;color:var(--c-text-muted);">@subAt</span>
                            <div class="verif-pending-actions">
                              <button type="button" class="action-btn btn-view approve-verif-btn"
                                      data-userid="@u.Id"
                                      data-name="@u.FirstName @u.LastName"
                                      data-type="@vType"
                                      data-partform="@u.PartForm"
                                      style="font-size:12px;padding:5px 11px;"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points='20 6 9 17 4 12'></polyline></svg> Approve</button>
                              <button type="button" class="action-btn btn-delete reject-verif-btn"
                                      data-userid="@u.Id"
                                      data-name="@u.FirstName @u.LastName"
                                      style="font-size:12px;padding:5px 11px;"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1='18' y1='6' x2='6' y2='18'></line><line x1='6' y1='6' x2='18' y2='18'></line></svg> Reject</button>
                              <button type="button" class="verif-expand-btn" id="vpc-toggle-@u.Id">
                                <span>Review</span><span class="chevron"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points='6 9 12 15 18 9'></polyline></svg></span>
                              </button>
                            </div>
                          </div>
                        </div>

                        <!-- Card Body — expandable live preview -->
                        <div class="verif-pending-body" id="vpc-body-@u.Id">
                          <div class="verif-review-layout">

                            <!-- Left: info -->
                            <div class="verif-info-panel">
                              <h5>Submitted Information</h5>
                              <div class="verif-info-row">
                                <span class="label">Type</span>
                                <span class="value"><span class="status-badge @vBadge">@vType</span></span>
                              </div>
                              <div class="verif-info-row">
                                <span class="label">Institution</span>
                                <span class="value">@(u.VerificationInstitution ?? "—")</span>
                              </div>
                              <div class="verif-info-row">
                                <span class="label">@(u.PartForm == "2" ? "Specialty" : "Position")</span>
                                <span class="value">@(u.VerificationSpecialty ?? "—")</span>
                              </div>
                              <div class="verif-info-row">
                                <span class="label">@(u.PartForm == "2" ? "Semester / Year" : "Media / Website URL")</span>
                                <span class="value">
                                  @if (u.PartForm == "2" && !string.IsNullOrEmpty(u.VerificationYear))
                                  {
                                      <text>Semester @u.VerificationYear</text>
                                  }
                                  else
                                  {
                                      @(u.VerificationYear ?? "—")
                                  }
                                </span>
                              </div>
                              @if (u.PartForm == "2" && !string.IsNullOrEmpty(u.VerificationStudentId))
                              {
                                  <div class="verif-info-row">
                                    <span class="label">Student ID</span>
                                    <span class="value"><code>@u.VerificationStudentId</code></span>
                                  </div>
                              }
                              <div class="verif-info-row">
                                <span class="label">Submitted</span>
                                <span class="value">@subAt</span>
                              </div>
                              <div class="verif-info-row">
                                <span class="label">Reference</span>
                                <span class="value"><code>@u.ReferenceNumber</code></span>
                              </div>
                              @if (u.PartForm == "2")
                              {
                                  <div style="margin-top:12px;padding:10px;background:var(--c-amber-light);border:1px solid var(--c-amber-border);border-radius:6px;font-size:12px;color:var(--c-amber);">
                                    <strong><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx='12' cy='12' r='9'></circle><line x1='12' y1='11' x2='12' y2='16'></line><line x1='12' y1='8' x2='12.01' y2='8'></line></svg> Note:</strong> Approving will auto-confirm payment as <strong>Subsidised</strong> (student discount).
                                  </div>
                              }
                              else if (u.PartForm == "4")
                              {
                                  <div style="margin-top:12px;padding:10px;background:var(--c-blue-light);border:1px solid var(--c-blue-border);border-radius:6px;font-size:12px;color:var(--c-blue);">
                                    <strong><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx='12' cy='12' r='9'></circle><line x1='12' y1='11' x2='12' y2='16'></line><line x1='12' y1='8' x2='12.01' y2='8'></line></svg> Note:</strong> Approving will confirm journalist/media <strong>accreditation</strong> and auto-confirm registration.
                                  </div>
                              }
                            </div>

                            <!-- Right: document preview -->
                            <div class="verif-doc-panel">
                              <h5>
                                <span>Verification Document</span>
                                @if (hasDoc)
                                {
                                    <a href="?handler=DownloadVerifDoc&userId=@u.Id"
                                       class="action-btn btn-download"
                                       style="font-size:11px;padding:3px 9px;"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d='M12 3v12'></path><polyline points='7 11 12 16 17 11'></polyline><path d='M5 19h14'></path></svg> Download</a>
                                }
                              </h5>
                              <div class="verif-doc-preview" id="vdp-@u.Id">
                                @if (!hasDoc)
                                {
                                    <div class="verif-doc-placeholder">
                                      <span class="ph-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline></svg></span>
                                      <span>No document uploaded</span>
                                    </div>
                                }
                                else if (isImage)
                                {
                                    <!-- Image: load inline -->
                                    <img src="?handler=DownloadVerifDoc&userId=@u.Id"
                                         alt="Verification document"
                                         style="max-width:100%;max-height:220px;object-fit:contain;"
                                         onerror="this.style.display='none';" />
                                }
                                else
                                {
                                    <!-- PDF or other: embed or prompt download -->
                                    <div class="verif-doc-placeholder">
                                      <span class="ph-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline></svg></span>
                                      <span style="font-size:12px;text-align:center;">PDF document<br><a href="?handler=DownloadVerifDoc&userId=@u.Id" style="color:var(--c-blue);font-weight:600;">Open / Download</a></span>
                                    </div>
                                }
                              </div>
                              @if (hasDoc)
                              {
                                  <div class="verif-doc-footer">
                                    <span style="font-size:11px;color:var(--c-text-muted);flex:1;">@System.IO.Path.GetFileName(u.VerificationDocumentPath)</span>
                                    <span style="font-size:11px;color:var(--c-text-muted);text-transform:uppercase;font-weight:700;">@docExt.TrimStart('.')</span>
                                  </div>
                              }
                            </div>

                          </div><!-- end verif-review-layout -->
                        </div><!-- end verif-pending-body -->
                      </div><!-- end verif-pending-card -->
                  }
                </div>
            }
          </div>

          <!-- VERIFICATIONS HISTORY -->
          <div class="admin-panel-card">
            <h3>
              <span><span class="card-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1='18' y1='20' x2='18' y2='10'></line><line x1='12' y1='20' x2='12' y2='4'></line><line x1='6' y1='20' x2='6' y2='14'></line></svg></span>All Verifications History</span>
            </h3>
            <div class="admin-filters">
              <input type="text" id="verifSearchInput" placeholder="Search by name or institution..." class="filter-input">
              <select id="verifStatusFilter" class="filter-select">
                <option value="all">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
                <option value="None">No Submission</option>
              </select>
              <select id="verifTypeFilter" class="filter-select">
                <option value="all">All Types</option>
                <option value="2">Student / PhD</option>
                <option value="4">Journalist / Media</option>
              </select>
            </div>
            <div class="table-scroll">
            <table class="admin-table">
              <thead>
                <tr><th>User</th><th>Type</th><th>Institution</th><th>Status</th><th>Submitted</th><th>Document</th></tr>
              </thead>
              <tbody>
                @if (!Model.AllVerifications.Any())
                {
                    <tr><td colspan="6"><div class="empty-state"><span class="empty-state-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path><rect x="9" y="3" width="6" height="4" rx="1"></rect></svg></span><span>No students or journalists registered yet.</span></div></td></tr>
                }
                else
                {
                    @foreach (var u in Model.AllVerifications)
                    {
                        var vType   = u.PartForm == "2" ? "Student / PhD" : "Journalist / Media";
                        var vBadge  = u.PartForm == "2" ? "verif-type-student" : "verif-type-journalist";
                        var vStat   = u.VerificationStatus ?? "None";
                        var vStatBadge = vStat == "Approved" ? "status-approved" : vStat == "Rejected" ? "status-rejected" : vStat == "Pending" ? "status-pending" : "status-none";
                        var subAt   = u.VerificationSubmittedAt.HasValue
                            ? ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(u.VerificationSubmittedAt.Value).ToString("dd.MM.yyyy HH:mm")
                            : "—";
                        <tr class="verif-data-row"
                            data-search="@($"{u.FirstName} {u.LastName} {u.Email} {u.VerificationInstitution}".ToLower())"
                            data-status="@vStat"
                            data-type="@u.PartForm">
                          <td>
                            <strong>@u.FirstName @u.LastName</strong>
                            <br><small style="color:var(--c-text-muted);">@u.Email</small>
                          </td>
                          <td><span class="status-badge @vBadge">@vType</span></td>
                          <td style="font-size:13px;">@(u.VerificationInstitution ?? "—")</td>
                          <td><span class="status-badge @vStatBadge">@vStat</span></td>
                          <td style="font-size:12px;white-space:nowrap;">@subAt</td>
                          <td>
                            @if (!string.IsNullOrEmpty(u.VerificationDocumentPath))
                            {
                                <a href="?handler=DownloadVerifDoc&userId=@u.Id" class="action-btn btn-download" style="font-size:11px;padding:4px 8px;"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d='M12 3v12'></path><polyline points='7 11 12 16 17 11'></polyline><path d='M5 19h14'></path></svg> Download</a>
                            }
                            else { <span style="color:var(--c-text-xmuted);font-size:12px;">None</span> }
                          </td>
                        </tr>
                    }
                }
              </tbody>
            </table>
            </div>
          </div>
        </div>

        <div id="tab-crypto" class="admin-section">
          <div class="admin-panel-card">
            <h3>
              <span>Crypto Payment Orders (Go28)</span>
              <div class="header-actions">
                @* Трие само изтеклите. Потвърдените са следа от реално плащане
                   и не се пипат — виж OnPostClearInactiveCryptoOrdersAsync. *@
                <button type="button" id="clearInactiveCryptoBtn" class="action-btn"
                        title="Трие изтеклите поръчки. Потвърдените и активните остават.">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
                  Изчисти неактивните
                </button>
              </div>
            </h3>
            <div class="admin-filters">
              <input type="text" id="cryptoSearchInput" placeholder="Search by currency, external ID or wallet..." class="filter-input">
              <select id="cryptoStatusFilter" class="filter-select">
                <option value="all">All Statuses</option>
                <option value="InProcess">In Process</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Expired">Expired</option>
                <option value="Cancelled">Cancelled</option>
              </select>
              <select id="cryptoCurrencyFilter" class="filter-select">
                <option value="all">All Currencies</option>
                <option value="BTC">BTC</option>
                <option value="ETH">ETH</option>
                <option value="USDC">USDC</option>
                <option value="EURC">EURC</option>
              </select>
            </div>
            <div class="table-scroll">
            <table class="admin-table">
              <thead>
                <tr><th>Go28 ID</th><th>External ID</th><th>User ID</th><th>Currency</th><th>EUR Amount</th><th>Crypto Amount</th><th>Status</th><th>Created</th><th>Expires / Completed</th></tr>
              </thead>
              <tbody id="cryptoTableBody">
                @if (!Model.CryptoOrders.Any())
                {
                    <tr><td colspan="9" class="empty-state"><span class="empty-state-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 5h7a3.5 3.5 0 0 1 0 7H7z"></path><path d="M7 12h7.5a3.5 3.5 0 0 1 0 7H7z"></path><line x1="9.5" y1="3" x2="9.5" y2="21"></line></svg></span>No crypto orders yet.</td></tr>
                }
                else
                {
                    @foreach (var o in Model.CryptoOrders)
                    {
                        var cStatBadge = o.Status == "Confirmed" ? "status-confirmed" : o.Status == "InProcess" ? "status-inprocess" : o.Status == "Expired" ? "status-rejected" : "status-none";
                        var cCreated = ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(o.CreatedAt).ToString("dd.MM.yyyy HH:mm");
                        var cEnd = o.CompletedAt.HasValue
                            ? ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(o.CompletedAt.Value).ToString("dd.MM.yyyy HH:mm")
                            : (o.ExpiresAt.HasValue ? ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(o.ExpiresAt.Value).ToString("dd.MM.yyyy HH:mm") : "—");
                        <tr class="crypto-data-row"
                            data-search="@($"{o.Currency} {o.ExternalId} {o.WalletAddress}".ToLower())"
                            data-status="@o.Status"
                            data-currency="@o.Currency">
                          <td><code>@o.Go28OrderId</code></td>
                          <td style="font-size:11px;max-width:160px;word-break:break-all;">@o.ExternalId</td>
                          <td style="font-size:11px;color:var(--c-text-muted);max-width:80px;word-break:break-all;">@o.UserId.Substring(0, Math.Min(8, o.UserId.Length))…</td>
                          <td><strong>@o.Currency</strong><br><small style="color:var(--c-text-muted);">@o.Network</small></td>
                          <td><strong style="color:var(--c-green);">€@o.AmountEUR</strong></td>
                          <td style="font-size:12px;">@o.CryptoAmount</td>
                          <td><span class="status-badge @cStatBadge">@o.Status</span></td>
                          <td style="font-size:12px;">@cCreated</td>
                          <td style="font-size:12px;color:var(--c-text-secondary);">@cEnd</td>
                        </tr>
                    }
                }
              </tbody>
            </table>
            </div>
          </div>
        </div>

        
        <div id="tab-audit" class="admin-section">
          <div class="admin-panel-card">
            <h3>
              <span>Audit Logs (Last 200)</span>
              <div class="header-actions">
                <a href="?handler=ExportAuditLogs" class="action-btn btn-audit" style="text-decoration:none;">Export All CSV</a>
              </div>
            </h3>
            <div class="admin-filters">
              <input type="text" id="auditSearchInput" placeholder="Search by email, action or details..." class="filter-input">
              <select id="auditActionFilter" class="filter-select">
                <option value="all">All Actions</option>
                <option value="Payment">Payment</option>
                <option value="Verification">Verification</option>
                <option value="Admin Edit">Admin Edit</option>
                <option value="User Registered">Registration</option>
                <option value="User Deleted">Deletion</option>
                <option value="Stripe">Stripe</option>
                <option value="Webhook">Webhook</option>
                <option value="Login">Login</option>
                <option value="System">System</option>
              </select>
            </div>
            <div class="table-scroll">
            <table class="admin-table">
              <thead>
                <tr><th style="white-space:nowrap;">Date &amp; Time (BG)</th><th>User</th><th>Action</th><th>IP Address</th><th>Details</th></tr>
              </thead>
              <tbody>
                @if (!Model.RecentAuditLogs.Any())
                {
                    <tr><td colspan="5" class="empty-state"><span class="empty-state-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path><rect x="9" y="3" width="6" height="4" rx="1"></rect></svg></span>No audit logs yet.</td></tr>
                }
                else
                {
                    @foreach (var log in Model.RecentAuditLogs)
                    {
                        var logTime = ConferenceApp.Areas.Admin.Pages.IndexModel.ConvertToBgTime(log.Timestamp).ToString("dd.MM.yyyy HH:mm:ss");
                        var logIp = log.IpAddress == "::1" ? "Localhost" : (log.IpAddress ?? "—");
                        var isPayment = log.Action.Contains("Payment") || log.Action.Contains("Stripe") || log.Action.Contains("Webhook");
                        var isVerif = log.Action.Contains("Verification");
                        var isDelete = log.Action.Contains("Deleted");
                        var rowClass = isPayment ? "audit-row-payment" : isVerif ? "audit-row-verification" : isDelete ? "audit-row-delete" : "";
                        <tr class="@rowClass audit-data-row"
                            data-search="@($"{log.UserEmail} {log.Action} {log.Details}".ToLower())"
                            data-action="@log.Action">
                          <td style="font-size:12px;white-space:nowrap;">@logTime</td>
                          <td style="font-size:12px;">@log.UserEmail</td>
                          <td>
