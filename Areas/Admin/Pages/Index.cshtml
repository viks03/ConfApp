                            }
                            <button type="button" class="action-btn btn-delete delete-session-btn"
                                    data-modal-target="delete-modal" data-delete-name="@s.TitleEn" data-id="@s.Id">Delete</button>
                          </td>
                        </tr>
                    }
                }
