          <div class="detail-item"><span>Full Name</span><strong id="viewFullName">—</strong></div>
          <div class="detail-item"><span>Age</span><strong id="viewAge">—</strong></div>
          <div class="detail-item"><span>Email</span><strong id="viewEmail" style="word-break:break-all;">—</strong></div>
          <div class="detail-item"><span>Phone</span><strong id="viewPhone">—</strong></div>
          <div class="detail-item"><span>Academic Title</span><strong id="viewTitle">—</strong></div>
