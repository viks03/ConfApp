                            <span class="pay-gate-title">USDC<span class="pay-gate-net">ETH</span></span>
                            <span class="pay-gate-desc">USD Coin — runs on Ethereum</span>
                          </div>
                        </div>
                        <label class="email-switch" title="USD Coin">
                          <input type="checkbox" class="pay-gate-input"
                                 data-gate-key="currency.USDC" data-gate-level="currency"
