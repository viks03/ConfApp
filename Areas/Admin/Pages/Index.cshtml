                                    data-id="@s.Id" data-day="@s.Day"
                                    data-start="@s.StartTime" data-end="@s.EndTime"
                                    data-title-en="@s.TitleEn" data-title-bg="@s.TitleBg"
                                    data-type="@s.SessionType"
                                    data-speaker-en="@s.SpeakerEn" data-speaker-bg="@s.SpeakerBg"
                                    data-loc-en="@s.LocationEn" data-loc-bg="@s.LocationBg"
                                    data-desc-en="@s.DescriptionEn" data-desc-bg="@s.DescriptionBg"
                                    data-stream-url="@(s.LiveStreamUrl ?? "")">Edit</button>
