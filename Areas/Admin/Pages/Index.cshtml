          </div>
        </div>

        <div id="tab-settings" class="admin-section">
          <div class="admin-panel-card">
            <h3><span>Social Media Links</span></h3>
            <div class="card-body">
              <p class="settings-hint">Leave a field empty to hide that icon on the site — nothing is required.</p>
              @Html.AntiForgeryToken()
              <div class="settings-grid">
                <div class="form-group">
                  <label>LinkedIn</label>
                  <input type="text" id="socialLinkedIn" value="@Model.SocialLinks.LinkedInUrl" placeholder="https://linkedin.com/company/...">
                </div>
                <div class="form-group">
                  <label>X (Twitter)</label>
                  <input type="text" id="socialX" value="@Model.SocialLinks.XUrl" placeholder="https://x.com/...">
                </div>
                <div class="form-group">
                  <label>Instagram</label>
                  <input type="text" id="socialInstagram" value="@Model.SocialLinks.InstagramUrl" placeholder="https://instagram.com/...">
                </div>
                <div class="form-group">
                  <label>Facebook</label>
                  <input type="text" id="socialFacebook" value="@Model.SocialLinks.FacebookUrl" placeholder="https://facebook.com/...">
                </div>
                <div class="form-group">
                  <label>TikTok</label>
                  <input type="text" id="socialTikTok" value="@Model.SocialLinks.TikTokUrl" placeholder="https://tiktok.com/@@...">
                </div>
                <div class="form-group">
                  <label>YouTube</label>
                  <input type="text" id="socialYouTube" value="@Model.SocialLinks.YouTubeUrl" placeholder="https://youtube.com/@@...">
                </div>
              </div>
              <div class="privacy-actions-row">
                <button type="button" class="btn-save" id="saveSocialLinksBtn">Save Social Links</button>
              </div>
            </div>
          </div>

          <div class="admin-panel-card">
            <h3>
              <span>Homepage Promo Slides</span>
              <button type="button" class="action-btn btn-add" data-modal-target="edit-promo-modal" data-modal-title="Add Promo Slide" style="margin-left:auto;">+ Add Promo Slide</button>
            </h3>
            <div class="card-body">
              <p class="settings-hint">Drag the <svg class="icon-inline" viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.6"></circle><circle cx="9" cy="12" r="1.6"></circle><circle cx="9" cy="18" r="1.6"></circle><circle cx="15" cy="6" r="1.6"></circle><circle cx="15" cy="12" r="1.6"></circle><circle cx="15" cy="18" r="1.6"></circle></svg> handle to reorder — this controls the order slides appear in on the mobile navigation menu.</p>
              <div id="promoSlideList" class="promo-slide-list">
                @if (!Model.PromoSlides.Any())
                {
                    <div class="empty-state"><span class="empty-state-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg></span>No promo slides added yet.</div>
                }
                else
                {
                    @foreach (var promo in Model.PromoSlides)
                    {
                        <div class="promo-slide-row @(promo.IsActive ? "" : "is-inactive")" draggable="true" data-id="@promo.Id">
                          <span class="promo-drag-handle" title="Drag to reorder"><svg class="icon-inline" viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.6"></circle><circle cx="9" cy="12" r="1.6"></circle><circle cx="9" cy="18" r="1.6"></circle><circle cx="15" cy="6" r="1.6"></circle><circle cx="15" cy="12" r="1.6"></circle><circle cx="15" cy="18" r="1.6"></circle></svg></span>
                          <img src="@(string.IsNullOrEmpty(promo.ImagePath) ? "/images/logos/avatar.png" : promo.ImagePath)" alt="" class="promo-slide-thumb zoomable-image" data-image-src="@(string.IsNullOrEmpty(promo.ImagePath) ? "/images/logos/avatar.png" : promo.ImagePath)">
                          <div class="promo-slide-info">
                            <strong>@promo.TitleEn</strong>
                            <span class="promo-slide-desc">@promo.DescriptionEn</span>
                          </div>
                          @if (!promo.IsActive)
                          {
                              <span class="tab-badge" style="position:static;margin-right:8px;">Hidden</span>
                          }
                          <div class="promo-slide-actions">
                            <button type="button" class="action-btn toggle-promo-active-btn" data-id="@promo.Id">@(promo.IsActive ? "Hide" : "Show")</button>
                            <button type="button" class="action-btn btn-edit edit-promo-btn"
                                    data-modal-target="edit-promo-modal" data-modal-title="Edit Promo Slide: @promo.TitleEn"
                                    data-id="@promo.Id" data-title-en="@promo.TitleEn" data-title-bg="@promo.TitleBg"
                                    data-desc-en="@promo.DescriptionEn" data-desc-bg="@promo.DescriptionBg">Edit</button>
                            <button type="button" class="action-btn btn-delete delete-promo-btn"
                                    data-modal-target="delete-modal" data-delete-name="@promo.TitleEn" data-id="@promo.Id">Delete</button>
                          </div>
                        </div>
                    }
                }
              </div>
            </div>
          </div>

          <div class="admin-panel-card">
            <h3>
              <span>Footer Quick Links</span>
              <button type="button" class="action-btn btn-add" data-modal-target="edit-footer-link-modal" data-modal-title="Add Quick Link" style="margin-left:auto;">+ Add Quick Link</button>
            </h3>
            <div class="card-body">
              <p class="settings-hint">The public footer shows at most <strong>5</strong> of these at a time, picked at random and re-shuffled on every page load — not curated by admins, so there's no drag-to-reorder here (unlike Promo Slides/FAQ above). Add as many as you like; over time visitors see the full set. Each link's icon is its own inline SVG code (same stroke style as the rest of the site), so every entry is guaranteed to render its own icon instead of falling back to a generic one.</p>

              <div id="footerQuickLinksList" class="promo-slide-list">
                @if (!Model.FooterQuickLinks.Any())
                {
                    <div class="empty-state"><span class="empty-state-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11.5 4.5"></path><path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L12.5 19.5"></path></svg></span>No quick links added yet.</div>
                }
                else
                {
                    @foreach (var link in Model.FooterQuickLinks)
                    {
                        <div class="promo-slide-row @(link.IsVisible ? "" : "is-inactive")" data-id="@link.Id">
                          <span class="footer-link-icon-preview" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(link.IconSvg)</svg>
                          </span>
                          <div class="promo-slide-info">
                            <strong>@link.LabelEn</strong>
                            <span class="promo-slide-desc">@link.Url</span>
                          </div>
                          @if (!link.IsVisible)
                          {
                              <span class="tab-badge" style="position:static;margin-right:8px;">Hidden</span>
                          }
                          <div class="promo-slide-actions">
                            <button type="button" class="action-btn toggle-footerlink-active-btn" data-id="@link.Id">@(link.IsVisible ? "Hide" : "Show")</button>
                            <button type="button" class="action-btn btn-edit edit-footerlink-btn"
                                    data-modal-target="edit-footer-link-modal" data-modal-title="Edit Quick Link: @link.LabelEn"
                                    data-id="@link.Id" data-label-en="@link.LabelEn" data-label-bg="@link.LabelBg" data-url="@link.Url"
                                    data-icon="@link.IconSvg">Edit</button>
                            <button type="button" class="action-btn btn-delete delete-footerlink-btn"
                                    data-modal-target="delete-modal" data-delete-name="@link.LabelEn" data-id="@link.Id">Delete</button>
                          </div>
                        </div>
                    }
                }
              </div>
            </div>
          </div>

          <div class="admin-panel-card">
            <h3><span>Footer Content</span></h3>
            <div class="card-body">
              <p class="settings-hint">The tagline under the logo, the "Organized by..." note, and the contact details shown in the footer's Contact column.</p>
              <div class="modal-validation-banner" id="footer-content-validation-banner"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg> Please check the highlighted fields below.</div>
              @Html.AntiForgeryToken()

              <span class="form-section-label">Brand Tagline</span>
              <p class="settings-hint" style="margin-top:0;">Optional — leave both empty to hide the tagline line entirely (the logo then sizes itself to match the single-line title instead of a two-line block).</p>
              <div class="settings-grid">
                <div class="form-group">
                  <label>Tagline (EN)</label>
                  <input type="text" id="footerBrandTagline_en" value="@Model.FooterContent.BrandTaglineEn" placeholder="e.g. Shapes the future of finance education" maxlength="45">
                  <span class="char-counter" id="footerBrandTagline_en_counter">0 / 45</span>
                </div>
                <div class="form-group">
                  <label>Tagline (BG)</label>
                  <input type="text" id="footerBrandTagline_bg" value="@Model.FooterContent.BrandTaglineBg" placeholder="напр. Оформя бъдещето на финансовото образование" maxlength="45">
                  <span class="char-counter" id="footerBrandTagline_bg_counter">0 / 45</span>
                </div>
              </div>

              <hr class="section-divider">

              <span class="form-section-label">"Organized By" Note</span>
              <div class="form-group">
                <label>Note (EN)</label>
                <textarea id="footerOrgNote_en" maxlength="400" placeholder="Organized by the Institute of Cryptoeconomics, Blockchain and Innovations (ICBI) within the University of National and World Economy (UNWE).">@Model.FooterContent.OrgNoteEn</textarea>
              <span class="char-counter" id="footerOrgNote_en_counter">0 / 400</span>
              </div>
              <div class="form-group">
                <label>Note (BG)</label>
                <textarea id="footerOrgNote_bg" maxlength="400" placeholder="Организирано от Института по криптоикономика, блокчейн и иновации (ICBI) към Университета за национално и световно стопанство (УНСС).">@Model.FooterContent.OrgNoteBg</textarea>
              <span class="char-counter" id="footerOrgNote_bg_counter">0 / 400</span>
              </div>

              <hr class="section-divider">

              <span class="form-section-label">Contact Details</span>
              <div class="settings-grid">
                <div class="form-group">
                  <label>Address / Location (EN)</label>
                  <input type="text" id="footerContactLocation_en" value="@Model.FooterContent.ContactLocationEn" placeholder="e.g. Sofia, Bulgaria" maxlength="100">
                  <span class="char-counter" id="footerContactLocation_en_counter">0 / 100</span>
                </div>
                <div class="form-group">
                  <label>Address / Location (BG)</label>
                  <input type="text" id="footerContactLocation_bg" value="@Model.FooterContent.ContactLocationBg" placeholder="напр. София, България" maxlength="100">
                  <span class="char-counter" id="footerContactLocation_bg_counter">0 / 100</span>
                </div>
                <div class="form-group">
                  <label>Email</label>
                  <input type="email" id="footerContactEmail" value="@Model.FooterContent.ContactEmail" placeholder="conference.education@unwe.bg" maxlength="150">
                  <span class="char-counter" id="footerContactEmail_counter">0 / 150</span>
                </div>
                <div class="form-group">
                  <label>Phone</label>
                  <input type="tel" id="footerContactPhone" value="@Model.FooterContent.ContactPhone" placeholder="+359 98 871 1801" maxlength="30">
                  <span class="char-counter" id="footerContactPhone_counter">0 / 30</span>
                </div>
              </div>

              <div class="privacy-actions-row">
                <button type="button" class="btn-save" id="saveFooterContentBtn">Save Footer Content</button>
              </div>
            </div>
          </div>
        </div>

        </div>
        </div>

      </div>
    </div>
  </main>

  <div class="modal-overlay" id="view-registration-modal">
    <div class="modal-box" style="max-width:750px;">
      <div class="modal-header"><h3 id="viewModalTitle">User Details</h3></div>
