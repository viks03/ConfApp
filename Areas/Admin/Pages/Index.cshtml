              <thead>
                <tr><th>Day</th><th>Time</th><th>Title</th><th>Speaker</th><th>Type</th><th>Location</th><th>Actions</th></tr>
              </thead>
              <tbody>
                @if (!Model.ScheduleSessions.Any())
                {
                    <tr><td colspan="7" class="empty-state"><span class="empty-state-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="16" y1="2" x2="16" y2="6"></line></svg></span>No sessions added yet.</td></tr>
                }
                else
                {
                    @foreach (var s in Model.ScheduleSessions)
                    {
                        var breakTypes = new HashSet<string>(StringComparer.OrdinalIgnoreCase){ "coffee break","refreshment break","lunch","dinner","farewell lunch","registration" };
                        var typeBadge = breakTypes.Contains(s.SessionType ?? "") ? "type-break" : "type-registration";
                        <tr>
                          <td style="font-size:12px;white-space:nowrap;">@s.Day</td>
                          <td style="font-size:12px;white-space:nowrap;">@s.StartTime — @s.EndTime</td>
                          <td>
                              <div class="schedule-title-cell">
                                  @if (!string.IsNullOrEmpty(s.LiveStreamUrl))
                                  {
                                      <span class="live-dot" title="Live: @s.LiveStreamUrl"></span>
                                  }
                                  <strong>@s.TitleEn</strong>
                              </div>
                          </td>
                          <td style="font-size:12px;color:var(--c-text-secondary);">@(string.IsNullOrEmpty(s.SpeakerEn) ? "—" : s.SpeakerEn)</td>
                          <td><span class="category-badge @typeBadge">@(s.SessionType ?? "—")</span></td>
                          <td style="font-size:12px;">@(string.IsNullOrEmpty(s.LocationEn) ? "—" : s.LocationEn)</td>
