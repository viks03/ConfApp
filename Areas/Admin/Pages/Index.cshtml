          <div class="detail-item"><span>Reference Number</span><strong id="viewRefNum" style="font-family:monospace;font-size:13px;">—</strong></div>
          <div class="detail-item"><span>Payment Status</span><strong id="viewPayment">—</strong></div>
          <div class="detail-item"><span>Payment Method</span><strong id="viewPayMethod">—</strong></div>
          <div class="detail-item"><span>Paid At</span><strong id="viewPaidAt">—</strong></div>
