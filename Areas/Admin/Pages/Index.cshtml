                      <div class="pay-gate-row">
                        <div class="pay-gate-row-main">
                          <span class="pay-gate-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><circle cx="12" cy="12" r="9"></circle><path d="M12 6.5v11"></path><path d="M14.6 9.4A2.7 2.7 0 0 0 12 8c-1.5 0-2.6.9-2.6 2s1.1 2 2.6 2 2.6.9 2.6 2-1.1 2-2.6 2a2.7 2.7 0 0 1-2.6-1.4"></path></svg>
