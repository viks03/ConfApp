        <div class="form-group">
          <label>Answer (EN) <span class="required-star">*</span></label>
          <textarea id="faqAnswer_en" style="min-height:100px;" placeholder="Full answer in English..."></textarea>
        </div>
        <div class="form-group">
          <label>Answer (BG) <span class="required-star">*</span></label>
          <textarea id="faqAnswer_bg" style="min-height:100px;" placeholder="Пълен отговор на български..."></textarea>
        </div>
        
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel modal-close-btn">Cancel</button>
        <button type="button" class="btn-save" id="saveFaqBtn">Save FAQ</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="cookieCategoryModal">
