        <!-- ── HEALTH CHECK ───────────────────────────────────────────────
             Проверката тръгва при отваряне на таба (adminPanelHealth.js),
             не при зареждане на панела. data-hc-endpoint може да се смени,
             без да се пипа скриптът; data-hc-mode="bulk" превключва от осем
             паралелни заявки към една обща.                            -->
        <div id="tab-health" class="admin-section"
             data-hc-endpoint="?handler=HealthCheck" data-hc-mode="parallel">
          <div class="admin-panel-card">
            <h3>
              <span>
                <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 5 12 2.5-6h4"></path></svg></span>
                <span>Health Check</span>
              </span>
              <div class="header-actions">
                <button type="button" id="hc-copy" class="action-btn">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12"></rect><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path></svg>
                  Копирай като текст
                </button>
                <button type="button" id="hc-refresh-all" class="action-btn btn-add">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 12a8.5 8.5 0 1 1-2.6-6.1"></path><polyline points="20.5 4 20.5 9.2 15.3 9.2"></polyline></svg>
                  Провери отново
                </button>
              </div>
            </h3>

            <div class="hc-toolbar">
              <p style="margin:0; font-size:12.5px; line-height:1.45; color:var(--c-text-muted); max-width:76ch;">
                Моментна снимка, не непрекъснат монитор. Проверката се свързва и се представя,
                но не създава реални плащания и не изпраща имейли до никого.
              </p>
              <div class="hc-toolbar-meta">
                <span>Последна проверка</span><span id="hc-timestamp">—</span>
              </div>
            </div>

            <div id="hc-fatal" class="hc-fatal" role="alert">
              <span class="hc-summary-mark" style="color:var(--c-accent-ink); border-color:currentColor;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg>
              </span>
              <div class="hc-fatal-text">
                <span class="hc-fatal-title">Проверката не тръгна</span>
                <p class="hc-fatal-body"></p>
                <button type="button" class="action-btn" onclick="window.adminHealthCheck &amp;&amp; window.adminHealthCheck.run()">Опитай пак</button>
              </div>
            </div>

            <div id="hc-summary" class="hc-summary is-loading" role="status" aria-live="polite">
              <span class="hc-summary-mark"></span>
              <span class="hc-summary-text">
                <span class="hc-summary-title">Проверката тече</span>
                <span class="hc-summary-sub">0 от 8 услуги са проверени.</span>
              </span>
              <span class="hc-tally">
                <span class="hc-tally-item is-ok"><span class="hc-tally-num">0</span><span class="hc-tally-label">Работят</span></span>
                <span class="hc-tally-item is-warn"><span class="hc-tally-num">0</span><span class="hc-tally-label">Внимание</span></span>
                <span class="hc-tally-item is-fail"><span class="hc-tally-num">0</span><span class="hc-tally-label">Проблем</span></span>
              </span>
            </div>

            <div id="hc-grid" class="hc-grid"></div>
          </div>
        </div>

