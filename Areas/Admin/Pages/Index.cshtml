  </div>

  <div class="modal-overlay" id="upload-logo-modal" style="display:none;">
    <div class="modal-box" style="max-width: 400px; margin: 10% auto;">
      <div class="modal-header">
          <h3>Add New Home Page Logo</h3>
      </div>
      <form method="post" asp-page-handler="UploadLogo" enctype="multipart/form-data">
        <div class="modal-body">
            <div class="form-group">
                <label>Select Image File <span class="required-star">*</span></label>
                <input type="file" name="logoFile" accept="image/*" required />
            </div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn-cancel" onclick="document.getElementById('upload-logo-modal').style.display='none'">Cancel</button>
            <button type="submit" class="btn-save">Upload</button>
        </div>
      </form>
    </div>
  </div>

  <div id="toast-container" class="toast-container"></div>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
  <script src="~/js/adminPanel.js" asp-append-version="true"></script>
  <script src="~/js/adminPanelHealth.js" asp-append-version="true"></script>

  @if (TempData["SuccessMessage"] != null)
  {
      <script>
        document.addEventListener("DOMContentLoaded", () => {
            localStorage.setItem('activeAdminTab', 'tab-attend');
            window.showToast('@TempData["SuccessMessage"]', 'success');
        });
      </script>
  }
  @if (TempData["ErrorMessage"] != null)
  {
      <script>
        document.addEventListener("DOMContentLoaded", () => {
            window.showToast('@TempData["ErrorMessage"]', 'error');
        });
      </script>
  }

  <script>
  function deleteHomePageLogo(logoId) {
      if (!confirm("Сигурни ли сте, че искате да изтриете това лого?")) return;

      const formData = new FormData();
      formData.append("id", logoId);

      const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
      formData.append("__RequestVerificationToken", token);

      fetch('?handler=DeleteLogo', {
          method: 'POST',
          body: formData
      })
      .then(response => response.json())
      .then(data => {
          if (data.success) {
              const row = document.getElementById(`logo-row-${logoId}`);
              if (row) row.remove();
          } else {
              alert("Грешка при изтриването: " + (data.message || "Неизвестна грешка"));
          }
      })
      .catch(error => {
          console.error("Error:", error);
          alert("Възникна мрежова грешка.");
      });
  }
  </script>
}