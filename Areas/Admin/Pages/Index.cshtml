                    @foreach (var t in Model.TicketTiers)
                    {
                        <tr>
                          <td><strong>@t.NameEn</strong></td>
                          <td>@t.DescriptionEn</td>
                          <td>
                            @if (!string.IsNullOrEmpty(t.PromoPriceEn))
                            {
                                <del style="color:var(--c-text-muted);margin-right:5px;">@t.RegularPriceEn</del><strong>@t.PromoPriceEn</strong>
                            }
                            else if (t.RegularPriceEn == "Fully Subsidized")
                            {
                                <span style="color:var(--c-green);font-weight:bold;">@t.RegularPriceEn</span>
                            }
                            else { <strong>@t.RegularPriceEn</strong> }
                          </td>
                          <td>
                            <button type="button" class="action-btn btn-edit edit-ticket-btn"
                                    data-modal-target="edit-ticket-modal" data-modal-title="Edit Tier: @t.NameEn"
                                    data-id="@t.Id" data-name-en="@t.NameEn" data-name-bg="@t.NameBg"
                                    data-desc-en="@t.DescriptionEn" data-desc-bg="@t.DescriptionBg"
                                    data-reg-en="@t.RegularPriceEn" data-reg-bg="@t.RegularPriceBg"
                                    data-promo-en="@t.PromoPriceEn" data-promo-bg="@t.PromoPriceBg"
                                    data-perks-en="@t.PerksEn" data-perks-bg="@t.PerksBg">Edit</button>
                          </td>
                        </tr>
                    }
                }
              </tbody>
            </table>
            </div>
          </div>
        </div>

        
        <div id="tab-travel" class="admin-section">
          <div class="admin-panel-card">
            <h3>
              <span>Hotels &amp; Travel</span>
              <button type="button" class="action-btn btn-add" data-modal-target="edit-hotel-modal" data-modal-title="Add New Hotel" style="margin-left:auto;">+ Add Hotel</button>
            </h3>
            <div class="table-scroll">
            <table class="admin-table">
              <thead>
                <tr><th>Hotel Name</th><th>Description</th><th>Link</th><th>Actions</th></tr>
              </thead>
              <tbody>
                @if (!Model.Hotels.Any())
                {
                    <tr><td colspan="4" class="empty-state"><span class="empty-state-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"></rect><line x1="9" y1="7.5" x2="9" y2="7.51"></line><line x1="15" y1="7.5" x2="15" y2="7.51"></line><line x1="9" y1="11.5" x2="9" y2="11.51"></line><line x1="15" y1="11.5" x2="15" y2="11.51"></line><path d="M9 21v-3a3 3 0 0 1 6 0v3"></path></svg></span>No hotels added yet.</td></tr>
                }
                else
                {
                    @foreach (var h in Model.Hotels)
                    {
                        <tr>
                          <td><strong>@h.NameEn</strong><br><span style="color:var(--c-text-secondary);font-size:12px;">@h.NameBg</span></td>
                          <td style="font-size:13px;">@h.DescriptionEn</td>
                          <td>
                            @if (!string.IsNullOrEmpty(h.Url))
                            {
                                <a href="@h.Url" target="_blank" style="color:#0077b5;font-weight:bold;text-decoration:none;">Link <svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6'></path><polyline points='15 3 21 3 21 9'></polyline><line x1='10' y1='14' x2='21' y2='3'></line></svg></a>
                            }
                            else { <span style="color:var(--c-border-strong);">—</span> }
                          </td>
                          <td>
                            <button type="button" class="action-btn btn-edit edit-hotel-btn"
                                    data-modal-target="edit-hotel-modal" data-modal-title="Edit Hotel: @h.NameEn"
                                    data-id="@h.Id" data-name-en="@h.NameEn" data-name-bg="@h.NameBg"
                                    data-desc-en="@h.DescriptionEn" data-desc-bg="@h.DescriptionBg"
                                    data-url="@h.Url">Edit</button>
                            <button type="button" class="action-btn btn-delete delete-hotel-btn"
                                    data-modal-target="delete-modal" data-delete-name="@h.NameEn" data-id="@h.Id">Delete</button>
                          </td>
                        </tr>
                    }
                }
              </tbody>
            </table>
            </div>
          </div>
        </div>

        <!-- ── FAQ SECTION ────────────────────────────────────────────────── -->
        <div id="tab-faq" class="admin-section">
          <div class="admin-panel-card">
            <h3>
              <span>Frequently Asked Questions</span>
              <button type="button" class="action-btn btn-add" data-modal-target="edit-faq-modal" data-modal-title="Add FAQ" style="margin-left:auto;">+ Add FAQ</button>
            </h3>
            <div class="card-body">
              <p class="settings-hint">Drag the <svg class="icon-inline" viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.6"></circle><circle cx="9" cy="12" r="1.6"></circle><circle cx="9" cy="18" r="1.6"></circle><circle cx="15" cy="6" r="1.6"></circle><circle cx="15" cy="12" r="1.6"></circle><circle cx="15" cy="18" r="1.6"></circle></svg> handle to reorder — this controls the order they appear on the public FAQ page.</p>
              
              <div id="faqList" class="promo-slide-list">
                @if (Model.Faqs == null || !Model.Faqs.Any())
                {
                    <div class="empty-state"><span class="empty-state-icon"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></span>No FAQs added yet.</div>
                }
                else
                {
                    @foreach (var faq in Model.Faqs)
                    {
                        <div class="promo-slide-row @(faq.IsActive ? "" : "is-inactive")" draggable="true" data-id="@faq.Id">
                          <span class="promo-drag-handle" title="Drag to reorder"><svg class="icon-inline" viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.6"></circle><circle cx="9" cy="12" r="1.6"></circle><circle cx="9" cy="18" r="1.6"></circle><circle cx="15" cy="6" r="1.6"></circle><circle cx="15" cy="12" r="1.6"></circle><circle cx="15" cy="18" r="1.6"></circle></svg></span>
                          
                          <div class="promo-slide-info">
                            <strong>@faq.QuestionEn</strong>
                            <span class="promo-slide-desc" style="white-space:normal;">@faq.QuestionBg</span>
                          </div>

                          @if (!faq.IsActive)
                          {
                              <span class="tab-badge" style="position:static;margin-right:8px;">Hidden</span>
                          }
                          <div class="promo-slide-actions">
                            <button type="button" class="action-btn toggle-faq-active-btn" data-id="@faq.Id">@(faq.IsActive ? "Hide" : "Show")</button>
                            <button type="button" class="action-btn btn-edit edit-faq-btn"
                                    data-modal-target="edit-faq-modal" data-modal-title="Edit FAQ"
                                    data-id="@faq.Id" data-question-en="@faq.QuestionEn" data-question-bg="@faq.QuestionBg"
                                    data-answer-en="@faq.AnswerEn" data-answer-bg="@faq.AnswerBg">Edit</button>
                            <button type="button" class="action-btn btn-delete delete-faq-btn"
                                    data-modal-target="delete-modal" data-delete-name="@faq.QuestionEn" data-id="@faq.Id">Delete</button>
                          </div>
                        </div>
                    }
                }
              </div>
            </div>
          </div>
        </div>

        <div id="tab-privacy" class="admin-section">
          <div class="admin-panel-card">
            <h3><span>Privacy Policy / GDPR</span></h3>
            <div class="card-body">
              <p class="settings-hint">
                This is the full content shown on the public <code>/Privacy</code> page (English and Bulgarian versions, shown to visitors based on their selected language).
                Last updated: <span id="privacyLastUpdatedText">@ConferenceApp.Helpers.TimeZoneHelper.ToLocal(Model.PrivacyContent.LastUpdatedAt).ToString("dd MMM yyyy, HH:mm")</span>.
              </p>
              @Html.AntiForgeryToken()

              <textarea id="privacyContentEnSeed" style="display:none;">@Model.PrivacyContent.ContentEn</textarea>
              <textarea id="privacyContentBgSeed" style="display:none;">@Model.PrivacyContent.ContentBg</textarea>

              <div class="form-group" style="margin-bottom:26px;">
                <label>English version</label>
                <div id="privacyEditorEn" class="quill-editor-container"></div>
              </div>

              <div class="form-group" style="margin-bottom:10px;">
                <label>Bulgarian version (Български)</label>
                <div id="privacyEditorBg" class="quill-editor-container"></div>
              </div>

              <div class="privacy-actions-row">
                <button type="button" class="btn-save" id="savePrivacyPolicyBtn">Save Privacy Policy</button>
              </div>
            </div>
          </div>
        </div>

        <div id="tab-terms" class="admin-section">
          <div class="admin-panel-card">
            <h3><span>Terms of Use</span></h3>
            <div class="card-body">
              <p class="settings-hint">
                This is the full content shown on the public <code>/Terms</code> page (English and Bulgarian versions, shown to visitors based on their selected language).
                Last updated: <span id="termsLastUpdatedText">@ConferenceApp.Helpers.TimeZoneHelper.ToLocal(Model.TermsContent.LastUpdatedAt).ToString("dd MMM yyyy, HH:mm")</span>.
              </p>
              @Html.AntiForgeryToken()

              <textarea id="termsContentEnSeed" style="display:none;">@Model.TermsContent.ContentEn</textarea>
              <textarea id="termsContentBgSeed" style="display:none;">@Model.TermsContent.ContentBg</textarea>

              <div class="form-group" style="margin-bottom:26px;">
                <label>English version</label>
                <div id="termsEditorEn" class="quill-editor-container"></div>
              </div>

              <div class="form-group" style="margin-bottom:10px;">
                <label>Bulgarian version (Български)</label>
                <div id="termsEditorBg" class="quill-editor-container"></div>
              </div>

              <div class="privacy-actions-row">
                <button type="button" class="btn-save" id="saveTermsOfUseBtn">Save Terms of Use</button>
              </div>
            </div>
          </div>
        </div>

        <div id="tab-cookies" class="admin-section">
          <div class="admin-panel-card">
            <h3><span>Cookie Categories</span></h3>
            <div class="card-body">
              <p class="settings-hint">
                These are the categories shown in the cookie preferences panel on the public site. "Strictly Necessary" is legally required and can't be made switchable by visitors.
              </p>
              @Html.AntiForgeryToken()

              <div id="cookieCategoryList" class="cookie-category-list">
                @foreach (var cat in Model.CookieCategories)
                {
                    <div class="cookie-category-row"
                         data-id="@cat.Id" data-key="@cat.Key"
                         data-name-en="@cat.NameEn" data-name-bg="@cat.NameBg"
                         data-desc-en="@cat.DescriptionEn" data-desc-bg="@cat.DescriptionBg"
                         data-visible="@cat.IsVisible.ToString().ToLowerInvariant()"
                         data-toggleable="@cat.IsToggleable.ToString().ToLowerInvariant()">
                        <span class="cookie-category-key">@cat.Key</span>
                        <div class="cookie-category-row-names">
                            <strong>@cat.NameEn</strong>
                            <span class="cookie-category-row-sub">@cat.NameBg</span>
                        </div>
                        <div class="cookie-category-row-status">
                            <span class="cookie-status-icon @(cat.IsVisible ? "is-on" : "is-off")" title="@(cat.IsVisible ? "Visible on site" : "Hidden from site")">
                                @if (cat.IsVisible)
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                                }
                            </span>
                            <span class="cookie-status-icon @(cat.IsToggleable ? "is-on" : "is-off")" title="@(cat.IsToggleable ? "Visitor can switch it" : "Always on — locked, required by law")">
                                @if (cat.IsToggleable)
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="5" width="22" height="14" rx="7" ry="7"></rect><circle cx="16" cy="12" r="3" fill="currentColor" stroke="none"></circle></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                }
                            </span>
                        </div>
                        <div class="cookie-category-row-actions">
                            <button type="button" class="action-btn btn-edit cookie-edit-btn">Edit</button>
                            @if (!cat.IsBuiltIn)
                            {
                                <button type="button" class="action-btn btn-delete cookie-delete-btn" data-id="@cat.Id">Delete</button>
                            }
                        </div>
                    </div>
                }
              </div>

              <button type="button" class="action-btn btn-add" id="addCookieCategoryBtn">
                <svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Add New Category
              </button>
            </div>
          </div>

          <div class="admin-panel-card">
            <h3><span>Banner Text</span></h3>
            <div class="card-body">
              <p class="settings-hint">
                The intro text shown on the cookie banner itself (title + description, English and Bulgarian).
                Last updated: <span id="cookieNoticeLastUpdatedText">@ConferenceApp.Helpers.TimeZoneHelper.ToLocal(Model.CookieNotice.LastUpdatedAt).ToString("dd MMM yyyy, HH:mm")</span>.
              </p>

              <textarea id="cookieNoticeContentEnSeed" style="display:none;">@Model.CookieNotice.ContentEn</textarea>
              <textarea id="cookieNoticeContentBgSeed" style="display:none;">@Model.CookieNotice.ContentBg</textarea>

              <div class="form-group" style="margin-bottom:26px;">
                <label>English version</label>
                <div id="cookieNoticeEditorEn" class="quill-editor-container"></div>
              </div>

              <div class="form-group" style="margin-bottom:10px;">
                <label>Bulgarian version (Български)</label>
                <div id="cookieNoticeEditorBg" class="quill-editor-container"></div>
              </div>

              <div class="privacy-actions-row">
                <button type="button" class="btn-save" id="saveCookieNoticeBtn">Save Banner Text</button>
              </div>
            </div>
          </div>

          <div class="admin-panel-card">
            <h3><span>Cookie Policy Page</span></h3>
            <div class="card-body">
              <p class="settings-hint">
                The full content shown on the public <code>/Cookies</code> page (above the category list) — what cookies are, third parties, browser controls, and contact info. English and Bulgarian.
                Last updated: <span id="cookiePolicyLastUpdatedText">@ConferenceApp.Helpers.TimeZoneHelper.ToLocal(Model.CookiePolicy.LastUpdatedAt).ToString("dd MMM yyyy, HH:mm")</span>.
              </p>

              <textarea id="cookiePolicyContentEnSeed" style="display:none;">@Model.CookiePolicy.ContentEn</textarea>
              <textarea id="cookiePolicyContentBgSeed" style="display:none;">@Model.CookiePolicy.ContentBg</textarea>

              <div class="form-group" style="margin-bottom:26px;">
                <label>English version</label>
                <div id="cookiePolicyEditorEn" class="quill-editor-container"></div>
              </div>

              <div class="form-group" style="margin-bottom:10px;">
                <label>Bulgarian version (Български)</label>
                <div id="cookiePolicyEditorBg" class="quill-editor-container"></div>
              </div>

              <div class="privacy-actions-row">
                <button type="button" class="btn-save" id="saveCookiePolicyBtn">Save Cookie Policy Page</button>
              </div>
            </div>
          </div>
        </div>

        <div id="tab-emails" class="admin-section">
          <div class="admin-panel-card">
            <h3><span>Email Notifications</span></h3>
            <div class="card-body">
              <p class="settings-hint">
                Turn individual notification emails on or off. Changes take effect immediately —
                no restart needed. Everything is enabled by default.
              </p>
              <p class="settings-hint" style="margin-top:-6px;">
                <strong>Login and registration codes are not listed here.</strong>
                Without them nobody can sign in or register, so they cannot be switched off.
              </p>

              @Html.AntiForgeryToken()

              <div class="email-toggle-list">
                @{
                    var emailRows = new (string Key, string Title, string Desc)[]
                    {
                        ("PaymentConfirmed",     "Payment confirmed",
                         "Sent when a payment goes through — card, crypto or a confirmed bank transfer."),
                        ("PaymentPending",       "Bank transfer received",
                         "Sent when a participant reports they have made an IBAN transfer."),
                        ("VerificationApproved", "Documents approved",
                         "Sent when you approve a student or journalist verification."),
                        ("VerificationRejected", "Documents rejected",
                         "Sent when you reject a verification. Includes the reason you wrote."),
                        ("StatusChanged",        "Status changed manually",
                         "Sent when you change someone's payment status, verification status or participation form from the Registrations tab.")
                    };
                }

                @foreach (var row in emailRows)
                {
                    var isOn = !Model.EmailToggles.TryGetValue(row.Key, out var v) || v;
                    <div class="email-toggle-row" data-key="@row.Key">
                      <div class="email-toggle-text">
                        <span class="email-toggle-title">@row.Title</span>
                        <span class="email-toggle-desc">@row.Desc</span>
                      </div>
                      <label class="email-switch" title="@(isOn ? "Enabled" : "Disabled")">
                        <input type="checkbox" class="email-toggle-input"
                               data-key="@row.Key" @(isOn ? "checked" : "")>
                        <span class="email-switch-track"><span class="email-switch-thumb"></span></span>
                      </label>
                    </div>
                }
              </div>
            </div>
          </div>
        </div>

        <div id="tab-paycontrol" class="admin-section">
          <div class="admin-panel-card">
            <h3><span>Payment Control</span></h3>
            <div class="card-body">
              <p class="settings-hint">
                Stop payments without touching code or configuration. Changes take effect
                immediately — a participant who reloads the payment page sees the new state.
                Nothing already paid or reported is affected.
              </p>

              @Html.AntiForgeryToken()

              <div class="pay-gate" id="payment-gates">

                @{
                    bool Gate(string key) => !Model.PaymentGates.TryGetValue(key, out var g) || g;
                }

                <div class="pay-gate-master">
                  <div class="pay-gate-master-text">
                    <span class="pay-gate-master-title">All payments</span>
                    <span class="pay-gate-state" id="pay-gate-state">Payments are open</span>
                  </div>
                  <label class="email-switch" title="All payments">
                    <input type="checkbox" class="pay-gate-input"
                           data-gate-key="all" data-gate-level="all"
                           @(Gate("all") ? "checked" : "")>
                    <span class="email-switch-track"><span class="email-switch-thumb"></span></span>
                  </label>
                </div>

                <div class="pay-gate-group" data-gate-group="method">
                  <div class="pay-gate-group-head">
                    <span class="pay-gate-group-label">Methods</span>
                    <span class="pay-gate-group-note">All payments are stopped</span>
                  </div>
                  <div class="pay-gate-list">

                    <div class="pay-gate-row">
                      <div class="pay-gate-row-main">
                        <span class="pay-gate-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><rect x="2" y="5" width="20" height="14"></rect><path d="M2 10h20"></path><path d="M6 15h4"></path></svg>
                        </span>
                        <div class="pay-gate-text">
                          <span class="pay-gate-title">Card</span>
                          <span class="pay-gate-desc">Stripe Checkout — card, Apple Pay, Google Pay.</span>
                        </div>
                      </div>
                      <label class="email-switch" title="Card">
                        <input type="checkbox" class="pay-gate-input"
                               data-gate-key="method.card" data-gate-level="method"
                               @(Gate("method.card") ? "checked" : "")>
                        <span class="email-switch-track"><span class="email-switch-thumb"></span></span>
                      </label>
                    </div>

                    <div class="pay-gate-row">
                      <div class="pay-gate-row-main">
                        <span class="pay-gate-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><circle cx="12" cy="12" r="9"></circle><path d="M9 8h4.5a2 2 0 0 1 0 4H9m0 0h5a2 2 0 0 1 0 4H9M9 8v8m3-10v2m0 8v2"></path></svg>
                        </span>
                        <div class="pay-gate-text">
                          <span class="pay-gate-title">Cryptocurrency</span>
                          <span class="pay-gate-desc">Go28 payment gateway. Turning this off also stops all four currencies below.</span>
                        </div>
                      </div>
                      <label class="email-switch" title="Cryptocurrency">
                        <input type="checkbox" class="pay-gate-input"
                               data-gate-key="method.crypto" data-gate-level="method"
                               @(Gate("method.crypto") ? "checked" : "")>
                        <span class="email-switch-track"><span class="email-switch-thumb"></span></span>
                      </label>
                    </div>

                    <div class="pay-gate-row">
                      <div class="pay-gate-row-main">
                        <span class="pay-gate-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M3 10h18"></path><path d="M5 10v9h14v-9"></path><path d="M3 10 12 4l9 6"></path><path d="M9 19v-5h6v5"></path></svg>
                        </span>
                        <div class="pay-gate-text">
                          <span class="pay-gate-title">Bank transfer</span>
                          <span class="pay-gate-desc">IBAN details and the “I have transferred” form. Turn off while the account is changing.</span>
                        </div>
                      </div>
                      <label class="email-switch" title="Bank transfer">
                        <input type="checkbox" class="pay-gate-input"
                               data-gate-key="method.iban" data-gate-level="method"
                               @(Gate("method.iban") ? "checked" : "")>
                        <span class="email-switch-track"><span class="email-switch-thumb"></span></span>
                      </label>
                    </div>

                  </div>

                  <div class="pay-gate-group pay-gate-group--nested" data-gate-group="currency">
                    <div class="pay-gate-group-head">
                      <span class="pay-gate-group-label">Cryptocurrencies</span>
                      <span class="pay-gate-group-note">Cryptocurrency is off</span>
                    </div>
                    <div class="pay-gate-list">

                      <div class="pay-gate-row">
                        <div class="pay-gate-row-main">
                          <span class="pay-gate-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><circle cx="12" cy="12" r="9"></circle><path d="M9 8h4.5a2 2 0 0 1 0 4H9m0 0h5a2 2 0 0 1 0 4H9M9 8v8m3-10v2m0 8v2"></path></svg>
                          </span>
                          <div class="pay-gate-text">
                            <span class="pay-gate-title">BTC<span class="pay-gate-net">BTC</span></span>
                            <span class="pay-gate-desc">Bitcoin</span>
                          </div>
                        </div>
                        <label class="email-switch" title="Bitcoin">
