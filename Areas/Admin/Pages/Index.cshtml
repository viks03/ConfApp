                          <td style="font-size:12px;color:var(--c-text-muted);">@logIp</td>
                          <td style="font-size:11px;color:var(--c-text-secondary);max-width:300px;word-break:break-word;">@log.Details</td>
                        </tr>
                    }
                }
              </tbody>
            </table>
            </div>
          </div>
