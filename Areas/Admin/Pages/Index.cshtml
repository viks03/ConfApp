      <div class="modal-header"><h3 id="editRegModalTitle">Edit Attendee</h3></div>
      <div class="modal-body">
        @Html.AntiForgeryToken()
        <input type="hidden" id="regUserId">
        <div class="form-row">
          <div class="form-group">
            <label>First Name <span class="required-star">*</span></label>
            <input type="text" id="regFirstName" placeholder="First name">
          </div>
          <div class="form-group">
            <label>Last Name <span class="required-star">*</span></label>
            <input type="text" id="regLastName" placeholder="Last name">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Age <span class="required-star">*</span></label>
            <input type="number" id="regAge" min="16" max="100" placeholder="Age">
          </div>
          <div class="form-group">
            <label>Phone <span class="required-star">*</span></label>
            <input type="text" id="regPhone" placeholder="Phone number">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Academic Title</label>
            <input type="text" id="regTitle" placeholder="e.g. Prof., Dr.">
          </div>
          <div class="form-group">
            <label>Organization <span class="required-star">*</span></label>
            <input type="text" id="regOrg" placeholder="Workplace / University">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Participation Type</label>
            <select id="regParticipation">
              <option value="1">Lector / Academic</option>
              <option value="2">Student / PhD Candidate</option>
              <option value="3">Online Participant</option>
              <option value="4">Journalist / Media</option>
            </select>
          </div>
          <div class="form-group" style="display:flex;flex-direction:column;justify-content:center;">
            <label>&nbsp;</label>
            <div class="checkbox-group">
              <input type="checkbox" id="regForeignCheck">
              <label for="regForeignCheck">Is Foreigner?</label>
            </div>
          </div>
        </div>
        <div class="form-group">
          <label>Submitted Paper</label>
          <div style="margin-top:8px;">
            <a href="#" id="regDownloadLink" class="file-download-box" style="display:none;">
              <span><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline></svg></span> <strong id="regFileName">file.pdf</strong> (Click to Download)
            </a>
            <span id="regNoFile" style="display:none;color:var(--c-text-muted);font-style:italic;">No file uploaded</span>
          </div>
        </div>
        <hr style="border-color:var(--c-border);margin:20px 0;">
        <div class="form-group">
          <label style="color:var(--c-accent-ink);">Update Payment Status</label>
