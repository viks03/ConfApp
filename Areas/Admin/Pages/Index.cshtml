      <div class="modal-body">
        <p style="color:var(--c-text-secondary);margin-bottom:20px;">You are about to permanently delete <strong id="delete-item-name" style="color:var(--c-accent-ink);">this record</strong>. This action cannot be undone.</p>
      </div>
      <div class="modal-actions" style="justify-content:center;">
        <button type="button" class="btn-cancel modal-close-btn">Cancel</button>
