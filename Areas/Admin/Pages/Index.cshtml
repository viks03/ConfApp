        <div class="modal-validation-banner" id="promo-validation-banner"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg> Please fill in all required fields.</div>
        @Html.AntiForgeryToken()
        <input type="hidden" id="promoId" value="0">
        <div class="form-group">
          <label>Title (EN) <span class="required-star">*</span></label>
          <input type="text" id="promoTitle_en" maxlength="50" placeholder="e.g. Blockchain Education 2026">
          <span class="char-counter" id="promoTitle_en_counter">0 / 50</span>
        </div>
        <div class="form-group">
          <label>Title (BG) <span class="required-star">*</span></label>
          <input type="text" id="promoTitle_bg" maxlength="50" placeholder="напр. Blockchain Education 2026">
          <span class="char-counter" id="promoTitle_bg_counter">0 / 50</span>
        </div>
        <div class="form-group">
          <label>Description (EN) <span class="required-star">*</span></label>
          <textarea id="promoDesc_en" maxlength="120" placeholder="Short description..."></textarea>
          <span class="char-counter" id="promoDesc_en_counter">0 / 120</span>
        </div>
        <div class="form-group">
          <label>Description (BG) <span class="required-star">*</span></label>
          <textarea id="promoDesc_bg" maxlength="120" placeholder="Кратко описание..."></textarea>
          <span class="char-counter" id="promoDesc_bg_counter">0 / 120</span>
        </div>
        <div class="form-group">
          <label>Slide Image <span id="promoImageRequired" class="required-star">*</span></label>
          <p class="settings-hint" style="margin-top:0;">
            Recommended: square image (e.g. 300×300px), <strong>transparent PNG background</strong>, max 1MB. Accepted formats: PNG, JPG, JPEG.
            The image sits inside a small fixed box on the site — it will not be cropped, just scaled to fit, so keep the subject centered.
          </p>
          <input type="file" id="promoImage" accept="image/png,image/jpeg">
          <div class="image-upload-preview" id="promoImagePreview">
            <img id="promoImagePreviewImg" src="" alt="Preview">
            <span id="promoImagePreviewName"></span>
          </div>
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel modal-close-btn">Cancel</button>
        <button type="button" class="btn-save" id="savePromoBtn">Save Promo Slide</button>
      </div>
    </div>
  </div>

  <!-- ── ADD / EDIT FOOTER QUICK LINK MODAL ─────────────────────── -->
  <div class="modal-overlay" id="edit-footer-link-modal">
    <div class="modal-box">
      <div class="modal-header"><h3 id="editFooterLinkModalTitle">Add / Edit Quick Link</h3></div>
      <div class="modal-body">
        <div class="modal-validation-banner" id="footerlink-validation-banner"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg> Please fill in all required fields.</div>
        @Html.AntiForgeryToken()
        <input type="hidden" id="footerLinkId" value="0">

        <div class="form-row">
          <div class="form-group"><label>Label (EN) <span class="required-star">*</span></label><input type="text" id="footerLinkLabel_en" placeholder="e.g. Conference" maxlength="60"><span class="char-counter" id="footerLinkLabel_en_counter">0 / 60</span></div>
          <div class="form-group"><label>Label (BG) <span class="required-star">*</span></label><input type="text" id="footerLinkLabel_bg" placeholder="напр. Конференция" maxlength="60"><span class="char-counter" id="footerLinkLabel_bg_counter">0 / 60</span></div>
        </div>

        <div class="form-group">
          <label>URL / Path <span class="required-star">*</span></label>
          <input type="text" id="footerLinkUrl" placeholder="/Conference or https://..." maxlength="300">
          <span class="char-counter" id="footerLinkUrl_counter">0 / 300</span>
        </div>

        <div class="form-group">
          <label>SVG Icon Code <span class="required-star">*</span></label>
          <p class="settings-hint" style="margin-top:0;">
            Paste just the inner SVG markup — the shapes only (e.g. <code>&lt;circle .../&gt;&lt;path .../&gt;</code>), not a full <code>&lt;svg&gt;</code> tag. It's wrapped automatically in the site's standard 24×24, stroke-based icon frame, so every quick link is guaranteed to show its own icon instead of a generic fallback.
          </p>
          <textarea id="footerLinkIconSvg" style="min-height:90px;font-family:var(--font-mono);font-size:12px;" maxlength="2000" placeholder="&lt;circle cx='9' cy='8' r='3'&gt;&lt;/circle&gt;&#10;&lt;path d='M2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v1'&gt;&lt;/path&gt;"></textarea>
          <span class="char-counter" id="footerLinkIconSvg_counter">0 / 2000</span>
        </div>

        <div class="form-group" style="display:flex;align-items:center;gap:12px;margin-bottom:0;">
          <span style="font-size:12px;color:var(--c-text-muted);font-weight:600;">Preview</span>
          <span class="footer-link-icon-preview" id="footerLinkIconPreview" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle></svg>
          </span>
          <span style="font-size:11.5px;color:var(--c-text-muted);">Updates once icon-code editing is wired up.</span>
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel modal-close-btn">Cancel</button>
        <button type="button" class="btn-save" id="saveFooterLinkBtn">Save Quick Link</button>
      </div>
    </div>
  </div>

  <!-- ── EDIT FAQ MODAL ─────────────────────────────────────────── -->
  <div class="modal-overlay" id="edit-faq-modal">
    <div class="modal-box" style="max-width:700px;">
      <div class="modal-header"><h3 id="editFaqModalTitle">Add / Edit FAQ</h3></div>
      <div class="modal-body">
        <div class="modal-validation-banner" id="faq-validation-banner"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg> Please fill in all required fields.</div>
        @Html.AntiForgeryToken()
        <input type="hidden" id="faqId" value="0">
        
        <div class="form-group">
          <label>Question (EN) <span class="required-star">*</span></label>
